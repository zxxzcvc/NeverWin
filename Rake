-- Dumps go to a file where the executor allows it and to the clipboard where
-- it does not, so there is always some way to get the thing off the machine.
local function saveDump(name, text)
	local path = "Rake/dumps/" .. name
	if canWrite() then
		ensureFolder("Rake")
		ensureFolder("Rake/dumps")
		if pcall(writefile, path, text) then
			clipboard(text)
			notify("wrote " .. path, 6)
			return true, "wrote " .. path
		end
	end
	if clipboard(text) then
		notify("no writefile - " .. name .. " copied to the clipboard", 7)
		return true, "copied to the clipboard"
	end
	notify("no writefile and no setclipboard on this executor", 7)
	return false, "nowhere to put it"
end


-- ================================ stamina ================================
-- The working method, taken straight from the Rayfield build: the client
-- keeps its stamina in a plain Lua table and getgc(true) reaches it.
-- STAMINA_TAKE is what drains it, so zeroing that is the actual fix - the
-- previous build held WalkSpeed, which only ever treated the symptom.
--
-- The table is re-found periodically rather than cached once, because a
-- respawn or a script reload can replace it.

local Stam = {
	on = false, nvg = false, status = "off",
	tbl = nil, nvgTbl = nil, last = 0, found = false,
	-- "Default" zeroes the drain, which is the proven method. "Vitamins
	-- Spoof" leaves the drain alone and pins the regen instead.
	mode = "Default", stockTake = nil, stockJump = nil,
}

-- The Vitamins Tool, wherever you are keeping it.
function Stam.vitaminTool()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local tool = (bp and bp:FindFirstChild("Vitamins"))
		or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Vitamins"))
	return tool
end

-- Whatever the drain was before we touched it, so switching modes puts the
-- game's own number back rather than a number of ours.
function Stam.keepStock(t)
	pcall(function()
		if Stam.stockTake == nil and type(rawget(t, "STAMINA_TAKE")) == "number" then
			Stam.stockTake = t.STAMINA_TAKE
		end
		if Stam.stockJump == nil and type(rawget(t, "JUMP_STAMINA")) == "number" then
			Stam.stockJump = t.JUMP_STAMINA
		end
	end)
end

function Stam.restoreStock()
	local t = Stam.tbl
	if not t then return end
	pcall(function()
		if Stam.stockTake ~= nil and rawget(t, "STAMINA_TAKE") ~= nil then
			t.STAMINA_TAKE = Stam.stockTake
		end
		if Stam.stockJump ~= nil and rawget(t, "JUMP_STAMINA") ~= nil then
			t.JUMP_STAMINA = Stam.stockJump
		end
	end)
	Stam.stockTake, Stam.stockJump = nil, nil
end

-- OnUnload sets Stam.on = false directly rather than calling Stam.set, so
-- without this the stock drain would never come back.
addCleanup("stamina", function()
	Stam.restoreStock()
	local tool = Stam.vitaminTool()
	local active = tool and tool:FindFirstChild("Active")
	if active then pcall(function() active.Value = false end) end
end)

function Stam.setMode(mode)
	Stam.mode = mode
	-- coming back from a spoof, the drain we left alone stays alone; coming
	-- back from Default, the game's own number goes back in
	Stam.restoreStock()
	if Stam.on then Stam.apply() end
end

function Stam.find(marker)
	if typeof(getgc) ~= "function" then return nil end
	local ok, all = pcall(getgc, true)
	if not ok then return nil end
	for _, v in pairs(all) do
		if type(v) == "table" then
			local got, has = pcall(function() return rawget(v, marker) ~= nil end)
			if got and has then return v end
		end
	end
	return nil
end

function Stam.apply()
	local t = Stam.tbl
	if not (t and pcall(function() return rawget(t, "stamina") end)) then
		t = Stam.find("STAMINA_REGEN") or Stam.find("stamina")
		Stam.tbl = t
	end
	if not t then
		Stam.found = false
		Stam.status = typeof(getgc) == "function"
			and "cannot find the stamina table yet - move around once"
			or "this executor has no getgc, so infinite stamina cannot work"
		return false
	end
	Stam.found = true
	Stam.keepStock(t)

	if Stam.mode == "Vitamins Spoof" then
		-- The drain stays exactly as the game set it, so the bar moves like
		-- everyone else's. What is ours is the recovery: regen pinned high
		-- and the drain per action cut to a fraction rather than to zero.
		-- That is a vitamin that never wears off, and unlike zeroing the
		-- drain it leaves a bar that visibly dips and comes back.
		local live = 0
		pcall(function()
			if rawget(t, "STAMINA_REGEN") ~= nil then t.STAMINA_REGEN = 100 end
			if rawget(t, "JUMP_COOLDOWN") ~= nil then t.JUMP_COOLDOWN = 0 end
			if Stam.stockTake and rawget(t, "STAMINA_TAKE") ~= nil then
				t.STAMINA_TAKE = Stam.stockTake * 0.15
			end
			if Stam.stockJump and rawget(t, "JUMP_STAMINA") ~= nil then
				t.JUMP_STAMINA = Stam.stockJump * 0.15
			end
			-- never let it actually bottom out, which is the one thing a
			-- five second boost also guarantees
			if type(rawget(t, "stamina")) == "number" then
				live = t.stamina
				if live < 25 then t.stamina = 25 end
			end
		end)
		local tool = Stam.vitaminTool()
		local active = tool and tool:FindFirstChild("Active")
		if active then pcall(function() active.Value = true end) end
		Stam.status = string.format("vitamins spoof - stamina %d, regen pinned, drain at 15%%%s",
			math.floor(live), active and ", Active held" or "")
		return true
	end

	pcall(function()
		if rawget(t, "STAMINA_REGEN") ~= nil then t.STAMINA_REGEN = 100 end
		if rawget(t, "STAMINA_TAKE") ~= nil then t.STAMINA_TAKE = 0 end
		if rawget(t, "JUMP_STAMINA") ~= nil then t.JUMP_STAMINA = 0 end
		if rawget(t, "JUMP_COOLDOWN") ~= nil then t.JUMP_COOLDOWN = 0 end
		if rawget(t, "stamina") ~= nil then t.stamina = 100 end
	end)
	Stam.status = "holding stamina - STAMINA_TAKE is zero"
	return true
end

function Stam.applyNvg()
	local t = Stam.nvgTbl
	if not t then
		t = Stam.find("NVG_TAKE")
		Stam.nvgTbl = t
	end
	if not t then return false end
	pcall(function()
		t.NVG_TAKE = 0
		t.NVG_REGEN = 100
	end)
	return true
end

function Stam.enforce()
	if Stam.conn then return end
	Stam.conn = RunService.Heartbeat:Connect(function()
		if not Stam.on and not Stam.nvg then return end
		-- Between sweeps just top the known table back up, which costs
		-- nothing. Re-walking the whole gc every frame would not.
		if os.clock() - Stam.last < 0.5 then
			local t = Stam.tbl
			-- Default pins the bar itself. Vitamins Spoof deliberately does
			-- not: it left the drain at stock so it would look like the item,
			-- and pinning here would have made the two methods identical -
			-- which is exactly what was wrong with it.
			if Stam.on and t and Stam.mode ~= "Vitamins Spoof" then
				pcall(function()
					if rawget(t, "stamina") ~= nil then t.stamina = 100 end
				end)
			end
			return
		end
		Stam.last = os.clock()
		if Stam.on then Stam.apply() end
		if Stam.nvg then Stam.applyNvg() end
	end)
	addCleanup("stamloop", function()
		if Stam.conn then Stam.conn:Disconnect() Stam.conn = nil end
	end)
end

function Stam.set(on)
	Stam.on = on
	if on then
		Stam.enforce()
		if not Stam.apply() then notify(Stam.status, 6) end
	else
		Stam.restoreStock()
		local tool = Stam.vitaminTool()
		local active = tool and tool:FindFirstChild("Active")
		if active then pcall(function() active.Value = false end) end
		Stam.status = "off"
	end
end

function Stam.setNvg(on)
	Stam.nvg = on
	if on then
		Stam.enforce()
		if not Stam.applyNvg() then notify("could not find the night vision table", 5) end
	end
end

