local scalePending, scaleRunning = nil, false
local function applyScale(v)
	scalePending = v
	if scaleRunning then return end
	scaleRunning = true
	task.spawn(function()
		while scalePending do
			local target = scalePending
			scalePending = nil
			pcall(function() Library:SetDPIScale(target) end)
			task.wait(0.06)
		end
		scaleRunning = false
	end)
end

