local Move = {
	speedOn = false, walkSpeed = 16, baseWalk = 16,
	fovOn = false, fov = 70, baseFov = 70,
	noFall = false,
	boundHum = nil, animOn = false, animSaved = nil, animLast = 0,
}

-- ------------------------------ walk speed ------------------------------
-- Reverted to the desire.cc build, which is four lines and works:
--
--     RunService.RenderStepped:Connect(function()
--         if _G.enableSpeed == true and getHum() then
--             getHum().WalkSpeed = tonumber(_G.WalkSpeedd)
--         end
--     end)
--
-- with the slider at 0 to 30. That range is not timidity, it is the answer:
-- the game stops listening above thirty, and a slider that goes to sixty is a
-- slider that lies to you for half its travel.
--
-- What came out, and why. I had built three layers on top of that write - a
-- getgc patch on the sprint constants, a PivotTo displacement for whatever
-- WalkSpeed refused, and a detector that watched for foreign writes to work
-- out whether the ceiling was client or server. The detector is what made it
-- "still bugged": every foreign write ratcheted Move.ask DOWN toward the
-- game's own number and never let it back up, so the speed decayed to walking
-- pace and stayed there. Three layers of cleverness losing to four lines.

-- desire.cc's version, which is a RenderStepped write and nothing else. The
-- FOV half rides along on the same loop because it always has.
--
-- The property-changed guard stays: it is the one addition that is not
-- cleverness, it just puts the value back the instant something else writes
-- it. What is gone is everything that tried to REASON about the other writer.
function Move.enforce()
	if Move.loop then return end
	local function fix()
		local hum = getHum()
		if Move.speedOn and hum and hum.WalkSpeed ~= Move.walkSpeed then
			hum.WalkSpeed = Move.walkSpeed
		end
		local c = cam()
		if Move.fovOn and c and math.abs(c.FieldOfView - Move.fov) > 0.01 then
			c.FieldOfView = Move.fov
		end
	end
	Move.fix = fix
	Move.loop = RunService.RenderStepped:Connect(function()
		fix()
		-- the run clip instead of a sped-up walk, which is a separate thing
		-- from how fast you go and stays
		if os.clock() - (Move.animLast or 0) >= 0.25 then
			Move.animLast = os.clock()
			local hum = getHum()
			local fast = (Move.speedOn and hum and hum.WalkSpeed > Move.baseWalk + 2) or false
			if fast ~= Move.animOn then
				Move.animOn = fast
				Move.setRunAnim(fast)
			end
		end
		if Move.animOn then Move.holdAnimSpeed() end
	end)
	Move.rebind()
	addCleanup("moveloop", function()
		if Move.loop then Move.loop:Disconnect() Move.loop = nil end
		if Move.humConn then Move.humConn:Disconnect() Move.humConn = nil end
		if Move.camConn then Move.camConn:Disconnect() Move.camConn = nil end
		Move.boundHum, Move.animOn = nil, false
		Move.setRunAnim(false)
		local hum, c = getHum(), cam()
		if hum then pcall(function() hum.WalkSpeed = Move.baseWalk end) end
		if c then pcall(function() c.FieldOfView = Move.baseFov end) end
	end)
end

function Move.rebind()
	if not Move.fix then return end
	if Move.humConn then Move.humConn:Disconnect() Move.humConn = nil end
	if Move.camConn then Move.camConn:Disconnect() Move.camConn = nil end
	local hum, c = getHum(), cam()
	if hum ~= Move.boundHum then
		-- new character, new Animate: the saved ids belonged to the old one
		Move.animSaved, Move.animOn = nil, false
		Move.boundHum = hum
	end
	if hum then Move.humConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(Move.fix) end
	if c then Move.camConn = c:GetPropertyChangedSignal("FieldOfView"):Connect(Move.fix) end
end

function Move.setAntiRagdoll(on)
	Move.antiRagdoll = on
	if not on then
		if Move.ragConn then Move.ragConn:Disconnect() Move.ragConn = nil end
		Move.ragStatus = "off"
		-- the loop switched three states off every frame; switching the
		-- loop off does not switch them back
		local hum = getHum()
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
			end)
		end
		return
	end
	if Move.ragConn then return end
	Move.ragCaught = 0
	Move.ragConn = RunService.Stepped:Connect(function()
		if not Move.antiRagdoll then return end
		local char = LocalPlayer.Character
		local hum = getHum()
		if not char or not hum then return end
		local caught = false

		-- PlatformStand is what actually puts you on the floor
		if hum.PlatformStand then
			hum.PlatformStand = false
			caught = true
		end
		if hum.Sit then
			hum.Sit = false
			caught = true
		end
		if not hum.AutoRotate then hum.AutoRotate = true end

		-- a ragdoll usually detaches the limbs by switching the joints off
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") and not d.Enabled then
				d.Enabled = true
				caught = true
			end
		end

		local timer = char:FindFirstChild("RagdollTime")
		if timer then
			local ok, value = pcall(function() return timer.Value end)
			if ok and type(value) == "number" and value > 0 then
				pcall(function() timer.Value = 0 end)
				caught = true
			end
			local switch = timer:FindFirstChild("RagdollSwitch")
			if switch and switch.Value == true then
				pcall(function() switch.Value = false end)
				caught = true
			end
		end

		local state = hum:GetState()
		if state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.FallingDown
			or state == Enum.HumanoidStateType.PlatformStanding then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			caught = true
		end
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
		end)

		if caught then Move.ragCaught = Move.ragCaught + 1 end
		Move.ragStatus = Move.ragCaught > 0
			and ("caught " .. Move.ragCaught)
			or "watching"
	end)
	addCleanup("antiragdoll", function()
		if Move.ragConn then Move.ragConn:Disconnect() Move.ragConn = nil end
		local hum = getHum()
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
			end)
		end
	end)
end

Move.flySpeed = 70
Move.blinkDist = 26
Move.jumpPower = 50
Move.baseGravity = Workspace.Gravity

function Move.setFly(on)
	Move.fly = on
	if not on then
		if Move.flyConn then Move.flyConn:Disconnect() Move.flyConn = nil end
		if Move.flyForce then pcall(function() Move.flyForce:Destroy() end) Move.flyForce = nil end
		if Move.flyGyro then pcall(function() Move.flyGyro:Destroy() end) Move.flyGyro = nil end
		return
	end
	-- arming twice would orphan the last force, gyro and connection
	if Move.flyConn or Move.flyForce then Move.setFly(false) end
	local hrp = getHRP()
	if not hrp then
		notify("no character to fly", 4)
		Move.fly = false
		-- and say so to the toggle, or it sits there claiming to be on
		pcall(function()
			if Toggles.RK_Fly then Toggles.RK_Fly:SetValue(false) end
		end)
		return
	end
	Move.flyForce = make("BodyVelocity", {
		Name = "RKFly", MaxForce = Vector3.new(1e5, 1e5, 1e5),
		Velocity = Vector3.zero, P = 1500,
	}, hrp)
	Move.flyGyro = make("BodyGyro", {
		Name = "RKFlyGyro", MaxTorque = Vector3.new(4e5, 4e5, 4e5),
		P = 3000, CFrame = hrp.CFrame,
	}, hrp)
	Move.flyConn = RunService.RenderStepped:Connect(function()
		local root, c = getHRP(), cam()
		if not root or not c or not Move.flyForce then return end
		-- a respawn destroys the old character and the force with it; the
		-- reference survives and every write to it throws, so rebuild
		if not Move.flyForce.Parent and Move.flyForce ~= nil then
			local stillOn = Move.fly
			Move.setFly(false)
			if stillOn then Move.setFly(true) end
			return
		end
		-- freecam owns the camera; two things reading it to steer by is a
		-- fight neither wins
		if Free and Free.on then
			Move.flyForce.Velocity = Vector3.zero
			return
		end
		if Move.flyForce.Parent ~= root then
			Move.flyForce.Parent = root
			if Move.flyGyro then Move.flyGyro.Parent = root end
		end
		local dir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += c.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= c.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += c.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= c.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
		if dir.Magnitude == 0 then
			local hum = getHum()
			if hum and hum.MoveDirection.Magnitude > 0 then dir = hum.MoveDirection end
		end
		if Move.flyGyro then Move.flyGyro.CFrame = c.CFrame end
		Move.flyForce.Velocity = (dir.Magnitude > 0 and dir.Unit or Vector3.zero) * Move.flySpeed
	end)
	addCleanup("fly", function() Move.setFly(false) end)
end

function Move.setInfJump(on)
	Move.infJump = on
	if on and not Move.jumpConn then
		Move.jumpConn = UserInputService.JumpRequest:Connect(function()
			local hum = getHum()
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end)
		addCleanup("infjump", function() Move.setInfJump(false) end)
	elseif not on and Move.jumpConn then
		Move.jumpConn:Disconnect()
		Move.jumpConn = nil
	end
end

-- One short hop forward. The quietest way there is to break a chase: a
-- single displacement rather than a speed the game can watch.
function Move.blink()
	local hrp, c = getHRP(), cam()
	if not hrp or not c then return end
	local flat = Vector3.new(c.CFrame.LookVector.X, 0, c.CFrame.LookVector.Z)
	if flat.Magnitude < 0.01 then return end
	local char = LocalPlayer.Character
	if char then
		pcall(function() char:PivotTo(hrp.CFrame + flat.Unit * Move.blinkDist) end)
	end
end

function Move.setJumpPower(v)
	Move.jumpPower = v
	local hum = getHum()
	if not hum then return end
	-- remember what the game had, and whether it was even using JumpPower:
	-- forcing UseJumpPower on in a JumpHeight game changes how it jumps
	if Move.baseJump == nil then
		Move.baseJump = hum.JumpPower
		Move.baseUseJump = hum.UseJumpPower
	end
	pcall(function()
		hum.UseJumpPower = true
		hum.JumpPower = v
	end)
end

addCleanup("jumppower", function()
	local hum = getHum()
	if hum and Move.baseJump then
		pcall(function()
			hum.JumpPower = Move.baseJump
			hum.UseJumpPower = Move.baseUseJump
		end)
	end
end)

function Move.setGravity(v)
	Move.gravity = v
	pcall(function() Workspace.Gravity = v end)
end
addCleanup("gravity", function()
	pcall(function() Workspace.Gravity = Move.baseGravity end)
end)

-- Being flung is a push on your own root part, and you own that, so
-- clamping it locally genuinely holds.
Move.flingLimit = 200

function Move.setAntiFling(on)
	Move.antiFling = on
	if not on then
		if Move.flingConn then Move.flingConn:Disconnect() Move.flingConn = nil end
		return
	end
	if Move.flingConn then return end
	Move.flingConn = RunService.Stepped:Connect(function()
		if not Move.antiFling then return end
		local hrp = getHRP()
		if not hrp then return end
		local v = hrp.AssemblyLinearVelocity
		if v.Magnitude > Move.flingLimit then
			hrp.AssemblyLinearVelocity = v.Unit * Move.flingLimit
		end
		local a = hrp.AssemblyAngularVelocity
		if a.Magnitude > 30 then hrp.AssemblyAngularVelocity = a.Unit * 30 end
	end)
	addCleanup("antifling", function() Move.setAntiFling(false) end)
end

-- Writes your Humanoid, which on a server that owns health does nothing.
-- It costs nothing either, so it is offered as a bonus rather than a plan.
function Move.setHoldHealth(on)
	Move.holdHealth = on
	if not on then
		if Move.healthConn then Move.healthConn:Disconnect() Move.healthConn = nil end
		return
	end
	if Move.healthConn then return end
	Move.healthConn = RunService.Heartbeat:Connect(function()
		if not Move.holdHealth then return end
		if os.clock() - (Move.healthLast or 0) < 0.2 then return end
		Move.healthLast = os.clock()
		local hum = getHum()
		if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
			pcall(function() hum.Health = hum.MaxHealth end)
		end
	end)
	addCleanup("holdhealth", function() Move.setHoldHealth(false) end)
end

function Move.setNoclip(on)
	Move.noclip = on
	if not on then
		if Move.clipConn then Move.clipConn:Disconnect() Move.clipConn = nil end
		local char = LocalPlayer.Character
		if char then
			for part, was in pairs(Move.clipped or {}) do
				if part and part.Parent then pcall(function() part.CanCollide = was end) end
			end
		end
		Move.clipped = {}
		return
	end
	Move.clipped = Move.clipped or {}
	if Move.clipConn then return end
	Move.clipConn = RunService.Stepped:Connect(function()
		if not Move.noclip then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				if Move.clipped[part] == nil then Move.clipped[part] = true end
				part.CanCollide = false
			end
		end
	end)
	addCleanup("noclip", function() Move.setNoclip(false) end)
end

-- baseWalk: the game does not run you at sixteen. Read it only before we
-- have written anything, and only believe a plausible figure, or a toggle-on
-- during a Teleport (WalkSpeed 0) or after layer 1 landed would learn our
-- own value back as the baseline.
-- The Animate script's config: StringValues named walk1/run1/... each holding
-- one Animation child. Both halves are read off the live character, so a
-- reskin or an update changes nothing here.
function Move.animate()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("Animate")
end

function Move.runAnimId()
	local a = Move.animate()
	if not a then return nil end
	for _, v in ipairs(a:GetChildren()) do
		if v:IsA("StringValue") and v.Name:sub(1, 3) == "run" then
			local anim = v:FindFirstChildWhichIsA("Animation")
			if anim and anim.AnimationId ~= "" then return anim.AnimationId end
		end
	end
	return nil
end

-- Animate caches what it loaded, so changing an id is not enough on its own:
-- the currently playing track has to be stopped for it to load the new one.
function Move.reloadAnims()
	local hum = getHum()
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return end
	pcall(function()
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			local n = track.Name
			if n == "WalkAnim" or n == "RunAnim" or n == "walk" or n == "run" then
				track:Stop(0.1)
			end
		end
	end)
end

function Move.setRunAnim(on)
	local a = Move.animate()
	if not a then return end
	if on then
		local runId = Move.runAnimId()
		if not runId then return end
		local changed = false
		Move.animSaved = Move.animSaved or {}
		for _, v in ipairs(a:GetChildren()) do
			if v:IsA("StringValue") and v.Name:sub(1, 4) == "walk" then
				local anim = v:FindFirstChildWhichIsA("Animation")
				if anim and anim.AnimationId ~= runId then
					if Move.animSaved[anim] == nil then Move.animSaved[anim] = anim.AnimationId end
					pcall(function() anim.AnimationId = runId end)
					changed = true
				end
			end
		end
		if changed then Move.reloadAnims() end
	elseif Move.animSaved then
		local changed = false
		for anim, was in pairs(Move.animSaved) do
			if anim and anim.Parent then
				pcall(function() anim.AnimationId = was end)
				changed = true
			end
		end
		Move.animSaved = nil
		if changed then Move.reloadAnims() end
	end
end
addCleanup("runanim", function() Move.setRunAnim(false) end)

-- Animate re-asserts speed/16 every time it notices you moving, so the rate
-- is held rather than set. Capped, because a run clip at 1.9x looks just as
-- silly as a walk clip at 1.9x.
Move.animCap = 1.35

function Move.holdAnimSpeed()
	local hum = getHum()
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return end
	pcall(function()
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track.Name == "WalkAnim" or track.Name == "RunAnim" then
				if track.Speed > Move.animCap then track:AdjustSpeed(Move.animCap) end
			end
		end
	end)
end

function Move.setSpeed(on)
	Move.speedOn = on
	if on then
		local hum = getHum()
		-- remember the game's own number once, before anything writes it
		if hum and hum.WalkSpeed > 0 and hum.WalkSpeed <= 30 and not Move.boundHum then
			Move.baseWalk = hum.WalkSpeed
		end
		Move.enforce()
	else
		Move.animOn = false
		Move.setRunAnim(false)
		local hum = getHum()
		if hum then hum.WalkSpeed = Move.baseWalk end
	end
end

function Move.setFovOn(on)
	Move.fovOn = on
	if on then
		Move.enforce()
	else
		local c = cam()
		if c then c.FieldOfView = Move.baseFov end
	end
end

-- The game reports a fall to the server on FD_Event. Zeroing both arguments
-- is what the Rayfield build did and it is the right shape: the call still
-- happens, it just reports no fall.
-- There is deliberately NO namecall hook anywhere in this file.
--
-- The detector in this game (the obfuscated client scripts MB, PR_C, R_C,
-- S_C and DE, reporting through ReplicatedStorage.ExploitEvent2) kicks the
-- moment one is installed. Not on use - on install. So a hook behind an
-- opt-in switch is still a switch that gets you kicked, which is not a
-- feature at all.
--
-- Everything that used to need one has a replacement that does not:
--   Silent Aim      makes the stun stick's own call itself instead of
--                   rewriting an argument in flight. The shapes are known.
--   No Fall Damage  holds the downward velocity under the threshold the
--                   client measures, so there is no fall to report.
--   Remote Spy      replaced by Dev > Dump Client Strings, which reads the
--                   same argument shapes off the heap with getgc.

-- Three things at once, because any one of them alone leaves a hole:
--
--   1. Never stay in Freefall. The state is what a fall tracker keys off, so
--      putting the humanoid back into Running while it descends means there
--      is no fall for the client to measure. This is the one that matters.
--   2. Clamp the descent speed, for anything that measures impact instead of
--      distance.
--   3. Zero whatever the client keeps its fall numbers in, found the same way
--      the stamina table was. Reported, so you can see whether it hit.
Move.fallClamp = 45
Move.fallKeys = { "FALL_DAMAGE", "FALL_TAKE", "FALL_HEIGHT", "FALL_MULT",
	"FallDamage", "fallDamage", "fallHeight", "FALL_MIN" }

function Move.patchFallTable()
	if typeof(getgc) ~= "function" then return false end
	local ok, all = pcall(getgc, true)
	if not ok then return false end
	local hits = 0
	for _, v in pairs(all) do
		if type(v) == "table" then
			for _, key in ipairs(Move.fallKeys) do
				local got, has = pcall(function() return rawget(v, key) ~= nil end)
				if got and has then
					pcall(function() v[key] = 0 end)
					hits = hits + 1
				end
			end
		end
	end
	Move.fallPatched = hits
	return hits > 0
end

function Move.setNoFall(on)
	Move.noFall = on
	if not on then
		if Move.fallConn then Move.fallConn:Disconnect() Move.fallConn = nil end
		Move.fallStatus = "off"
		return
	end
	Move.patchFallTable()
	Move.fallStatus = (Move.fallPatched or 0) > 0
		and ("holding state, and zeroed " .. Move.fallPatched .. " fall values")
		or "holding state (no fall table found - that is normal)"
	if Move.fallConn then return end
	Move.fallConn = RunService.Stepped:Connect(function()
		if not Move.noFall then return end
		local hum, hrp = getHum(), getHRP()
		if not hum or not hrp then return end
		local v = hrp.AssemblyLinearVelocity
		if v.Y < -6 then
			-- descending: refuse to be in freefall, and cap the speed
			local state = hum:GetState()
			if state == Enum.HumanoidStateType.Freefall
				or state == Enum.HumanoidStateType.FallingDown then
				pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
			end
			if v.Y < -Move.fallClamp then
				hrp.AssemblyLinearVelocity = Vector3.new(v.X, -Move.fallClamp, v.Z)
			end
			-- fly's BodyVelocity is solved AFTER this, so clamping the result
			-- achieves nothing; clamp what it is asking for
			if Move.flyForce and Move.flyForce.Parent then
				local want = Move.flyForce.Velocity
				if want.Y < -Move.fallClamp then
					Move.flyForce.Velocity = Vector3.new(want.X, -Move.fallClamp, want.Z)
				end
			end
		end
	end)
	addCleanup("nofall", function()
		if Move.fallConn then Move.fallConn:Disconnect() Move.fallConn = nil end
	end)
end

-- =============================== teleporting ===============================
-- Held for several frames with the humanoid in Physics state and its speed
-- zeroed, which is what stops the server pulling you back. Straight out of
-- the Rayfield build's SafeTeleport.

local Teleport = { busy = false, arrived = nil }

-- The old version zeroed your speed, set the humanoid to Physics and called
-- PivotTo for six frames. Across the map that is a several hundred stud jump
-- in a fraction of a second, and the server simply put you back - which is
-- exactly what happened going to the Shop.
--
-- This travels instead: anchored, non-colliding, velocity zeroed every step,
-- moving at about 220 studs a second, then held on the destination for a few
-- frames before control is handed back. A long trip takes a couple of
-- seconds, which is the price of arriving at all.
function Teleport.go(cf)
	if Teleport.busy then return end
	local char, hum, hrp = LocalPlayer.Character, getHum(), getHRP()
	if not (char and hrp) then return end
	Teleport.busy = true

	task.spawn(function()
		local collided = {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				collided[part] = true
				part.CanCollide = false
			end
		end
		local oldWalk = hum and hum.WalkSpeed or nil
		if hum then hum.WalkSpeed = 0 end

		-- PivotTo moves the whole rig. Writing one part leaves the rest of
		-- the joints to be resolved by physics, which is what kept dragging
		-- you back to where you started.
		for _ = 1, 20 do
			local live = LocalPlayer.Character
			if not live then break end
			pcall(function() live:PivotTo(cf) end)
			local root = getHRP()
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
			RunService.Heartbeat:Wait()
		end

		for part in pairs(collided) do
			if part and part.Parent then pcall(function() part.CanCollide = true end) end
		end
		local liveHum = getHum()
		if liveHum and oldWalk then
			liveHum.WalkSpeed = Move.speedOn and Move.walkSpeed or oldWalk
		end
		Teleport.busy = false

		task.delay(1.5, function()
			local live = getHRP()
			if not live then return end
			local off = (live.Position - cf.Position).Magnitude
			Teleport.arrived = off < 60
			if not Teleport.arrived then
				notify(string.format("the server pulled you back %d studs", math.floor(off)), 7)
			end
		end)
	end)
end

function Teleport.toFlare()
	local gun = flarePart()
	if not gun then
		notify("the flare gun has not spawned yet", 4)
		return
	end
	-- beside it and a little above, so you arrive standing rather than
	-- inside the pickup being pushed back out of it
	Teleport.go(CFrame.new(gun.Position + Vector3.new(3, 4, 3)))
end

function Teleport.toMouse()
	local hrp = getHRP()
	if not hrp then return end
	local mouse = LocalPlayer:GetMouse()
	TweenService:Create(hrp, TweenInfo.new(1, Enum.EasingStyle.Linear),
		{ CFrame = CFrame.new(mouse.Hit.Position) }):Play()
end

-- ================================ freecam ================================
-- The character is anchored and the camera follows a loose part. Rebuilt as
-- one bound loop instead of a repeat-wait thread that started four tweens
-- every frame - those tweens were most of why it felt like soup.

Free = {
	on = false, speed = 0.2, sens = 0.25, smooth = 0.18,
	yaw = 0, pitch = 0, pos = nil, vel = Vector3.zero,
}

local FREE_KEYS = {
	[Enum.KeyCode.W] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.S] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.A] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.D] = Vector3.new(1, 0, 0),
	[Enum.KeyCode.E] = Vector3.new(0, 1, 0),
	[Enum.KeyCode.Q] = Vector3.new(0, -1, 0),
}

function Free.set(on)
	Free.on = on
	local c = cam()
	if not c then return end

	if not on then
		if Free.conn then Free.conn:Disconnect() Free.conn = nil end
		pcall(function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			c.CameraType = Enum.CameraType.Custom
			local hum = getHum()
			if hum then c.CameraSubject = hum end
		end)
		Free.pos = nil
		return
	end

	-- start from where the camera already is, so switching it on does not
	-- snap the view somewhere else
	local start = c.CFrame
	Free.pos = start.Position
	Free.vel = Vector3.zero
	local look = start.LookVector
	Free.yaw = math.atan2(-look.X, -look.Z)
	Free.pitch = math.asin(math.clamp(look.Y, -1, 1))

	c.CameraType = Enum.CameraType.Scriptable

	if Free.conn then return end
	Free.conn = RunService.RenderStepped:Connect(function(dt)
		local live = cam()
		if not Free.on or not live or not Free.pos then return end

		-- look: the raw delta, not mouse.Hit. mouse.Hit is derived FROM the
		-- camera, so using it to aim the camera feeds back on itself.
		local held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if held then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UserInputService:GetMouseDelta()
			Free.yaw = Free.yaw - delta.X * Free.sens * 0.01
			Free.pitch = math.clamp(Free.pitch - delta.Y * Free.sens * 0.01, -1.4, 1.4)
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end

		local rot = CFrame.fromEulerAnglesYXZ(Free.pitch, Free.yaw, 0)

		local wanted = Vector3.zero
		for key, dir in pairs(FREE_KEYS) do
			if UserInputService:IsKeyDown(key) then wanted += dir end
		end
		if wanted.Magnitude > 0 then
			local boost = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1
			wanted = rot:VectorToWorldSpace(wanted.Unit) * Free.speed * 60 * boost
		end
		-- ease toward the wanted velocity instead of snapping to it: this is
		-- the whole of "smoother"
		local blend = math.clamp(dt / math.max(Free.smooth, 0.01), 0, 1)
		Free.vel = Free.vel:Lerp(wanted, blend)
		Free.pos = Free.pos + Free.vel * dt

		live.CFrame = CFrame.new(Free.pos) * rot
	end)
	addCleanup("freecam", function() Free.set(false) end)
end

-- ================================== fog ==================================
-- The game drives fog through a value it owns, so this writes that value
-- rather than Lighting.FogEnd; writing Lighting directly is overwritten on
-- the next tick of the game's own lighting pass.

local Fog = { on = false, saved = nil }

function Fog.value()
	local props = ReplicatedStorage:FindFirstChild("CurrentLightingProperties")
	return props and props:FindFirstChild("FogEnd") or nil
end

function Fog.set(on)
	Fog.on = on
	local v = Fog.value()
	if not v then
		if on then notify("CurrentLightingProperties.FogEnd is not there right now", 4) end
		return
	end
	if on then
		if Fog.saved == nil then Fog.saved = v.Value end
		if not Fog.conn then
			Fog.conn = RunService.Heartbeat:Connect(function()
				if not Fog.on then return end
				local live = Fog.value()
				if live and live.Value < 9e8 then live.Value = 9e9 end
			end)
			addCleanup("fogloop", function()
				if Fog.conn then Fog.conn:Disconnect() Fog.conn = nil end
			end)
		end
		v.Value = 9e9
	else
		v.Value = Fog.saved or 75
		Fog.saved = nil
	end
end

-- ================================== esp ==================================
-- ONE render loop for every drawn thing. The Rayfield build opened a fresh
-- Heartbeat connection for each label it ever made and never closed one, so
-- a long round accumulated hundreds of live handlers, most of them for
-- objects that had already been destroyed. Here the Drawing objects are
-- pooled: each frame takes what it needs off the pool and hides the rest,
-- and the pool is destroyed once on unload.

local Esp = {
	rake = false, players = false, flare = false, supply = false,
	location = false, scrap = false, showDistance = false,
	traps = false, rusty = false,
	rakeTracer = false, playerTracer = false,
	fovCircle = false, fovSize = 100,
	arrowRake = false, arrowPlayers = false, arrowLen = 15, arrowGap = 3,
	hpBar = false,
	textSize = 12,
	chams = {},
	pool = { text = {}, line = {}, tri = {} },
	used = { text = 0, line = 0, tri = 0 },
	drawn = 0, running = false,
}

Esp.colors = {
	traps    = Color3.fromRGB(150, 120, 255),
	rusty    = Color3.fromRGB(255, 60, 60),
	rake     = Color3.fromRGB(255, 0, 0),
	players  = Color3.fromRGB(0, 255, 34),
	flare    = Color3.fromRGB(0, 225, 255),
	supply   = Color3.fromRGB(251, 255, 0),
	location = Color3.fromRGB(255, 136, 0),
	scrap    = Color3.fromRGB(210, 120, 40),
}

-- Chams take the SAME colour as that category's text, so a yellow supply
-- label and a yellow supply box are obviously the same thing. Two styles:
-- a Highlight, which fills the whole shape, and a Box, which is a
-- BoxHandleAdornment around its bounds. Highlight is the prettier one but
-- Roblox only draws about 31 of them and silently drops the rest, so Box is
-- the one to use when a lot of things are lit at once.
Esp.chamStyle = "Highlight"
Esp.chamFill = 0.35
Esp.chamOutline = 0

local CHAM_STYLES = { "Highlight", "Box" }

-- ------------------------------- the pool -------------------------------

function Esp.text(str, pos, color)
	local n = Esp.used.text + 1
	Esp.used.text = n
	local d = Esp.pool.text[n]
	if not d then
		d = newDraw("Text", { Center = true, Outline = false, Font = 2 })
		if not d then return end
		Esp.pool.text[n] = d
	end
	d.Size = Esp.textSize
	d.Text = str
	d.Color = color
	d.Position = pos
	d.Visible = true
end

function Esp.line(from, to, color)
	local n = Esp.used.line + 1
	Esp.used.line = n
	local d = Esp.pool.line[n]
	if not d then
		d = newDraw("Line", { Thickness = 1 })
		if not d then return end
		Esp.pool.line[n] = d
	end
	d.From, d.To, d.Color = from, to, color
	d.Visible = true
end

function Esp.triangle(a, b, c, color)
	local n = Esp.used.tri + 1
	Esp.used.tri = n
	local d = Esp.pool.tri[n]
	if not d then
		d = newDraw("Triangle", { Filled = true })
		if not d then return end
		Esp.pool.tri[n] = d
	end
	d.PointA, d.PointB, d.PointC, d.Color = a, b, c, color
	d.Visible = true
end

function Esp.hideRest()
	for kind, list in pairs(Esp.pool) do
		for i = Esp.used[kind] + 1, #list do
			local d = list[i]
			if d then pcall(function() d.Visible = false end) end
		end
	end
end

-- -------------------------------- chams --------------------------------

local function anchorPart(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- `only` is a part for the BOX style to measure and hang off, and it is only
-- ever about the box. A BoxHandleAdornment on a Model has to size itself from
-- GetBoundingBox, and that box takes in every stray part parented to the
-- model, which is how a supply crate ended up with an enormous box floating
-- beside it. A model that names its own HitBox is telling you where it really
-- is, so the caller hands that part over.
--
-- A Highlight computes no bounds at all - it lights the geometry it is given -
-- so it always adorns the whole model and `only` is none of its business.
-- Point a Highlight at a HitBox and you get a one stud stub instead of a crate.
--
-- `outlineOnly` is the Highlight's alone. A BoxHandleAdornment has no outline,
-- so Transparency 1 there would just be an invisible box.
function Esp.cham(inst, color, only, outlineOnly)
	if not inst or not inst.Parent then return end
	local want = Esp.chamStyle
	local row = Esp.chams[inst]

	-- a style change means the old object is the wrong kind, not the wrong colour
	if row and (row.kind ~= want or not row.obj or not row.obj.Parent) then
		pcall(function() row.obj:Destroy() end)
		row = nil
	end

	if want == "Highlight" then
		if not row then
			local hl = make("Highlight", {
				Name = "RKCham", Adornee = inst, Enabled = true,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, inst)
			row = { kind = "Highlight", obj = hl }
			Esp.chams[inst] = row
		end
		if row.obj.Adornee ~= inst then row.obj.Adornee = inst end
		row.obj.FillColor, row.obj.OutlineColor = color, color
		row.obj.FillTransparency = outlineOnly and 1 or Esp.chamFill
		row.obj.OutlineTransparency = Esp.chamOutline
		row.obj.Enabled = true
		return
	end

	-- Box. A HandleAdornment has to hang off the PART it adorns; parented
	-- anywhere else it simply is not drawn.
	-- Decide WHAT is being boxed before anything is attached to it. A model
	-- that names its own HitBox is telling you where it actually is; its
	-- bounding box takes in every stray part parented to it, which is how a
	-- supply crate ended up with an enormous box floating beside it.
	local part = anchorPart(inst)
	local size, cf
	if only and only:IsA("BasePart") then
		part = only
		size = only.Size
	elseif inst:IsA("Model") then
		local ok, bb, bs = pcall(function()
			local c, sz = inst:GetBoundingBox()
			return c, sz
		end)
		if ok and bb then cf, size = bb, bs end
	end
	if not part then return end

	if not row then
		local box = make("BoxHandleAdornment", {
			Name = "RKCham", Adornee = part, AlwaysOnTop = true, ZIndex = 1,
			Size = Vector3.new(1, 1, 1), Transparency = Esp.chamFill,
		}, part)
		row = { kind = "Box", obj = box }
		Esp.chams[inst] = row
	end
	if row.obj.Adornee ~= part then
		row.obj.Adornee = part
		row.obj.Parent = part
	end
	row.obj.Size = size or (part.Size * 1.02)
	row.obj.CFrame = cf and part.CFrame:ToObjectSpace(cf) or CFrame.new()
	row.obj.Color3 = color
	row.obj.Transparency = Esp.chamFill
	row.obj.Visible = true
end

function Esp.clearChams(pred)
	for inst, row in pairs(Esp.chams) do
		if not pred or pred(inst) then
			pcall(function() row.obj:Destroy() end)
			Esp.chams[inst] = nil
		end
	end
end
addCleanup("chams", function() Esp.clearChams() end)

-- ------------------------------ the drawing ------------------------------

local function project(pos)
	local c = cam()
	if not c then return nil end
	local sp, on = c:WorldToViewportPoint(pos)
	return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local function arrowPoints(from, dir, length)
	local tip = from + dir * length
	local perp = Vector2.new(-dir.Y, dir.X)
	return tip, from + perp * (length / 2), from - perp * (length / 2)
end

function Esp.step()
	Esp.used.text, Esp.used.line, Esp.used.tri = 0, 0, 0
	local c = cam()
	if not c then Esp.hideRest() return end
	local view = c.ViewportSize
	local centre = Vector2.new(view.X / 2, view.Y / 2)
	local foot = Vector2.new(view.X / 2, view.Y)
	local me = myPos()
	local live = {}

	-- FOV circle is drawn from the pool as a real Circle, kept separate
	-- because there is only ever one of it
	if Esp.fovCircle then
		if not Esp.circle then
			Esp.circle = newDraw("Circle", {
				Thickness = 1, NumSides = 100, Filled = false,
				Color = Color3.fromRGB(255, 255, 255),
			})
		end
		if Esp.circle then
			Esp.circle.Position = centre
			Esp.circle.Radius = Esp.fovSize
			Esp.circle.Visible = true
		end
	elseif Esp.circle then
		Esp.circle.Visible = false
	end
	local arrowOffset = Esp.fovSize + Esp.arrowGap

	-- ------------------------------ the rake ------------------------------
	local r = rake()
	local rakeHrp = r and r:FindFirstChild("HumanoidRootPart")
	if r and rakeHrp then
		local hum = r:FindFirstChildOfClass("Humanoid")
		if Esp.rake then
			Esp.cham(r, Esp.colors.rake)
			live[r] = true
			local head = r:FindFirstChild("Head") or rakeHrp
			local sp, on = project(head.Position)
			if sp and on then
				local label = hum and string.format("Rake | HP: %d / %d",
					math.floor(hum.Health), math.floor(hum.MaxHealth)) or "Rake | HP: ?"
				if Esp.showDistance and me then
					label = label .. string.format(" | %dm", math.floor((rakeHrp.Position - me).Magnitude))
				end
				Esp.text(label, sp, Esp.colors.rake)
			end
		end
		if Esp.rakeTracer then
			local sp, on = project(rakeHrp.Position)
			if sp and on then Esp.line(foot, sp, Esp.colors.rake) end
		end
		if Esp.arrowRake then
			local sp, on, z = project(rakeHrp.Position)
			if sp and not on then
				local d = sp - centre
				if z and z < 0 then d = -d end
				if d.Magnitude > 0.01 then
					local dir = d.Unit
					local a, b, cc = arrowPoints(centre + dir * arrowOffset, dir, Esp.arrowLen)
					Esp.triangle(a, b, cc, Esp.colors.rake)
				end
			end
		end
	end

	-- ------------------------------ players ------------------------------
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			local head = plr.Character:FindFirstChild("Head")
			if hrp then
				if Esp.players then
					Esp.cham(plr.Character, Esp.colors.players)
					live[plr.Character] = true
					local sp, on = project((head or hrp).Position)
					if sp and on then
						local label = plr.Name
						local dt = plr:FindFirstChild("DistanceTravelled")
						if Esp.showDistance and dt then
							label = label .. " [Distance Travelled : " .. tostring(dt.Value) .. "]"
						end
						Esp.text(label, sp, Esp.colors.players)
					end
				end
				if Esp.playerTracer then
					local sp, on = project(hrp.Position)
					if sp and on then Esp.line(foot, sp, Esp.colors.players) end
				end
				if Esp.arrowPlayers then
					local sp, on, z = project(hrp.Position)
					if sp and not on then
						local d = sp - centre
						if z and z < 0 then d = -d end
						if d.Magnitude > 0.01 then
							local dir = d.Unit
							local a, b, cc = arrowPoints(centre + dir * arrowOffset, dir, Esp.arrowLen)
							Esp.triangle(a, b, cc, Esp.colors.players)
						end
					end
				end
			end
		end
	end

	-- ----------------------------- flare gun -----------------------------
	if Esp.flare then
		for _, m in ipairs(Workspace:GetChildren()) do
			if m.Name == "FlareGunPickUp" then
				local gun = m:FindFirstChild("FlareGun")
				if gun then
					Esp.cham(m, Esp.colors.flare)
					live[m] = true
					local sp, on = project(gun.Position)
					if sp and on then
						local label = "Flare Gun"
						if Esp.showDistance and me then
							label = label .. string.format(" | %dm", math.floor((gun.Position - me).Magnitude))
						end
						Esp.text(label, sp, Esp.colors.flare)
					end
				end
			end
		end
	end

	-- --------------------------- supply drops ---------------------------
	-- Back to what the Rayfield build drew: the whole crate Model outlined
	-- (desire.cc.lua:145-151 - a Highlight on the Box with FillTransparency 1)
	-- and the label at its HitBox (desire.cc.lua:1075).
	--
	-- The enormous box beside the crate was never the Highlight. There is
	-- exactly one GetBoundingBox in this file and it is inside the Box branch
	-- of Esp.cham; a Highlight lights the parts it is given and measures
	-- nothing. So the HitBox goes on being the part the BOX style measures,
	-- and the Highlight goes back to the crate itself - pointed at the HitBox
	-- it was lighting a one stud stub buried inside the model, which is the
	-- other half of "doesn't work at all".
	--
	-- The type check stays. FindFirstChild hands back ANYTHING called HitBox,
	-- including a Folder or a Value; .Position on that throws, the pcall at
	-- the bottom of Esp.step swallows it, and scrap, traps, locations and the
	-- cham sweep all stop for as long as this toggle is on.
	--
	-- The folder is empty for most of a round - dumps/everything.txt:11341 is
	-- a full depth dump of a live game and SupplyCrates has no children in it
	-- - so this branch draws nothing most of the time. That is the game, not
	-- the ESP, and a RenderStepped branch is not the place to say so.
	if Esp.supply then
		local crates = pathTo(Workspace, "Debris", "SupplyCrates")
		if crates then
			for _, box in ipairs(crates:GetChildren()) do
				local hit = box:FindFirstChild("HitBox")
				if not (hit and hit:IsA("BasePart")) then
					hit = (box:IsA("BasePart") and box)
						or box:FindFirstChildWhichIsA("BasePart", true)
				end
				if hit then
					Esp.cham(box, Esp.colors.supply, hit, true)
					live[box] = true
					local sp, on = project(hit.Position)
					if sp and on then
						local label = "Supply Drop"
						if Esp.showDistance and me then
							label = label .. string.format(" | %dm", math.floor((hit.Position - me).Magnitude))
						end
						Esp.text(label, sp, Esp.colors.supply)
					end
				end
			end
		end
	end

	-- ------------------------------- scrap -------------------------------
	if Esp.scrap then
		local spawns = pathTo(Workspace, "Filter", "ScrapSpawns")
		if spawns then
			for _, d in ipairs(spawns:GetDescendants()) do
				if d.Name == "Scrap" and d:IsA("BasePart") then
					Esp.cham(d, Esp.colors.scrap)
					live[d] = true
					local sp, on = project(d.Position)
					if sp and on then
						local parent = d.Parent
						local pts = parent and parent:FindFirstChild("PointsVal")
						local lvl = parent and parent:FindFirstChild("LevelVal")
						local label = "Scrap"
						if pts then label = label .. ", Points " .. tostring(pts.Value) end
						if lvl then label = label .. ", Level " .. tostring(lvl.Value) end
						if Esp.showDistance and me then
							label = label .. string.format(" | %dm", math.floor((d.Position - me).Magnitude))
						end
						Esp.text(label, sp, Esp.colors.scrap)
					end
				end
			end
		end
	end

	-- ------------------------------- traps -------------------------------
	-- Two kinds and they are opposites. One in Debris.Traps that the map put
	-- down is a rusty one and it is yours to avoid; anything else was placed
	-- from the shop tool and stuns the Rake for you.
	if Esp.traps or Esp.rusty then
		for _, m in ipairs(trapModels()) do
			local isRusty = m:GetAttribute("ServerSpawned") == true
			local wanted = isRusty and Esp.rusty or Esp.traps
			if wanted then
				-- looksLikeTrap already required a child called HitBox, so the
				-- fallback only ever runs when that child is not a part - and
				-- .Position on a Folder throws, which the pcall around
				-- Esp.step swallows along with everything below it
				local box = m:FindFirstChild("HitBox")
				if not (box and box:IsA("BasePart")) then
					box = m:FindFirstChildWhichIsA("BasePart", true)
				end
				if box then
					local key = isRusty and "rusty" or "traps"
					Esp.cham(m, Esp.colors[key])
					live[m] = true
					local sp, on = project(box.Position)
					if sp and on then
						local label = isRusty and "RUSTY TRAP" or "Rake Trap"
						if Esp.showDistance and me then
							label = label .. string.format(" | %dm", math.floor((box.Position - me).Magnitude))
						end
						Esp.text(label, sp, Esp.colors[key])
					end
				end
			end
		end
	end

	-- ----------------------------- locations -----------------------------
	-- Fixed points, not bounding boxes. The previous build measured the
	-- SafeHouse folder and got a box 1971 studs tall because one part in it
	-- sits at Y=1982, which is why the name floated over the map. These are
	-- the coordinates the Rayfield build used and they sit on the buildings.
	if Esp.location then
		for _, loc in ipairs(LOCATIONS) do
			local sp, on = project(loc.pos)
			if sp and on then
				local label = "[LOCATION] " .. loc.name
				if Esp.showDistance and me then
					label = label .. string.format(" | %dm", math.floor((loc.pos - me).Magnitude))
				end
				Esp.text(label, sp, Esp.colors.location)
			end
		end
	end

	-- drop the chams for anything no longer being shown
	for inst, row in pairs(Esp.chams) do
		if not live[inst] or not inst.Parent then
			pcall(function() row.obj:Destroy() end)
			Esp.chams[inst] = nil
		end
	end

	Esp.drawn = Esp.used.text + Esp.used.line + Esp.used.tri
	Esp.hideRest()
end

function Esp.refreshRunning()
	local want = Esp.rake or Esp.players or Esp.flare or Esp.supply or Esp.location
		or Esp.scrap or Esp.traps or Esp.rusty or Esp.rakeTracer or Esp.playerTracer
		or Esp.fovCircle or Esp.arrowRake or Esp.arrowPlayers
	if want and not Esp.conn then
		Esp.running = true
		Esp.conn = RunService.RenderStepped:Connect(function()
			local ok, err = pcall(Esp.step)
			if not ok then
				Esp.lastError = tostring(err)
				Esp.errors = (Esp.errors or 0) + 1
			end
		end)
		addCleanup("esploop", function()
			if Esp.conn then Esp.conn:Disconnect() Esp.conn = nil end
		end)
	elseif not want and Esp.conn then
		Esp.conn:Disconnect()
		Esp.conn = nil
		Esp.running = false
		Esp.used.text, Esp.used.line, Esp.used.tri = 0, 0, 0
		Esp.hideRest()
		if Esp.circle then Esp.circle.Visible = false end
		Esp.clearChams()
	end
end

function Esp.set(field, value)
	Esp[field] = value
	Esp.refreshRunning()
	if not value then
		-- drop the chams that belonged to whatever was just switched off
		Esp.clearChams()
	end
end

-- ============================== the hp bar ==============================
-- Bottom right, its own small HUD. Kept because it is genuinely the fastest
-- way to see whether the thing chasing you is nearly down.

local HpBar = { on = false }

function HpBar.build()
	if HpBar.back or not HAS_DRAWING then return end
	HpBar.back = newDraw("Square", { Filled = true, Thickness = 1,
		Color = Color3.fromRGB(50, 50, 50) })
	HpBar.fill = newDraw("Square", { Filled = true, Thickness = 1,
		Color = Color3.fromRGB(255, 0, 0) })
	HpBar.text = newDraw("Text", { Size = 14, Center = true, Outline = true,
		Color = Color3.fromRGB(255, 255, 255) })
	HpBar.info = newDraw("Text", { Size = 14, Center = true, Outline = true,
		Color = Color3.fromRGB(255, 255, 255) })
end

function HpBar.hide()
	for _, k in ipairs({ "back", "fill", "text", "info" }) do
		local d = HpBar[k]
		if d then pcall(function() d.Visible = false end) end
	end
end

function HpBar.set(on)
	HpBar.on = on
	HpBar.build()
	if not on then
		HpBar.hide()
		if HpBar.conn then HpBar.conn:Disconnect() HpBar.conn = nil end
		return
	end
	if HpBar.conn then return end
	HpBar.conn = RunService.RenderStepped:Connect(function()
		if not HpBar.on or not HpBar.back then return end
		local r, c = rake(), cam()
		local hrp = r and r:FindFirstChild("HumanoidRootPart")
		local hum = r and r:FindFirstChildOfClass("Humanoid")
		if not (r and hrp and hum and c) then HpBar.hide() return end

		local view = c.ViewportSize
		local w, h, margin = 150, 15, 20
		local origin = Vector2.new(view.X - w - margin, view.Y - h - margin)
		local perc = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

		HpBar.back.Size, HpBar.back.Position = Vector2.new(w, h), origin
		HpBar.fill.Size, HpBar.fill.Position = Vector2.new(w * perc, h), origin
		HpBar.fill.Color = perc > 0.5
			and Color3.new(1 - (perc - 0.5) * 2, 1, 0)
			or Color3.new(1, perc * 2, 0)

		HpBar.text.Text = string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
		HpBar.text.Position = origin + Vector2.new(w / 2, h / 2 - 7)

		local me = myPos()
		local dist = me and math.floor((hrp.Position - me).Magnitude) or 0
		local target = r:FindFirstChild("TargetVal")
		local who = target and target.Value and target.Value.Parent
		HpBar.info.Text = string.format("%d studs   %s", dist,
			who and ("after " .. tostring(who)) or "no target")
		HpBar.info.Position = origin + Vector2.new(w / 2, -18)

		HpBar.back.Visible, HpBar.fill.Visible = true, true
		HpBar.text.Visible, HpBar.info.Visible = true, true
	end)
	addCleanup("hpbar", function()
		if HpBar.conn then HpBar.conn:Disconnect() HpBar.conn = nil end
		HpBar.hide()
	end)
end

-- ================================= combat =================================
-- The stun stick is the only thing here that talks to the server, and it
-- does it exactly the way the game does: FireServer("S") to swing, then
-- FireServer("H", part) to report the hit. Both shapes came off the running
-- game, not from guessing.

Fight = {
	aura = false, silent = false, silentHits = 0,
	toolName = "StunStick", equipRange = 100,
	mode = "Default", burst = 3, healBack = 10, healWait = 12,
	struck = 0, waitingFrom = nil, waitingSince = nil,
	range = 200, gap = 0.1, last = 0, swings = 0, status = "off",
	hitbox = false, hitboxSize = 5,
	noCooldown = false, noBreak = false, patchStatus = "off",
	reach = false, reachSize = 10,
	bug = false,
}

-- Move the stick's own HitPart onto whatever is being hit. The server tests
-- against that part, which is why a swing registers at range at all.
function Fight.aimHitPart(target)
	-- remembered so the hit marker knows where to draw its x
	Fight.lastTarget = target
	local tool = Fight.stick()
	local hitPart = tool and tool:FindFirstChild("HitPart")
	if hitPart and target then
		pcall(function() hitPart.Position = target.Position end)
	end
end

function Fight.silentTarget()
	local r = rake()
	local me = myPos()
	if not (r and me) then return nil end
	local hum = r:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then return nil end
	-- whichever part of it is closest to you, not always the root: a limb
	-- that is nearer is a better thing to report having hit
	local best, bestDist
	for _, d in ipairs(r:GetChildren()) do
		if d:IsA("BasePart") then
			local dist = (d.Position - me).Magnitude
			if not bestDist or dist < bestDist then best, bestDist = d, dist end
		end
	end
	if not best or bestDist > Fight.range then return nil end
	return best
end

-- Silent aim, without touching a call already in flight. When YOU swing we
-- simply make the game's own call ourselves, aimed at the Rake: the shapes
-- are known, so there is nothing to intercept and nothing to detect. Your
-- own swing still goes out as normal alongside it.
function Fight.setSilent(on)
	Fight.silent = on
	Fight.silentHits = 0
	if on then Fight.holdHitPart() end
	if not on then
		if Fight.silentConn then Fight.silentConn:Disconnect() Fight.silentConn = nil end
		return
	end
	if Fight.silentConn then return end
	-- held rather than tapped: keep swinging for as long as the button is
	-- down, at the tool's own pace
	Fight.silentConn = RunService.Heartbeat:Connect(function()
		if not Fight.silent then return end
		local held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		if not held then return end
		if os.clock() - (Fight.silentLast or 0) < Fight.gap then return end
		-- stick() only finds it in the Character, which already means equipped
		if not Fight.stick() then return end
		local target = Fight.silentTarget()
		if not target then return end
		Fight.silentLast = os.clock()
		Fight.aimHitPart(target)
		-- a frame for the part to settle where the server will look for it
		RunService.Heartbeat:Wait()
		if Fight.swing(target) then
			Fight.silentHits = (Fight.silentHits or 0) + 1
		end
	end)
	addCleanup("silentaim", function()
		if Fight.silentConn then Fight.silentConn:Disconnect() Fight.silentConn = nil end
	end)
end

-- The stun stick's cooldown and its malfunction chance are numbers the
-- client holds, the same way stamina was. This finds them by name and zeroes
-- them, and reports what it actually hit rather than claiming success.
Fight.coolKeys = { "COOLDOWN", "ATTACK_COOLDOWN", "SWING_COOLDOWN", "HIT_COOLDOWN",
	"AttackCooldown", "attackCooldown", "cooldown", "DEBOUNCE", "Debounce" }
Fight.breakKeys = { "MALFUNCTION", "MALFUNCTION_CHANCE", "BREAK_CHANCE",
	"MalfunctionChance", "malfunction", "FAIL_CHANCE", "JAM_CHANCE" }

local DEBOUNCE_NAMES = { db = true, DB = true, Debounce = true, debounce = true,
	Cooldown = true, cooldown = true, CD = true }
local BREAK_NAMES = { Broken = true, broken = true, Jammed = true, jammed = true,
	Malfunction = true, malfunction = true, Disabled = true }

-- the tool in your hands, which is the part we can actually see
function Fight.patchTool()
	local tool = Fight.stick()
	if not tool then return 0, 0 end
	local cool, broke = 0, 0
	if Fight.noCooldown then
		-- Roblox gates Activated on this, so a tool that has switched it off
		-- is a tool that will not swing
		if tool:IsA("Tool") and not tool.Enabled then
			pcall(function() tool.Enabled = true end)
			cool = cool + 1
		end
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BoolValue") then
			if Fight.noCooldown and DEBOUNCE_NAMES[d.Name] and d.Value == true then
				pcall(function() d.Value = false end)
				cool = cool + 1
			elseif Fight.noBreak and BREAK_NAMES[d.Name] and d.Value == true then
				pcall(function() d.Value = false end)
				broke = broke + 1
			end
		elseif d:IsA("NumberValue") or d:IsA("IntValue") then
			local lower = string.lower(d.Name)
			if Fight.noCooldown and d.Value ~= 0
				and (lower:find("cool", 1, true) or lower:find("time", 1, true)
					or lower:find("delay", 1, true) or lower:find("rate", 1, true)) then
				pcall(function() d.Value = 0 end)
				cool = cool + 1
			elseif Fight.noBreak and d.Value ~= 0
				and (lower:find("chance", 1, true) or lower:find("malf", 1, true)) then
				pcall(function() d.Value = 0 end)
				broke = broke + 1
			end
		end
	end
	-- attributes too: the game's own tools carry their state that way
	local ok, attrs = pcall(function() return tool:GetAttributes() end)
	if ok and attrs then
		for key, value in pairs(attrs) do
			local lower = string.lower(key)
			if Fight.noCooldown and type(value) == "number" and value ~= 0
				and (lower:find("cool", 1, true) or lower:find("time", 1, true)) then
				pcall(function() tool:SetAttribute(key, 0) end)
				cool = cool + 1
			elseif Fight.noCooldown and value == true and DEBOUNCE_NAMES[key] then
				pcall(function() tool:SetAttribute(key, false) end)
				cool = cool + 1
			elseif Fight.noBreak and BREAK_NAMES[key] and value == true then
				pcall(function() tool:SetAttribute(key, false) end)
				broke = broke + 1
			end
		end
	end
	return cool, broke
end

function Fight.patchWeapon()
	local toolCool, toolBreak = Fight.patchTool()
	local gcCool, gcBreak = 0, 0
	if typeof(getgc) == "function" then
		local ok, all = pcall(getgc, true)
		if ok then
			for _, v in pairs(all) do
				if type(v) == "table" then
					if Fight.noCooldown then
						for _, key in ipairs(Fight.coolKeys) do
							local got, has = pcall(function() return type(rawget(v, key)) == "number" end)
							if got and has then
								pcall(function() v[key] = 0 end)
								gcCool = gcCool + 1
							end
						end
					end
					if Fight.noBreak then
						for _, key in ipairs(Fight.breakKeys) do
							local got, has = pcall(function() return type(rawget(v, key)) == "number" end)
							if got and has then
								pcall(function() v[key] = 0 end)
								gcBreak = gcBreak + 1
							end
						end
					end
				end
			end
		end
	end
	local bits = {}
	if Fight.noCooldown then
		bits[#bits + 1] = string.format("cooldown: %d on the tool, %d on the heap", toolCool, gcCool)
	end
	if Fight.noBreak then
		bits[#bits + 1] = string.format("malfunction: %d on the tool, %d on the heap", toolBreak, gcBreak)
	end
	Fight.patchStatus = #bits > 0 and table.concat(bits, "\n") or "off"
	return (toolCool + toolBreak + gcCool + gcBreak) > 0
end

function Fight.setAutoEquip(on)
	Fight.autoEquip = on
	if not on then
		if Fight.equipConn then Fight.equipConn:Disconnect() Fight.equipConn = nil end
		return
	end
	if Fight.equipConn then return end
	Fight.equipConn = RunService.Heartbeat:Connect(function()
		if not Fight.autoEquip then return end
		if os.clock() - (Fight.equipLast or 0) < 0.4 then return end
		Fight.equipLast = os.clock()
		local char, hum = LocalPlayer.Character, getHum()
		local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
		if not (char and hum and bp) then return end
		local r = rake()
		local hrp = r and r:FindFirstChild("HumanoidRootPart")
		local me = myPos()
		local close = hrp and me and (hrp.Position - me).Magnitude <= Fight.equipRange
		local held = char:FindFirstChild(Fight.toolName)
		local stowed = bp:FindFirstChild(Fight.toolName)
		if close and not held and stowed then
			pcall(function() hum:EquipTool(stowed) end)
		elseif not close and held then
			pcall(function() hum:UnequipTools() end)
		end
	end)
	addCleanup("autoequip", function() Fight.setAutoEquip(false) end)
end

-- The tool's cooldown gates the tool's own handler. This does not use that
-- handler: it sends the same pair of calls the tool would have sent, at our
-- pace rather than its own.
function Fight.setNoCooldown(on)
	Fight.noCooldown = on
	if not on then
		if Fight.spamConn then Fight.spamConn:Disconnect() Fight.spamConn = nil end
		if not Fight.noBreak then Fight.setPatch("noBreak", false) end
		return
	end
	Fight.setPatch("noCooldown", true)
	if Fight.spamConn then return end
	Fight.spamConn = RunService.Heartbeat:Connect(function()
		if not Fight.noCooldown then return end
		if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
		if os.clock() - (Fight.spamLast or 0) < 0.12 then return end
		local tool = Fight.stick()
		if not tool then return end
		local target = Fight.silentTarget()
		if not target then
			-- nothing in range: still swing, so the animation and the sound
			-- keep up with the button rather than stuttering on a cooldown
			local r = rake()
			target = r and r:FindFirstChild("HumanoidRootPart")
		end
		if not target then return end
		Fight.spamLast = os.clock()
		Fight.aimHitPart(target)
		Fight.swing(target)
	end)
	Fight.holdHitPart()
	addCleanup("nocooldown", function() Fight.setNoCooldown(false) end)
end

function Fight.setPatch(field, value)
	Fight[field] = value
	if Fight.noCooldown or Fight.noBreak then
		if not Fight.patchConn then
			-- the tool half has to run constantly, because a debounce is set
			-- the moment you swing and cleared when it expires
			Fight.patchConn = RunService.Heartbeat:Connect(function()
				if not (Fight.noCooldown or Fight.noBreak) then return end
				Fight.patchTool()
				if os.clock() - (Fight.patchLast or 0) < 3 then return end
				Fight.patchLast = os.clock()
				Fight.patchWeapon()
			end)
			addCleanup("weaponpatch", function()
				if Fight.patchConn then Fight.patchConn:Disconnect() Fight.patchConn = nil end
			end)
		end
		Fight.patchWeapon()
		Fight.gap = 0.05
	else
		if Fight.patchConn then Fight.patchConn:Disconnect() Fight.patchConn = nil end
		Fight.patchStatus = "off"
		Fight.gap = 0.1
	end
end

function Fight.stick()
	local char = LocalPlayer.Character
	local tool = char and char:FindFirstChild(Fight.toolName)
	return tool, tool and tool:FindFirstChild("Event") or nil
end

-- The two calls are a swing and then a hit, and they are a frame apart on
-- purpose: sent together, the hit arrives before there is a swing to attach
-- it to and the server discards it.
function Fight.swing(target)
	local tool, event = Fight.stick()
	if not (tool and event and target) then return false end
	task.spawn(function()
		pcall(function() event:FireServer("S") end)
		task.wait()
		local live = select(2, Fight.stick())
		if live then pcall(function() live:FireServer("H", target) end) end
	end)
	return true
end

-- StunStick.HitPart is what the server tests the hit against, and it does
-- that on its own tick rather than the frame we sent it - so the part has to
-- SIT on the target, not be moved there at the moment of the swing.
function Fight.holdHitPart()
	if Fight.holdConn then return end
	Fight.holdConn = RunService.Heartbeat:Connect(function()
		if not (Fight.aura or Fight.silent) then return end
		local tool = Fight.stick()
		local hitPart = tool and tool:FindFirstChild("HitPart")
		if not hitPart then return end
		local target = Fight.lastTarget
		if not (target and target.Parent) then
			local r = rake()
			target = r and r:FindFirstChild("HumanoidRootPart")
		end
		if target then
			pcall(function() hitPart.Position = target.Position end)
		end
	end)
	addCleanup("hitpart", function()
		if Fight.holdConn then Fight.holdConn:Disconnect() Fight.holdConn = nil end
	end)
end

function Fight.enforce()
	if Fight.conn then return end
	Fight.conn = RunService.Heartbeat:Connect(function()
		local r = rake()
		local hrp = r and r:FindFirstChild("HumanoidRootPart")

		-- the aura
		if Fight.aura and hrp and os.clock() - Fight.last >= Fight.gap then
			Fight.last = os.clock()
			local me = myPos()
			local hum = r and r:FindFirstChildOfClass("Humanoid")
			if me and (hrp.Position - me).Magnitude < Fight.range then
				local allowed = true

				if Fight.mode == "Smart" and hum then
					if Fight.waitingFrom then
						local healed = hum.Health - Fight.waitingFrom
						local waited = os.clock() - (Fight.waitingSince or 0)
						-- either it healed the ten back, or it is never going
						-- to and the cycle carries on regardless
						if healed >= Fight.healBack or waited >= Fight.healWait then
							Fight.waitingFrom, Fight.waitingSince = nil, nil
							Fight.struck = 0
						else
							allowed = false
							Fight.status = string.format("letting it heal  %d / %d",
								math.max(math.floor(healed), 0), Fight.healBack)
						end
					elseif Fight.struck >= Fight.burst then
						Fight.waitingFrom = hum.Health
						Fight.waitingSince = os.clock()
						allowed = false
					end
				end

				if allowed then
					Fight.aimHitPart(hrp)
					if Fight.swing(hrp) then
						Fight.swings = Fight.swings + 1
						Fight.struck = Fight.struck + 1
						Fight.status = Fight.mode == "Smart"
							and string.format("hit %d of %d", Fight.struck, Fight.burst)
							or string.format("swinging  (%d)", Fight.swings)
					else
						Fight.status = "no StunStick equipped"
					end
				end
			else
				Fight.status = "out of range"
			end
		elseif Fight.aura and not hrp then
			Fight.status = "no Rake in the world"
			Fight.struck, Fight.waitingFrom = 0, nil
		end

		-- bug it: swings as fast as the stick will actually register rather
		-- than twenty five a frame. ChangeState on his humanoid used to sit
		-- here too; the Rake is server owned, so that write never left this
		-- client and it is gone rather than kept as theatre.
		if Fight.bug and hrp then
			local hum = r:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0
				and os.clock() - (Fight.bugLast or 0) >= 0.1 then
				Fight.bugLast = os.clock()
				Fight.aimHitPart(hrp)
				Fight.swing(hrp)
			end
		end

		-- the hitbox
		if Fight.hitbox and r and hrp then
			local box = r:FindFirstChild("RKHitbox")
			if not box then
				box = make("Part", {
					Name = "RKHitbox", Anchored = true, CanCollide = false,
					Transparency = 0.7, Color = Color3.fromRGB(255, 0, 0),
					Material = Enum.Material.Neon,
				}, r)
			end
			box.Size = Vector3.new(Fight.hitboxSize, Fight.hitboxSize, Fight.hitboxSize)
			box.CFrame = hrp.CFrame
		elseif r then
			local box = r:FindFirstChild("RKHitbox")
			if box then box:Destroy() end
		end
	end)
	addCleanup("fightloop", function()
		if Fight.conn then Fight.conn:Disconnect() Fight.conn = nil end
		local r = rake()
		local box = r and r:FindFirstChild("RKHitbox")
		if box then pcall(function() box:Destroy() end) end
	end)
end

function Fight.set(field, value)
	Fight[field] = value
	if field == "aura" and value then Fight.holdHitPart() end
	if Fight.aura or Fight.bug or Fight.hitbox then
		Fight.enforce()
	elseif Fight.conn then
		-- nothing left wants the loop, so stop paying for it
		Fight.conn:Disconnect()
		Fight.conn = nil
		local r = rake()
		local box = r and r:FindFirstChild("RKHitbox")
		if box then pcall(function() box:Destroy() end) end
	end
	if field == "aura" and not value then Fight.status = "off" end
end

function Fight.setReach(on)
	Fight.reach = on
	if on then
		if not Fight.circle then
			Fight.circle = make("Part", {
				Name = "RKReach", Anchored = true, CanCollide = false,
				Material = Enum.Material.Neon, Color = Color3.fromRGB(0, 255, 0),
				Transparency = 0.6, Size = Vector3.new(Fight.reachSize, 0.2, Fight.reachSize),
			}, Workspace)
			make("CylinderMesh", {}, Fight.circle)
		end
		Fight.reachConn = RunService.RenderStepped:Connect(function()
			local hrp = getHRP()
			if hrp and Fight.circle then
				Fight.circle.Size = Vector3.new(Fight.reachSize, 0.2, Fight.reachSize)
				Fight.circle.CFrame = hrp.CFrame * CFrame.new(0, -3, 0)
			end
		end)
		addCleanup("reach", function() Fight.setReach(false) end)
	else
		if Fight.reachConn then Fight.reachConn:Disconnect() Fight.reachConn = nil end
		if Fight.circle then pcall(function() Fight.circle:Destroy() end) Fight.circle = nil end
	end
end

