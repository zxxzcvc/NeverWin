-- ============================= rake skins =============================
-- Re-dressing the Rake on your own screen. Everything here is a local
-- property write on his parts, so it is yours and nobody else's - and it is
-- put back exactly, because a Rake left permanently repainted is a bug and
-- not a skin.
--
-- ON ASSETS, and why there are none: this project has already had an
-- ImageLabel refuse to load with "Asset is not approved for the requester",
-- and I cannot verify a marketplace decal id from here - a wrong one is a
-- feature that silently does nothing. So the anime face is BUILT, out of the
-- same geometry the aura hearts are: parts and a SpecialMesh, which cannot
-- fail to load. If you find a decal you like, the Face Image box takes an id
-- and overrides the built one.

local Skin = {
	style = "Default", on = nil,
	saved = nil, parts = nil, eyes = nil, mouth = nil,
	conn = nil, paintedOn = nil, last = 0,
}

Skin.STYLES = { "Default", "Anime" }

function Skin.rakeParts(r)
	local out = {}
	for _, d in ipairs(r:GetDescendants()) do
		if d:IsA("BasePart") then out[#out + 1] = d end
	end
	return out
end

function Skin.clear()
	if Skin.parts then
		for _, p in ipairs(Skin.parts) do pcall(function() p:Destroy() end) end
	end
	Skin.parts = nil
	if Skin.saved then
		for part, was in pairs(Skin.saved) do
			if part and part.Parent then
				pcall(function()
					part.Color = was.color
					part.Material = was.material
					part.Transparency = was.transparency
					if was.texture ~= nil then part.TextureID = was.texture end
				end)
			end
		end
	end
	Skin.saved, Skin.on = nil, nil
end
addCleanup("rakeskin", function() Skin.clear() end)

-- One cartoon eye: a flattened sphere for the white and a smaller darker one
-- in front of it, welded nowhere and simply held on the head each frame -
-- the head is server owned, so a weld of ours would be argued with.
function Skin.eye(head, side, size)
	local white = make("Part", {
		Name = "RKEye", Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, CastShadow = false, Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(255, 255, 255),
		Size = Vector3.new(size * 0.62, size * 0.9, size * 0.28),
	}, Workspace)
	make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, white)
	local iris = make("Part", {
		Name = "RKIris", Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
		Color = Color3.fromRGB(90, 150, 255),
		Size = Vector3.new(size * 0.34, size * 0.5, size * 0.2),
	}, Workspace)
	make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, iris)
	return { white = white, iris = iris, side = side }
end

function Skin.build(r)
	local head = r:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end
	local size = math.max(head.Size.Y, 1.4)
	Skin.parts = {}
	Skin.eyes = { Skin.eye(head, -1, size), Skin.eye(head, 1, size) }
	for _, e in ipairs(Skin.eyes) do
		Skin.parts[#Skin.parts + 1] = e.white
		Skin.parts[#Skin.parts + 1] = e.iris
	end
	local mouth = make("Part", {
		Name = "RKMouth", Anchored = true, CanCollide = false, CanQuery = false,
		CanTouch = false, CastShadow = false, Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(40, 20, 25),
		Size = Vector3.new(size * 0.34, size * 0.12, size * 0.16),
	}, Workspace)
	Skin.mouth = mouth
	Skin.parts[#Skin.parts + 1] = mouth
end

function Skin.hold()
	local r = rake()
	if not (Skin.on == "Anime" and r and Skin.parts) then return end
	local head = r:FindFirstChild("Head")
	if not (head and head.Parent) then return end
	local size = math.max(head.Size.Y, 1.4)
	local cf = head.CFrame
	for _, e in ipairs(Skin.eyes or {}) do
		local at = cf * CFrame.new(e.side * size * 0.3, size * 0.12, -size * 0.5)
		e.white.CFrame = at
		e.iris.CFrame = at * CFrame.new(0, 0, -size * 0.06)
	end
	if Skin.mouth then
		Skin.mouth.CFrame = cf * CFrame.new(0, -size * 0.34, -size * 0.5)
	end
end

function Skin.apply()
	local r = rake()
	if not r then return false, "no Rake in the world" end
	if Skin.on == Skin.style and Skin.parts then return true end
	Skin.clear()
	if Skin.style == "Default" then return true, "back to his own skin" end

	Skin.saved = {}
	for _, p in ipairs(Skin.rakeParts(r)) do
		local ok = pcall(function()
			Skin.saved[p] = {
				color = p.Color, material = p.Material,
				transparency = p.Transparency,
				texture = p:IsA("MeshPart") and p.TextureID or nil,
			}
			-- pale and smooth, and the mesh textures off, because his own
			-- skin texture over a flat colour still reads as him
			p.Color = Color3.fromRGB(252, 232, 224)
			p.Material = Enum.Material.SmoothPlastic
			if p:IsA("MeshPart") then p.TextureID = "" end
		end)
		if not ok then Skin.saved[p] = nil end
	end
	Skin.build(r)
	Skin.on = Skin.style
	Skin.hold()
	return true, "anime skin on - built from parts, so nothing to fail to load"
end

function Skin.set(style)
	Skin.style = style
	local ok, why = Skin.apply()
	if why then notify(why, 4) end
	if style ~= "Default" and not Skin.conn then
		Skin.conn = RunService.RenderStepped:Connect(function()
			if Skin.style == "Default" then return end
			-- he respawns between rounds, and the new model is not the one
			-- that was painted
			if os.clock() - (Skin.last or 0) >= 0.5 then
				Skin.last = os.clock()
				local r = rake()
				if r and Skin.paintedOn ~= r then
					Skin.paintedOn = r
					Skin.on = nil
					Skin.apply()
				end
			end
			Skin.hold()
		end)
		addCleanup("rakeskinloop", function()
			if Skin.conn then Skin.conn:Disconnect() Skin.conn = nil end
		end)
	elseif style == "Default" and Skin.conn then
		Skin.conn:Disconnect()
		Skin.conn = nil
		Skin.paintedOn = nil
	end
end

