-- Applied THROUGH the ThemeManager pickers: writing Library.Scheme directly
-- leaves the pickers on their stock values, so the next time one is touched
-- it copies them back and the window snaps to default grey.
do
	local wanted = {
		BackgroundColor = Color3.fromRGB(8, 14, 30),
		MainColor       = Color3.fromRGB(13, 22, 44),
		OutlineColor    = Color3.fromRGB(32, 52, 96),
		AccentColor     = Color3.fromRGB(70, 130, 235),
	}
	local hasSaved = false
	pcall(function()
		if isfile and isfile("Rake/themes/default.txt") then hasSaved = true end
	end)
	if not hasSaved then
		for index, color in pairs(wanted) do
			local picker = Options[index]
			if picker and typeof(picker.SetValueRGB) == "function" then
				pcall(function() picker:SetValueRGB(color) end)
			else
				Library.Scheme[index] = color
			end
		end
		pcall(function() Library:UpdateColorsUsingRegistry() end)
	end
end

