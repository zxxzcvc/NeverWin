-- A readout, not a hint. It says what the script is seeing right now, which
-- is the only way to answer "why is nothing happening" without guessing.
local function liveLabel(gb, getText, rate)
	local label = gb:AddLabel("...", true)
	task.spawn(function()
		while not Library.Unloaded do
			local ok, text = pcall(getText)
			pcall(function() label:SetText(ok and text or ("error: " .. tostring(text))) end)
			task.wait(rate or 0.5)
		end
	end)
	return label
end

-- A tab builder that throws loses every groupbox after the failure, and the
-- only sign is a notification that has faded by the time you notice. Record
-- it and show it on Settings instead.
local UIReport = {}

local function tryBuild(name, fn, tab)
	local ok, err = pcall(fn, tab)
	UIReport[#UIReport + 1] = { name = name, ok = ok, err = not ok and tostring(err) or nil }
	if not ok then
		warn("[RK] " .. name .. " tab failed: " .. tostring(err))
		notify(name .. " tab failed - see Settings > Build Report", 10)
	end
end

