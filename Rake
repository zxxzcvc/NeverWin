-- Respawning drops everything that lived on the old character, so the
-- property hooks have to be re-attached to the new Humanoid.
bind(LocalPlayer.CharacterAdded, function(char)
	task.wait(0.6)
	pcall(function()
		-- the new character is neither anchored nor under the map, so the
		-- hide state died with the old one. Un-check the box WITHOUT
		-- SetValue: that calls the callback, which would fling the fresh
		-- character fifteen studs up.
		if Ex.hidden then
			Ex.hidden, Ex.hideBusy = false, false
			if Ex.hideGlow then Ex.hideGlow.Adornee = nil Ex.hideGlow.Parent = nil end
			-- the OFF branch is what normally parks the pillar and dying
			-- skips it, so park it here or a 1000 stud slab is left behind
			if Ex.hidePart and Ex.hidePart.Parent then
				pcall(function() Ex.hidePart.Position = Vector3.new(0, 10000, 0) end)
			end
			local tg = Toggles.RK_Hide
			if tg then
				tg.Value = false
				pcall(function() tg:Display() end)
			end
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and not Move.speedOn then Move.baseWalk = hum.WalkSpeed end
		Move.rebind()
		Stam.tbl, Stam.nvgTbl = nil, nil
		-- the new Humanoid arrives with the game's defaults
		Move.baseJump, Move.baseUseJump = nil, nil
		if Move.jumpPower and Move.jumpPower ~= 50 then Move.setJumpPower(Move.jumpPower) end
		if Move.fly then
			Move.setFly(false)
			Move.setFly(true)
		end
		if Comfort.zoom then
			Comfort.setZoom(false)
			Comfort.setZoom(true)
		end
		if Stam.on then Stam.apply() end
		if Stam.nvg then Stam.applyNvg() end
	end)
end)

