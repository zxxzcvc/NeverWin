-- ------------------------------ hit markers ------------------------------
-- A hit is not "we swung", it is "its health went down". Watching the Rake's
-- HealthChanged means the marker only appears when something actually landed,
-- which also makes it the honest answer to "is the killaura working".

local Hit = {
	on = false, ping = true, sound = "rbxassetid://3779045779",
	life = 0.55, size = 14, colour = Color3.fromRGB(255, 80, 80),
	marks = {}, count = 0, lastHealth = nil, watched = nil,
	stickMuted = {},
}

function Hit.build()
	if Hit.gui and Hit.gui.Parent then return end
	Hit.gui = newGui("RKHits", 902)
	Hit.snd = make("Sound", {
		Name = "RKPing", SoundId = Hit.sound, Volume = 0.5,
	}, Hit.gui)
end

function Hit.mark(worldPos)
	Hit.build()
	local c = cam()
	if not c then return end
	Hit.count = Hit.count + 1

	-- a small x, two rotated bars, drawn where it was hit
	local holder = make("Frame", {
		Name = "X", BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(Hit.size, Hit.size),
	}, Hit.gui)
	for _, angle in ipairs({ 45, -45 }) do
		make("Frame", {
			BorderSizePixel = 0, BackgroundColor3 = Hit.colour,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(Hit.size, 2), Rotation = angle,
		}, holder)
	end

	local row = { frame = holder, at = worldPos, born = os.clock() }
	Hit.marks[#Hit.marks + 1] = row

	if Hit.ping and Hit.snd then
		pcall(function()
			Hit.snd.SoundId = Hit.sound
			Hit.snd.TimePosition = 0
			Hit.snd:Play()
		end)
	end
end

-- Every sound the stick makes, so the ping is the only thing you hear when
-- something lands.
function Hit.stickSounds()
	local out = {}
	local char = LocalPlayer.Character
	local tool = char and char:FindFirstChild("StunStick")
	if not tool then return out end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("Sound") then out[#out + 1] = d end
	end
	return out
end

function Hit.muteStick(on)
	if on then
		for _, snd in ipairs(Hit.stickSounds()) do
			if Hit.stickMuted[snd] == nil then Hit.stickMuted[snd] = snd.Volume end
			if snd.Volume > 0 then
				pcall(function()
					snd.Volume = 0
					snd:Stop()
				end)
			end
		end
	else
		for snd, was in pairs(Hit.stickMuted) do
			if snd and snd.Parent then pcall(function() snd.Volume = was end) end
		end
		Hit.stickMuted = {}
	end
end
addCleanup("stickmute", function() Hit.muteStick(false) end)

function Hit.watch()
	local r = rake()
	local hum = r and r:FindFirstChildOfClass("Humanoid")
	if hum == Hit.watched then return end
	if Hit.conn then Hit.conn:Disconnect() Hit.conn = nil end
	Hit.watched = hum
	Hit.lastHealth = hum and hum.Health or nil
	if not hum then return end
	Hit.conn = hum.HealthChanged:Connect(function(now)
		if not Hit.on then
			Hit.lastHealth = now
			return
		end
		local before = Hit.lastHealth or now
		Hit.lastHealth = now
		if now >= before then return end
		-- where it was hit: the part we last aimed at, else its root
		local part = Fight.lastTarget
		if not (part and part.Parent) then
			part = r and r:FindFirstChild("HumanoidRootPart")
		end
		if part then Hit.mark(part.Position) end
	end)
end

function Hit.step()
	local c = cam()
	if not c then return end
	local now = os.clock()
	for i = #Hit.marks, 1, -1 do
		local row = Hit.marks[i]
		local age = now - row.born
		if age >= Hit.life or not row.frame.Parent then
			pcall(function() row.frame:Destroy() end)
			table.remove(Hit.marks, i)
		else
			local sp, on = c:WorldToViewportPoint(row.at)
			row.frame.Visible = on
            if on then
				row.frame.Position = UDim2.fromOffset(sp.X, sp.Y)
				local fade = age / Hit.life
				for _, bar in ipairs(row.frame:GetChildren()) do
					bar.BackgroundTransparency = fade
				end
			end
		end
	end
end

function Hit.set(on)
	Hit.on = on
	if not on then
		if Hit.conn then Hit.conn:Disconnect() Hit.conn = nil end
		if Hit.loop then Hit.loop:Disconnect() Hit.loop = nil end
		Hit.watched = nil
		Hit.muteStick(false)
		for _, row in ipairs(Hit.marks) do pcall(function() row.frame:Destroy() end) end
		Hit.marks = {}
		return
	end
	Hit.build()
	Hit.watch()
	if Hit.loop then return end
	Hit.loop = RunService.RenderStepped:Connect(function()
		if not Hit.on then return end
		Hit.watch()
		Hit.step()
		-- the tool is a fresh instance every equip, so keep re-applying
		if os.clock() - (Hit.muteLast or 0) >= 1 then
			Hit.muteLast = os.clock()
			Hit.muteStick(Hit.ping)
		end
	end)
	addCleanup("hitmarks", function() Hit.set(false) end)
end

