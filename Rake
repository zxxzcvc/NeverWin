function Sky.clearGrade()
	if Sky.atmos then pcall(function() Sky.atmos:Destroy() end) Sky.atmos = nil end
	if Sky.cc then pcall(function() Sky.cc:Destroy() end) Sky.cc = nil end
	if Sky.hidden then
		for obj, was in pairs(Sky.hidden) do
			if obj and obj.Parent then pcall(function() obj.Enabled = was end) end
		end
		Sky.hidden = nil
	end
	if Sky.gameAtmos and Sky.gameAtmos.Parent == nil then
		pcall(function() Sky.gameAtmos.Parent = Lighting end)
	end
	Sky.gameAtmos = nil
end
addCleanup("skygrade", function() Sky.clearGrade() end)

function Sky.grade(name)
	local spec = Sky.GRADE[name]
	if not spec then
		Sky.clearGrade()
		return
	end
	-- the game's own Atmosphere is driven by a tween on the day/night change,
	-- and you cannot win an argument with a tween: take it out of the tree
	-- and put ours in instead.
	local existing = Lighting:FindFirstChildOfClass("Atmosphere")
	if existing and existing.Name ~= "RKAtmos" then
		Sky.gameAtmos = existing
		pcall(function() existing.Parent = nil end)
	end
	if not (Sky.atmos and Sky.atmos.Parent) then
		Sky.atmos = make("Atmosphere", { Name = "RKAtmos" }, Lighting)
	end
	-- Fullbright outranks the preset, here as everywhere else. An Atmosphere
	-- makes the engine ignore Lighting fog outright, so leaving haze, density
	-- and decay in place is what kept the far half of the map dark no matter
	-- what FULLBRIGHT wrote into FogEnd.
	pcall(function()
		Sky.atmos.Density = Sky.fullbright and 0 or spec.density
		Sky.atmos.Offset = spec.offset
		Sky.atmos.Haze = Sky.fullbright and 0 or spec.haze
		Sky.atmos.Glare = Sky.fullbright and 0 or spec.glare
		Sky.atmos.Color = spec.colour
		Sky.atmos.Decay = Sky.fullbright and Color3.fromRGB(255, 255, 255) or spec.decay
	end)

	if not (Sky.cc and Sky.cc.Parent) then
		Sky.cc = make("ColorCorrectionEffect", { Name = "RKGrade" }, Lighting)
	end
	pcall(function()
		Sky.cc.Enabled = not Sky.fullbright
		Sky.cc.TintColor = spec.tint
		Sky.cc.Brightness = spec.brightness
		Sky.cc.Contrast = spec.contrast
		Sky.cc.Saturation = spec.sat
	end)
end

function Sky.set(name)
	Sky.preset = name
	local look = SKY_LOOKS[name] or (SKY_ANIMATED[name] and Sky.clubLook())
	if not look then
		Sky.clearWeather()
		if Sky.fullbright then return end
		Sky.on = false
		Sky.restore()
		if Sky.conn then Sky.conn:Disconnect() Sky.conn = nil end
		return
	end
	Sky.capture()
	Sky.on = true
	if not Sky.fullbright then Sky.write(look) end
	Sky.weather(name)
	Sky.startLoop()
	-- after Sky.weather, so the atmosphere it installs is in the tree by
	-- the time the report reads it. Composing this any earlier is how the
	-- old note came to describe a state that did not exist yet.
	if Sky.WEATHER[name] and Sky.WEATHER[name].clouds then
		if Sky.cloudNote then
			notify(Sky.cloudNote, 5)
		else
			notify(Sky.cloudReport(), 6)
		end
	end
end

-- ============================= screen stretch =============================
-- A deliberately non-orthonormal camera matrix: scaling the up vector
-- squeezes the vertical field of view without letterboxing, which makes
-- distant things bigger. It has to be written after the game's own camera
-- pass, which is what the render priority is for.

local Stretch = { on = false, amount = 36 }

function Stretch.apply()
	local c = cam()
	if not c or not Stretch.on then return end
	local f = 1 - (Stretch.amount / 100) * 0.7
	if f <= 0.05 then f = 0.05 end
	c.CFrame = c.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, f, 0, 0, 0, 1)
end

function Stretch.set(on)
	Stretch.on = on
	if on and not Stretch.conn then
		local ok = pcall(function()
			RunService:BindToRenderStep("RKStretch", Enum.RenderPriority.Camera.Value + 5, Stretch.apply)
		end)
		if ok then
			Stretch.conn = "bound"
		else
			Stretch.conn = RunService.RenderStepped:Connect(Stretch.apply)
		end
		addCleanup("stretch", function() Stretch.set(false) end)
	elseif not on and Stretch.conn then
		if Stretch.conn == "bound" then
			pcall(function() RunService:UnbindFromRenderStep("RKStretch") end)
		else
			Stretch.conn:Disconnect()
		end
		Stretch.conn = nil
	end
end

-- =============================== spinbot ===============================
-- Spins your character on the spot. Everyone else sees you turning; your own
-- camera is untouched, so it does not make you dizzy to play with.

local Spin = { on = false, speed = 20, angle = 0 }

function Spin.set(on)
	Spin.on = on
	if not on then
		if Spin.conn then Spin.conn:Disconnect() Spin.conn = nil end
		return
	end
	if Spin.conn then return end
	Spin.conn = RunService.Heartbeat:Connect(function(dt)
		if not Spin.on then return end
		local hrp = getHRP()
		if not hrp then return end
		Spin.angle = (Spin.angle + dt * Spin.speed) % (math.pi * 2)
		local pos = hrp.CFrame.Position
		hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, Spin.angle, 0)
	end)
	addCleanup("spin", function() Spin.set(false) end)
end

local Face = { on = false, range = 250 }

function Face.set(on)
	Face.on = on
	if not on then
		if Face.conn then Face.conn:Disconnect() Face.conn = nil end
		return
	end
	if Face.conn then return end
	Face.conn = RunService.RenderStepped:Connect(function()
		if not Face.on then return end
		-- Spinbot turns you on purpose and Freecam owns the view; either one
		-- running means this one stands down rather than argues
		if Spin.on or (Free and Free.on) then return end
		local hrp = getHRP()
		local r = rake()
		local target = r and r:FindFirstChild("HumanoidRootPart")
		if not (hrp and target) then return end
		local at = target.Position
		if (at - hrp.Position).Magnitude > Face.range then return end
		-- Y locked to his height rather than yours, or you tip forward and
		-- the whole rig follows the tilt
		local flat = Vector3.new(at.X, hrp.Position.Y, at.Z)
		if (flat - hrp.Position).Magnitude < 0.1 then return end
		pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, flat) end)
	end)
	addCleanup("face", function() Face.set(false) end)
end


-- =============================== auto farm ===============================
-- Walks the round for you: collects scrap, or holds shelter, and gets away
-- from the Rake whichever of those it was doing.
--
-- WHERE THE TARGETS COME FROM, and why not from SValues.
-- ReplicatedStorage.SValues is a folder of 23 ObjectValues named
-- ItemSpawn1..23, which looks exactly like a live "is there scrap on that
-- spawn" list. It is not one, and the dump refutes it inside a single file:
-- everything.txt:12821 lists all 23 SValues as nil, while the SAME dump at
-- 11212 shows six spawns physically holding scrap (ItemSpawn7 Scrap1, 14
-- Scrap4, 16 Scrap5, 2 Scrap5, 17 Scrap4, 18 Scrap2). Were it the live list
-- those six would be set. Either it is written server side and the
-- references never replicate to us - an ObjectValue pointing at something
-- this client cannot see reads nil - or it tracks something else entirely.
-- Reading it would report an empty map forever.
--
-- So the source is Workspace.Filter.ScrapSpawns, and it is cheap: 23 fixed
-- anchored parts, with a live scrap parented DIRECTLY to the spawn part
-- (everything.txt:11218 shows "[Part] ItemSpawn7" then "[Model] Scrap1").
-- That is about 25 instance reads per retarget, at 0.15 s - not a Workspace
-- walk, and nothing like one per frame.
--
-- The readout still counts the non-nil SValues. If this call is ever wrong
-- on a live server you will see the count climb instead of the feature
-- quietly mis-targeting.
--
-- HOW IT PICKS THINGS UP: by touching them. Every scrap union in the dump
-- carries a TouchTransmitter named TouchInterest and there is NOT ONE
-- ProximityPrompt anywhere under ScrapSpawns (0 across 11212-11305, against
-- 15 elsewhere in the file). A TouchTransmitter only exists because
-- something connected .Touched, so pickup is a server side Touched handler.
-- Walking onto it is the whole mechanism. No remote is involved and
-- ScrapEvent is never fired - its argument shape is not known.

local Farm = {
	on = false,
	speed = 26,       -- WalkSpeed, straight. 0 means hold still.
	priority = "Scrap",

	-- The absolute. Numbers with a reason: the Rake's Humanoid "Monster"
	-- walks at 9 (everything.txt:11399) and you walk at 11 (numbers.txt), so
	-- you already out-pace him by two studs a second at stock speed. Fleeing
	-- here is about holding a heading, not about winning a race - which is
	-- what lets this be an absolute rather than a hope.
	fleeAt = 90,      -- Scrap: inside this, nothing else happens
	avoidAt = 150,    -- Survival: the wider ring, and the user's number
	clearBand = 50,   -- how far past the trigger he has to get before it
	                  -- resumes. A margin ABOVE whatever the trigger came out
	                  -- to, so the two can never cross whatever the multipliers
	                  -- do, which is what stops it chattering on the boundary
	chaseMult = 2,    -- he is on YOU specifically
	bloodMult = 1.75, -- Blood Hour
	fleeStep = 60,    -- how far ahead a flee waypoint is placed

	trapClear = 14,   -- studs of clearance a path needs from any trap HitBox
	touchDist = 6,    -- close enough to call the touch in
	canJump = true,   -- let the navmesh route over things as well as round
	holdRadius = 18,  -- close enough to shelter to stop walking

	showPath = true, markRakeOn = true, dots = nil, lines = nil, marks = nil,
	committed = nil, committedName = nil, committedAt = 0,
	state = "off", why = "", fleeing = false,
	target = nil, targetName = "", targetPts = 0,
	goal = nil, dest = nil, blocked = false, touching = false,
	seen = 0, vetoed = 0, pushExtra = 0,
	svNonNil = 0, svTotal = 0,
	lastPick = 0, traps = {}, banned = {},
	stuck = 0, sampleAt = nil, samplePos = nil,
	dodgeUntil = 0, dodgeGoal = nil,
	conn = nil,
	rk = { part = nil, dist = math.huge, real = math.huge,
		chasing = false, active = false, blood = false, why = "" },
}

Farm.PRIORITIES = { "Scrap", "Survival" }
Farm.PICK_GAP = 0.15

-- Closest approach of the segment a..b to p. This is the test that makes the
-- Rake rule an absolute in BOTH modes without a special case: a scrap is not
-- rejected for being near him, it is rejected because the straight line you
-- would walk to reach it passes near him.
local function segDist(a, b, p)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < 1e-4 then return (p - a).Magnitude end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return (p - (a + ab * t)).Magnitude
end

-- The map centre and a leash, both derived from the dumped LOCATIONS rather
-- than picked. The scrap spawns span X -427..81 and Z -352..298, which is
-- under 390 studs from this centre, so 500 contains the map with room and
-- still stops a flee heading marching into Filter.InvisibleWalls.
local MAP_MID, MAP_LEASH
local MAP_LO, MAP_HI
do
	local sum, n = Vector3.zero, 0
	for _, loc in ipairs(LOCATIONS) do
		sum, n = sum + loc.pos, n + 1
	end
	MAP_MID = n > 0 and (sum / n) or Vector3.zero
	MAP_LEASH = 500
end

-- The actual plate the map sits on, rather than a circle drawn around the
-- average of four typed-in coordinates. Read once, and only used if it is
-- really there.
local function mapBounds()
	if MAP_LO then return MAP_LO, MAP_HI end
	local filter = Workspace:FindFirstChild("Filter")
	local plate = filter and filter:FindFirstChild("MapArea")
	if plate and plate:IsA("BasePart") then
		local half = plate.Size * 0.5
		-- pulled in a little: the very edge of the plate is where the
		-- invisible walls are, and walking at a wall is the thing being fixed
		MAP_LO = plate.Position - half + Vector3.new(30, 0, 30)
		MAP_HI = plate.Position + half - Vector3.new(30, 0, 30)
	end
	return MAP_LO, MAP_HI
end

-- Inside the plate, or inside the leash if this place has no plate.
local function inMap(pos)
	local lo, hi = mapBounds()
	if lo then
		return pos.X > lo.X and pos.X < hi.X and pos.Z > lo.Z and pos.Z < hi.Z
	end
	return (pos - MAP_MID).Magnitude <= MAP_LEASH
end

-- Nearest point that IS inside, so a goal off the edge becomes the closest
-- reachable point rather than a walk into a wall.
local function clampToMap(pos)
	local lo, hi = mapBounds()
	if not lo then return pos end
	return Vector3.new(
		math.clamp(pos.X, lo.X, hi.X), pos.Y, math.clamp(pos.Z, lo.Z, hi.Z))
end

-- Reads his state into Farm.rk. Inactive and Dead both mean "not hunting",
-- and the way that is expressed is dist = huge, so every downstream test
-- treats him as absent without any of them needing to know why.
function Farm.readRake()
	local info = Farm.rk
	info.part, info.dist, info.real = nil, math.huge, math.huge
	info.chasing, info.active, info.blood, info.why = false, false, false, ""

	local r = rake()
	if not r then
		info.why = "no Rake in the workspace"
		return info
	end
	local part = r:FindFirstChild("HumanoidRootPart")
	if not part then
		info.why = "the Rake has no root part yet"
		return info
	end
	info.part = part

	local me = myPos()
	info.real = me and (part.Position - me).Magnitude or math.huge

	local blood = r:FindFirstChild("BloodHourMode")
	info.blood = blood ~= nil and blood.Value == true

	local dead = r:FindFirstChild("Dead")
	local inact = r:FindFirstChild("Inactive")
	if dead and dead.Value == true then
		info.why = "he is dead"
		return info
	end
	if inact and inact.Value == true then
		info.why = "he is inactive"
		return info
	end

	info.active = true
	info.dist = info.real

	-- TargetVal holds a HumanoidRootPart, NOT the character Model - the dump
	-- is explicit (everything.txt:11405 "[ObjectValue] TargetVal =
	-- HumanoidRootPart") and Ex.hideSlab's comment says the same. Comparing
	-- it against LocalPlayer.Character would therefore never be true and the
	-- chase multiplier would never fire. IsDescendantOf covers the part it
	-- actually holds, and the == covers it if the game ever stores the Model.
	local tv = r:FindFirstChild("TargetVal")
	local char = LocalPlayer.Character
	if tv and tv.Value and char then
		info.chasing = (tv.Value == char) or tv.Value:IsDescendantOf(char)
	end
	return info
end

-- Survival is the mode whose whole job is not dying, so it keeps a wider ring
-- than Scrap does - the user's number, 150 - and the clear distance is a fixed
-- margin above whatever the trigger works out to, so the two can never cross
-- and leave it flipping in and out of fleeing on the boundary.
function Farm.fleeRadius(info)
	local r = (Farm.priority == "Survival") and Farm.avoidAt or Farm.fleeAt
	if info.chasing then r = r * Farm.chaseMult end
	if info.blood then r = r * Farm.bloodMult end
	return r
end

function Farm.clearRadius(info)
	return Farm.fleeRadius(info) + Farm.clearBand
end

-- Positive identification AND the file's own trap test, both required. A
-- rusty trap is a reskin of the shop trap and spawns on these same spawns,
-- so a scrap has to look like scrap (PointsVal, LevelVal, a Scrap part) and
-- must not look like a trap (looksLikeTrap: a HitBox with an Open or Close).
-- Anything that fails either way is skipped: the worst case is missed
-- points, never a walk into a bear trap.
function Farm.isRealScrap(m)
	if not m:IsA("Model") then return false end
	if looksLikeTrap(m) then return false end
	-- a spawn outside the plate is not somewhere to walk to, whatever is
	-- sitting on it
	local ok, at = pcall(function() return m:GetPivot().Position end)
	if ok and not inMap(at) then return false end
	if not m:FindFirstChild("PointsVal") then return false end
	if not m:FindFirstChild("LevelVal") then return false end
	local part = m:FindFirstChild("Scrap")
	if not (part and part:IsA("BasePart")) then return false end
	return true, part
end

function Farm.scraps()
	local out = {}
	local spawns = pathTo(Workspace, "Filter", "ScrapSpawns")
	if not spawns then return out end
	for _, spawn in ipairs(spawns:GetChildren()) do
		for _, m in ipairs(spawn:GetChildren()) do
			local ok, part = Farm.isRealScrap(m)
			if ok then
				local pv = m:FindFirstChild("PointsVal")
				out[#out + 1] = {
					model = m, part = part, pos = part.Position,
					pts = (pv and tonumber(pv.Value)) or 0,
					name = m.Name,
				}
			end
		end
	end
	return out
end

function Farm.svCount()
	local n, total = 0, 0
	local sv = ReplicatedStorage:FindFirstChild("SValues")
	if sv then
		for _, v in ipairs(sv:GetChildren()) do
			if v:IsA("ObjectValue") then
				total = total + 1
				if v.Value ~= nil then n = n + 1 end
			end
		end
	end
	Farm.svNonNil, Farm.svTotal = n, total
end

-- Traps are not only on the scrap spawns; trapModels() also covers
-- Workspace.Debris.Traps. Cached per retarget rather than per frame.
function Farm.pathHasTrap(a, b)
	for _, m in ipairs(Farm.traps) do
		local hb = m:FindFirstChild("HitBox")
		if hb and hb:IsA("BasePart") and segDist(a, b, hb.Position) < Farm.trapClear then
			return true
		end
	end
	return false
end

function Farm.pruneBans()
	local now = os.clock()
	for m, until_ in pairs(Farm.banned) do
		if until_ <= now or not m.Parent then Farm.banned[m] = nil end
	end
end

function Farm.pickScrap(me, info, radius)
	Farm.pruneBans()
	local best, bestScore = nil, -math.huge
	local seen, vetoed = 0, 0
	for _, s in ipairs(Farm.scraps()) do
		seen = seen + 1
		local blocked = Farm.banned[s.model] ~= nil
		if not blocked and info.active and info.part
			and segDist(me, s.pos, info.part.Position) < radius then
			blocked = true
		end
		if not blocked and Farm.pathHasTrap(me, s.pos) then blocked = true end
		if blocked then
			vetoed = vetoed + 1
		else
			-- a point is worth about a stud and a half of walking, so a
			-- Scrap5 at 27 points beats a Scrap1 at 12 from twenty studs
			-- further out, and nothing beats being close
			local score = -(s.pos - me).Magnitude + s.pts * 1.5
			if score > bestScore then best, bestScore = s, score end
		end
	end
	Farm.seen, Farm.vetoed = seen, vetoed
	return best
end

-- Sixteen compass headings scored on the distance they put between you and
-- him. A heading that CLOSES on him is pushed far down rather than merely
-- scoring low, so it can only ever be chosen if you are literally surrounded.
-- This is also the answer to "the scrap and the Rake are the same way": the
-- flee heading simply never points at him, so that scrap is not collected
-- now - it stays on its spawn and gets collected once he has moved.
-- A heading that did not move you is a wall. Remembered for a few seconds so
-- the next-best is tried, rather than the same wall being chosen again every
-- tick because it still scores highest on distance.
Farm.DEST_RETIRE = 12   -- seconds a landmark stays retired after failing
Farm.COMMIT = 6         -- seconds a chosen destination is stuck with

-- Hold the choice. Anything that re-picks a destination every tick from a
-- distance score will walk to the midpoint of two options and stay there.
function Farm.commitTo(pos, name)
	Farm.committed, Farm.committedName = pos, name
	Farm.committedAt = os.clock()
end

function Farm.heldDest(fleeing)
	if not Farm.committed then return nil end
	if fleeing then return nil end
	if os.clock() - (Farm.committedAt or 0) > Farm.COMMIT then return nil end
	if Farm.destRetired(Farm.committed) then return nil end
	return Farm.committed, Farm.committedName
end

Farm.NO_GO = { "SafeHouse", "PowerStation", "ObservationTower" }
Farm.standoff = 10   -- studs to stop short of a building's face

-- One axis-aligned box per named building, measured off its own parts and
-- kept, because walking every descendant of the map every frame is not free.
function Farm.noGoBoxes()
	if Farm.boxes and os.clock() - (Farm.boxesAt or 0) < 30 then return Farm.boxes end
	Farm.boxes, Farm.boxesAt = {}, os.clock()
	local map = Workspace:FindFirstChild("Map")
	if not map then return Farm.boxes end
	for _, name in ipairs(Farm.NO_GO) do
		local holder = map:FindFirstChild(name)
		if holder then
			local lo, hi
			for _, d in ipairs(holder:GetDescendants()) do
				if d:IsA("BasePart") and d.Size.Magnitude < 400 then
					local p = d.Position
					if not lo then
						lo, hi = p, p
					else
						lo = Vector3.new(math.min(lo.X, p.X), math.min(lo.Y, p.Y), math.min(lo.Z, p.Z))
						hi = Vector3.new(math.max(hi.X, p.X), math.max(hi.Y, p.Y), math.max(hi.Z, p.Z))
					end
				end
			end
			if lo and (hi - lo).Magnitude > 8 then
				Farm.boxes[#Farm.boxes + 1] = { name = name, lo = lo, hi = hi }
			end
		end
	end
	return Farm.boxes
end

-- Flat test: height is ignored on purpose, because standing on the roof is
-- just as stuck as standing in the hall.
-- A building is bigger than the extremes of its parts: the roof overhangs and
-- the porch sticks out, and a standoff measured from the bare box still puts
-- you under cover. Everything asking "am I inside" gets that margin.
Farm.boxPad = 6

function Farm.insideNoGo(pos, pad)
	pad = (pad or 0) + Farm.boxPad
	for _, b in ipairs(Farm.noGoBoxes()) do
		if pos.X > b.lo.X - pad and pos.X < b.hi.X + pad
			and pos.Z > b.lo.Z - pad and pos.Z < b.hi.Z + pad then
			return b
		end
	end
	return nil
end

-- The nearest spot OUTSIDE a building, on the side you are approaching from.
function Farm.outsideOf(b, from, pad)
	local cx = (b.lo.X + b.hi.X) * 0.5
	local cz = (b.lo.Z + b.hi.Z) * 0.5
	local dx, dz = from.X - cx, from.Z - cz
	-- push out along whichever axis you are already furthest along, so it
	-- leaves by the nearest face rather than cutting a corner
	local halfX = (b.hi.X - b.lo.X) * 0.5 + pad
	local halfZ = (b.hi.Z - b.lo.Z) * 0.5 + pad
	if math.abs(dx) / math.max(halfX, 0.1) > math.abs(dz) / math.max(halfZ, 0.1) then
		return Vector3.new(cx + (dx >= 0 and halfX or -halfX), from.Y, from.Z)
	end
	return Vector3.new(from.X, from.Y, cz + (dz >= 0 and halfZ or -halfZ))
end

function Farm.retireDest(pos, why)
	if not pos then return end
	Farm.deadDests = Farm.deadDests or {}
	for _, d in ipairs(Farm.deadDests) do
		if (d.pos - pos).Magnitude < 8 then
			d.until_ = os.clock() + Farm.DEST_RETIRE
			return
		end
	end
	Farm.deadDests[#Farm.deadDests + 1] = { pos = pos, until_ = os.clock() + Farm.DEST_RETIRE }
	notify("cannot reach " .. (Farm.targetName ~= "" and Farm.targetName or "that spot")
		.. " - " .. (why or "stuck") .. ", trying elsewhere", 5)
end

function Farm.destRetired(pos)
	if not Farm.deadDests then return false end
	local now = os.clock()
	for i = #Farm.deadDests, 1, -1 do
		local d = Farm.deadDests[i]
		if now > d.until_ then
			table.remove(Farm.deadDests, i)
		elseif (d.pos - pos).Magnitude < 8 then
			return true
		end
	end
	return false
end

-- The shelter to head for: nearest that is not retired and, when he is
-- hunting, not one he is standing on.
-- Where the landmarks actually ARE.
--
-- LOCATIONS is four coordinates carried over from a previous build - where
-- somebody once stood, not where the building is. The buildings are in the
-- world and can be measured: the centre of each no-go box IS the landmark,
-- and it is right by construction rather than right by luck.
--
-- Anything without a matching building keeps its typed coordinate, clamped
-- into the map plate so it can never be a point off the edge.
function Farm.landmarks()
	if Farm.marksList and os.clock() - (Farm.marksAt or 0) < 30 then return Farm.marksList end
	Farm.marksList, Farm.marksAt = {}, os.clock()
	local seen = {}
	for _, b in ipairs(Farm.noGoBoxes()) do
		local mid = (b.lo + b.hi) * 0.5
		Farm.marksList[#Farm.marksList + 1] = { name = b.name, pos = clampToMap(mid), box = b }
		seen[b.name] = true
	end
	for _, loc in ipairs(LOCATIONS) do
		-- a typed name that matches a measured building is the same place
		local dup = false
		for _, m in ipairs(Farm.marksList) do
			if (m.pos - loc.pos).Magnitude < 60 then dup = true break end
		end
		if not dup then
			Farm.marksList[#Farm.marksList + 1] = { name = loc.name, pos = clampToMap(loc.pos) }
		end
	end
	return Farm.marksList
end

function Farm.shelter(me, info, radius)
	local best, bestName, bestScore = nil, nil, -math.huge
	for _, loc in ipairs(Farm.landmarks()) do
		if not Farm.destRetired(loc.pos) and inMap(loc.pos) then
			local score = -(loc.pos - me).Magnitude
			if info.active and info.part then
				local fromHim = (loc.pos - info.part.Position).Magnitude
				if fromHim < radius then
					score = score - 1000
				else
					score = score + fromHim * 0.5
				end
			end
			if score > bestScore then best, bestName, bestScore = loc.pos, loc.name, score end
		end
	end
	return best, bestName
end

function Farm.blameHeading(me)
	local g = Farm.goal
	if not g then return end
	local flat = Vector3.new(g.X - me.X, 0, g.Z - me.Z)
	if flat.Magnitude < 1 then return end
	Farm.deadEnds = Farm.deadEnds or {}
	Farm.deadEnds[#Farm.deadEnds + 1] = { dir = flat.Unit, until_ = os.clock() + 4 }
	if #Farm.deadEnds > 8 then table.remove(Farm.deadEnds, 1) end
end

function Farm.deadEndPenalty(me, goal)
	if not Farm.deadEnds then return 0 end
	local flat = Vector3.new(goal.X - me.X, 0, goal.Z - me.Z)
	if flat.Magnitude < 1 then return 0 end
	local dir, now, pen = flat.Unit, os.clock(), 0
	for i = #Farm.deadEnds, 1, -1 do
		local d = Farm.deadEnds[i]
		if now > d.until_ then
			table.remove(Farm.deadEnds, i)
		elseif dir:Dot(d.dir) > 0.8 then
			-- within about 35 degrees of something that did not work
			pen = pen - 600
		end
	end
	return pen
end

function Farm.fleeGoal(me, rakePos)
	local house = LOCATIONS[1] and LOCATIONS[1].pos
	local hereDist = (me - rakePos).Magnitude
	local best, bestScore = nil, -math.huge
	for i = 0, 15 do
		local a = (i / 16) * math.pi * 2
		local goal = me + Vector3.new(math.cos(a), 0, math.sin(a)) * Farm.fleeStep
		local score = (goal - rakePos).Magnitude
		if score < hereDist then score = score - 1000 end
		if Farm.pathHasTrap(me, goal) then score = score - 500 end
		score = score + Farm.deadEndPenalty(me, goal)
		if not inMap(goal) then score = score - 750 end
		if house then
			-- a tie-break toward the one place the game itself models as
			-- shelter. Capped at about 21 against a score in the hundreds,
			-- so it can never outvote getting away from him.
			local closes = (me - house).Magnitude - (goal - house).Magnitude
			score = score + math.clamp(closes, -Farm.fleeStep, Farm.fleeStep) * 0.35
		end
		if score > bestScore then best, bestScore = goal, score end
	end
	return best or (me + (me - rakePos).Unit * Farm.fleeStep)
end

-- ------------------------------ the navigator ------------------------------
-- Straight-line MoveTo is what walked into trees. Humanoid:MoveTo steers at a
-- heading and knows nothing about what is in the way, so anything between you
-- and the target is something you grind against until the stuck detector
-- gives up. PathfindingService walks the navmesh instead, and it is the whole
-- of "make it smarter".
--
-- ComputeAsync YIELDS, so it can never be called from the Heartbeat
-- connection - it runs in its own thread behind Farm.computing, which is
-- cleared on every path out of that thread including the failure ones.
--
-- The trap veto moved with it. It used to test one straight line and refuse
-- the whole order when no side-step was clear, which is why Survival "just
-- stands in place": one rusty trap anywhere near the line home froze you on
-- the spot. Now each WAYPOINT is tested, a blocked one is walked around, and
-- a path that cannot be cleaned is retried from a different angle rather than
-- abandoned.
Farm.SIDESTEPS = { 18, -18, 32, -32, 46, -46 }
Farm.REPATH = 1.2          -- seconds between recomputes while walking
Farm.WAYPOINT_HIT = 5      -- studs that count as reaching a waypoint

function Farm.clearPoint(me, wp)
	-- a building interior is refused for the same reason a trap is: it is
	-- somewhere this cannot get back out of on its own
	local box = Farm.insideNoGo(wp, 0)
	if box then
		-- pushed out from the WAYPOINT, not from me: using my position sent
		-- the detour back toward myself whenever the building sat between us
		local out = Farm.outsideOf(box, wp, Farm.standoff)
		if not Farm.pathHasTrap(me, out) then return out end
		return nil
	end
	if not Farm.pathHasTrap(me, wp) then return wp end
	local flat = Vector3.new(wp.X - me.X, 0, wp.Z - me.Z)
	if flat.Magnitude < 1 then return nil end
	local fwd = flat.Unit
	local side = Vector3.new(-fwd.Z, 0, fwd.X)
	for _, off in ipairs(Farm.SIDESTEPS) do
		local try = wp + side * off
		if not Farm.pathHasTrap(me, try) then return try end
	end
	return nil
end

function Farm.dropPath()
	Farm.path, Farm.points, Farm.point = nil, nil, 1
	if Farm.blockConn then Farm.blockConn:Disconnect() Farm.blockConn = nil end
end

-- One compute at a time, in its own thread, and the result is only kept if
-- the destination it was computed for is still the one we want.
function Farm.repath(from, to)
	if Farm.computing then return end
	Farm.computing = true
	local want = to
	task.spawn(function()
		local ok, points = pcall(function()
			local ps = game:GetService("PathfindingService")
			local path = ps:CreatePath({
				-- an R6 rig is 2 wide and 5 tall; a little margin either way
				-- keeps it off doorframes without refusing real gaps
				-- 2.5 planned routes through gaps the rig does not fit, which
				-- is how it wedged between trees. Wider than the character on
				-- purpose: a route it cannot walk is worse than a longer one.
				AgentRadius = 4,
				AgentHeight = 6,
				AgentCanJump = Farm.canJump ~= false,
				WaypointSpacing = 6,
			})
			path:ComputeAsync(from, want)
			if path.Status ~= Enum.PathStatus.Success then return nil end
			local list = path:GetWaypoints()
			-- hold the object only long enough to hear it break
			Farm.dropPath()
			Farm.path = path
			Farm.blockConn = path.Blocked:Connect(function()
				Farm.repathAt = 0
			end)
			return list
		end)
		if ok and points and #points > 1 and Farm.dest == want then
			Farm.points, Farm.point = points, 2
			Farm.pathFail = 0
		else
			Farm.pathFail = (Farm.pathFail or 0) + 1
			Farm.points, Farm.point = nil, 1
		end
		Farm.computing = false
	end)
end

-- mustMove is fleeing, and only fleeing: standing still while he is inside
-- the ring is worse than any trap, so that case walks the penalised heading
-- knowingly. fleeGoal has already pushed trapped headings down.
function Farm.walkTo(goal, mustMove)
	local hum, hrp = getHum(), getHRP()
	if not (hum and hrp and goal) then return end
	-- the last word on every destination, wherever it came from. A goal off
	-- the plate is a walk at the invisible walls, and the scrap scorer, the
	-- flee scorer and the shelter picker can all produce one.
	goal = clampToMap(goal)
	local me = hrp.Position

	if Farm.dest ~= goal then
		Farm.dest = goal
		Farm.dropPath()
		Farm.repathAt = 0
	end

	local now = os.clock()
	if now - (Farm.repathAt or 0) >= Farm.REPATH then
		Farm.repathAt = now
		Farm.repath(me, goal)
	end

	-- No usable path yet, or three failures in a row: steer straight at it
	-- rather than stand there. A straight line is what this used to be, so
	-- the worst case is the old behaviour and not a frozen character.
	if not Farm.points then
		-- six computes refused in a row is the navmesh saying there is no
		-- route, not a slow frame. Retire it and let think() pick another.
		if (Farm.pathFail or 0) >= 6 and Farm.priority == "Survival" then
			Farm.retireDest(goal, "no route to it")
			Farm.pathFail = 0
		end
		Farm.blocked = (Farm.pathFail or 0) >= 3
		Farm.goal = goal
		local step = Farm.clearPoint(me, goal)
		pcall(function() hum:MoveTo(step or goal) end)
		return
	end

	-- walk the waypoints in order, skipping the ones already behind us
	while Farm.point <= #Farm.points do
		local wp = Farm.points[Farm.point]
		if (Vector3.new(wp.Position.X, me.Y, wp.Position.Z) - me).Magnitude > Farm.WAYPOINT_HIT then
			break
		end
		if wp.Action == Enum.PathWaypointAction.Jump then pcall(function() hum.Jump = true end) end
		Farm.point = Farm.point + 1
	end
	if Farm.point > #Farm.points then
		-- arrived at the end of the path; let the next tick decide what next
		Farm.dropPath()
		Farm.repathAt = 0
		Farm.blocked = false
		Farm.goal = goal
		pcall(function() hum:MoveTo(goal) end)
		return
	end

	local wp = Farm.points[Farm.point]
	local step = Farm.clearPoint(me, wp.Position)
	if not step then
		-- a trap sits on this waypoint and every way round it. Do not freeze:
		-- drop the path and let the next compute find another line.
		Farm.blocked = true
		Farm.dropPath()
		Farm.repathAt = 0
		if mustMove then pcall(function() hum:MoveTo(goal) end) end
		return
	end
	Farm.blocked = false
	Farm.goal = step
	if wp.Action == Enum.PathWaypointAction.Jump then pcall(function() hum.Jump = true end) end
	pcall(function() hum:MoveTo(step) end)
end

-- Cancels the standing walk order. OnUnload sets Farm.on = false directly and
-- never calls the setter, so this is registered as its own addCleanup entry:
-- without it the humanoid keeps the last MoveTo and you walk off on your own
-- after the menu is gone.
function Farm.stopWalking()
	Farm.goal, Farm.dest, Farm.blocked = nil, nil, false
	Farm.dropPath()
	Farm.repathAt, Farm.pathFail = 0, 0
	local hum, hrp = getHum(), getHRP()
	if hum and hrp then pcall(function() hum:MoveTo(hrp.Position) end) end
end

-- The touch closer. Not a remote and not a guess: the TouchTransmitter is in
-- the dump on every scrap union, and this is the same call Ex.grabFlare
-- already makes against the same kind of object. Walking onto it works
-- without this; this only stops you orbiting a scrap you are standing on.
function Farm.touch(part)
	local hrp = getHRP()
	if not (hrp and part) then return end
	if typeof(firetouchinterest) ~= "function" then return end
	-- Ex.grabFlare waits a frame between the two and that is the proven idiom
	-- here, so match it rather than firing back to back - and task.spawn means
	-- the Heartbeat connection is never the thing yielding. The guard stops a
	-- second pair starting while the first is still mid-frame, which at a
	-- 0.15 s retarget is otherwise about seven touch pairs a second on a
	-- scoring object.
	if Farm.touching then return end
	Farm.touching = true
	task.spawn(function()
		pcall(function()
			firetouchinterest(hrp, part, 0)
			task.wait()
			firetouchinterest(hrp, part, 1)
		end)
		Farm.touching = false
	end)
end

-- MoveTo has no pathfinding, so it will hold you against a rock forever.
-- Sampled on its own half second clock: no progress three times running
-- earns a side step, six earns a twelve second ban on that target.
function Farm.trackStuck(me)
	local now = os.clock()
	if not Farm.sampleAt then
		Farm.sampleAt, Farm.samplePos = now, me
		return
	end
	if now - Farm.sampleAt < 0.5 then return end
	local moved = (me - Farm.samplePos).Magnitude
	Farm.sampleAt, Farm.samplePos = now, me
	if Farm.goal and moved < 2 then
		Farm.stuck = Farm.stuck + 1
	else
		Farm.stuck = 0
	end
	if Farm.stuck == 2 and Farm.goal then
		-- whatever we were walking at is a wall; do not pick it again
		Farm.blameHeading(me)
		Farm.dropPath()
		Farm.repathAt = 0
		-- and hop, because half of being wedged on scenery is a lip the rig
		-- would clear if anything asked it to
		local hum = getHum()
		if hum then pcall(function() hum.Jump = true end) end
	end
	if Farm.stuck == 3 and Farm.goal then
		local d = Farm.goal - me
		local flat = Vector3.new(d.X, 0, d.Z)
		if flat.Magnitude > 0.1 then
			local side = Vector3.new(-flat.Unit.Z, 0, flat.Unit.X) * 18
			Farm.dodgeGoal, Farm.dodgeUntil = me + side, now + 1.2
		end
	elseif Farm.stuck >= 6 then
		if Farm.target and Farm.target.model then
			Farm.banned[Farm.target.model] = now + 12
		end
		Farm.target, Farm.stuck = nil, 0
	end
end

function Farm.think(me)
	local info = Farm.readRake()
	Farm.traps = trapModels()
	Farm.svCount()
	Farm.trackStuck(me)

	local radius = Farm.fleeRadius(info)
	-- a fixed margin above the trigger, not a ratio of it: a ratio moved with
	-- the chase and Blood Hour multipliers and could land back under the
	-- trigger it is supposed to sit above
	local clear = Farm.clearRadius(info)

	-- Hysteresis, and it is not decoration: with one threshold you sit on the
	-- boundary flipping between fleeing and collecting every tick and go
	-- nowhere. Once fleeing, keep fleeing until he is past the wider ring.
	if info.active then
		if info.dist <= radius then
			Farm.fleeing = true
		elseif info.dist >= clear then
			Farm.fleeing = false
		end
	else
		Farm.fleeing = false
	end

	if Farm.fleeing and info.part then
		Farm.target, Farm.targetName, Farm.targetPts = nil, "", 0
		Farm.state = "fleeing"
		Farm.why = info.chasing and "he is chasing YOU"
			or (info.blood and "Blood Hour, he is inside the ring")
			or "he is inside the flee ring"
		Farm.walkTo(Farm.fleeGoal(me, info.part.Position), true)
		return
	end

	-- a side step out of a corner, still subject to the flee rule above
	if Farm.dodgeGoal and os.clock() < Farm.dodgeUntil then
		Farm.state = "unsticking"
		Farm.why = "no progress for " .. Farm.stuck .. " samples"
		Farm.walkTo(Farm.dodgeGoal)
		return
	end
	Farm.dodgeGoal = nil

	if Farm.priority == "Survival" then
		Farm.target, Farm.targetPts = nil, 0
		local inHere = Farm.insideNoGo(me, 0)
		if inHere then
			Farm.state, Farm.why = "walking", "getting out of " .. inHere.name
			Farm.targetName = "outside " .. inHere.name
			Farm.committed = nil
			-- straight out, NOT pathfound. A path computed from inside a
			-- building routes around its interior, which is how you stay in
			-- it: the way out of geometry is to walk at the nearest face.
			local out = Farm.outsideOf(inHere, me, Farm.standoff + 10)
			Farm.dest, Farm.goal, Farm.blocked = out, out, false
			Farm.dropPath()
			local hum = getHum()
			if hum then
				pcall(function() hum:MoveTo(out) end)
				-- doorways have a lip and the porch has a step
				if Farm.stuck >= 2 then pcall(function() hum.Jump = true end) end
			end
			return
		end
		local goal, name = Farm.shelter(me, info, radius)
		if not goal then
			-- every landmark retired, so let the oldest back in rather than
			-- standing still: being somewhere beats being nowhere
			Farm.deadDests = nil
			goal, name = Farm.shelter(me, info, radius)
		end
		if not goal then
			Farm.state, Farm.why = "idle", "nowhere to shelter"
			Farm.stopWalking()
			return
		end
		-- a choice already made and still valid outranks a fresh score
		local held, heldName = Farm.heldDest(Farm.fleeing)
		if held then
			goal, name = held, heldName
		else
			Farm.commitTo(goal, name)
		end
		Farm.targetName = name or ""
		-- stand OUTSIDE it. The landmark point for the Safe House sits on the
		-- building itself, and a goal inside is a goal the navmesh reaches by
		-- walking you through the door.
		local box = Farm.insideNoGo(goal, 0)
		if box then goal = Farm.outsideOf(box, me, Farm.standoff) end
		Farm.why = info.active and "keeping away, heading for " .. Farm.targetName
			or "holding " .. Farm.targetName

		if (me - goal).Magnitude <= Farm.holdRadius then
			Farm.state = "holding"
			Farm.stuck = 0
			Farm.committed = nil
			Farm.stopWalking()
		else
			Farm.state = "walking"
			-- stuck against the back of a building is the case this exists
			-- for: give up on THAT landmark rather than grinding upward at a
			-- wall until the round ends
			if Farm.stuck >= 4 then
				Farm.retireDest(goal, "cannot get to it from here")
				Farm.stuck = 0
				Farm.committed = nil
				Farm.stopWalking()
				return
			end
			Farm.walkTo(goal)
		end
		return
	end

	-- Scrap. pickScrap runs on every retarget so the readout's counts stay
	-- live, but the target only CHANGES when it has to - gone, vetoed, or
	-- beaten by a clear margin. Taking the raw best every tick oscillates
	-- between two scraps of near equal score and you walk on the spot
	-- between them.
	local best = Farm.pickScrap(me, info, radius)
	local keep = Farm.target
	if keep then
		local still, part = Farm.isRealScrap(keep.model)
		if not (still and keep.model.Parent) then
			keep = nil
		else
			-- re-read rather than trust the cached one: scrap is welded to a
			-- spawn but the model can be re-parented under you
			keep.part, keep.pos = part, part.Position
			local barred = Farm.banned[keep.model] ~= nil
				or (info.active and info.part
					and segDist(me, keep.pos, info.part.Position) < radius)
				or Farm.pathHasTrap(me, keep.pos)
			if barred then
				keep = nil
			elseif best and best.model ~= keep.model then
				local a = -(keep.pos - me).Magnitude + keep.pts * 1.5
				local b = -(best.pos - me).Magnitude + best.pts * 1.5
				if b > a + 25 then keep = nil end
			end
		end
	end
	Farm.target = keep or best

	local tgt = Farm.target
	if not tgt then
		Farm.state = "idle"
		Farm.targetName, Farm.targetPts = "", 0
		Farm.why = Farm.seen == 0 and "no scrap on the map right now"
			or ("all " .. Farm.seen .. " vetoed: too near him, or a trap on the way")
		Farm.stopWalking()
		return
	end

	Farm.targetName, Farm.targetPts = tgt.name, tgt.pts
	if (tgt.pos - me).Magnitude <= Farm.touchDist then
		Farm.state = "collecting"
		Farm.why = "standing on it"
		Farm.touch(tgt.part)
		Farm.walkTo(tgt.pos)
	else
		Farm.state = "walking"
		Farm.why = info.active and string.format("he is %d away", math.floor(info.real))
			or info.why
		Farm.walkTo(tgt.pos)
	end
end

-- Auto Farm's speed is its own slider and its own WalkSpeed write, held with
-- a property-changed guard the same way Move's is.
--
-- It stands down entirely whenever Move.speedOn: two owners of one property
-- is the bug, not the fix. (This block used to describe a PivotTo
-- displacement that deliberately avoided writing WalkSpeed at all - that
-- approach is gone from both features, and the comment outlived it by two
-- builds.)
-- ------------------------------ show the path ------------------------------
-- The waypoints the navigator is actually following, drawn on screen. Worth
-- having because everything else about this feature is invisible: if it walks
-- somewhere strange, this is the difference between "it is broken" and "it
-- thinks the way home goes round the back of the power station".
--
-- Drawing is an executor extension and half of them do not ship it, so
-- newDraw returns nil and every line here is a no-op rather than an error.
-- The toggle says so rather than looking on and doing nothing.
Farm.dots = {}
Farm.lines = {}

function Farm.markRake()
	if not (Farm.on and Farm.markRakeOn) then
		if Farm.rakeGlow then
			pcall(function() Farm.rakeGlow:Destroy() end)
			Farm.rakeGlow = nil
		end
		return
	end
	local r = rake()
	if not r then
		if Farm.rakeGlow then Farm.rakeGlow.Adornee = nil end
		return
	end
	if not (Farm.rakeGlow and Farm.rakeGlow.Parent) then
		Farm.rakeGlow = make("Highlight", {
			Name = "RKFarmRake", FillColor = Color3.fromRGB(255, 60, 60),
			OutlineColor = Color3.fromRGB(255, 190, 190),
			FillTransparency = 0.6, OutlineTransparency = 0,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, Workspace)
	end
	if Farm.rakeGlow.Adornee ~= r then Farm.rakeGlow.Adornee = r end
end
addCleanup("farmrake", function()
	if Farm.rakeGlow then pcall(function() Farm.rakeGlow:Destroy() end) Farm.rakeGlow = nil end
end)

function Farm.hidePath()
	for _, d in ipairs(Farm.dots) do pcall(function() d.Visible = false end) end
	for _, l in ipairs(Farm.lines) do pcall(function() l.Visible = false end) end
	if Farm.marks then pcall(function() Farm.marks.Visible = false end) end
end
addCleanup("farmpath", function() Farm.hidePath() end)

-- Catmull-Rom through four control points. Chosen over a bezier because it
-- passes THROUGH its points: the curve drawn is the route walked, not a
-- smoothed suggestion of it that cuts the corners the navmesh chose.
local function spline(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return (p1 * 2
		+ (-p0 + p2) * t
		+ (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2
		+ (-p0 + p1 * 3 - p2 * 3 + p3) * t3) * 0.5
end

-- Where the floor is under a point. Cheap enough at four subdivisions a leg,
-- and the result is a line that lies on the world instead of hovering over it.
function Farm.onGround(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- Farm owns no parts in the world, so the character is the only thing
	-- worth excluding. (An earlier version also excluded Farm.folder, which
	-- has never existed - a guard on a name that should be there is how a
	-- line ends up doing nothing and looking deliberate.)
	params.FilterDescendantsInstances = { LocalPlayer.Character }
	local hit
	pcall(function()
		hit = Workspace:Raycast(pos + Vector3.new(0, 12, 0), Vector3.new(0, -60, 0), params)
	end)
	return (hit and (hit.Position + Vector3.new(0, 0.35, 0))) or pos
end

-- Where it is heading, from the best source that still knows.
--
-- Farm.dest alone was not enough: stopWalking() nils it, and stopWalking runs
-- on arrival, on holding and on every stand-down - so the line went out at
-- exactly the moments the feature was sitting still, which reads as the line
-- being broken rather than the walking being finished.
function Farm.aimingAt()
	if Farm.dest then return Farm.dest end
	if Farm.committed then return Farm.committed end
	if Farm.target and Farm.target.pos then return Farm.target.pos end
	return nil
end

function Farm.pathPoints()
	local out = {}
	local hrp = getHRP()
	if not hrp then return out end
	out[1] = hrp.Position
	if Farm.points then
		for i = Farm.point, #Farm.points do
			out[#out + 1] = Farm.points[i].Position
		end
	else
		local at = Farm.aimingAt()
		if at then out[#out + 1] = at end
	end
	return out
end

function Farm.drawPath()
	if not (Farm.showPath and HAS_DRAWING) then
		if #Farm.lines > 0 or #Farm.dots > 0 then Farm.hidePath() end
		return
	end
	local raw = Farm.pathPoints()
	if #raw < 2 then Farm.hidePath() return end

	-- subdivide: four segments per leg is enough to read as a curve without
	-- costing a Drawing object per stud
	local pts = {}
	for i = 1, #raw - 1 do
		local p0 = raw[math.max(i - 1, 1)]
		local p1, p2 = raw[i], raw[i + 1]
		local p3 = raw[math.min(i + 2, #raw)]
		for step = 0, 3 do
			pts[#pts + 1] = spline(p0, p1, p2, p3, step / 4)
		end
	end
	pts[#pts + 1] = raw[#raw]

	-- Dropped onto the ground rather than floating at whatever height the
	-- waypoint happened to carry. Waypoint heights step with the navmesh and
	-- your own eye height bobs, so a line drawn from either jitters; the floor
	-- under a point does not move.
	local used, prev, prevOn = 0, nil, false
	for i = 1, #pts do
		local sp, on = project(Farm.onGround(pts[i]))
		if prev and prevOn and sp and on then
			used = used + 1
			local ln = Farm.lines[used]
			if not ln then
				ln = newDraw("Line", { Thickness = 2 })
				if not ln then break end
				Farm.lines[used] = ln
			end
			ln.From, ln.To = prev, sp
			-- brightest at your feet and fading out toward the destination,
			-- so which way it is going is obvious without a marker
			local a = i / #pts
			ln.Color = Color3.fromRGB(120, 255, 140):Lerp(Color3.fromRGB(60, 130, 255), a)
			ln.Transparency = 1 - a * 0.55
			ln.Thickness = 3 - a
			ln.Visible = true
		end
		prev, prevOn = sp, on
	end
	for i = used + 1, #Farm.lines do
		pcall(function() Farm.lines[i].Visible = false end)
	end

	local aim = Farm.aimingAt()
	if aim then
		local at = Farm.onGround(aim)
		local sp, on = project(at)
		local d, t = Farm.dots[1], Farm.marks
		if sp and on then
			if not d then
				d = newDraw("Circle", { Thickness = 2, NumSides = 20, Filled = false })
				Farm.dots[1] = d
			end
			if d then
				-- sized off distance so it reads as a thing standing ON the
				-- ground rather than a circle pasted on the screen
				local me = myPos()
				local far = me and math.max((at - me).Magnitude, 1) or 60
				d.Radius = math.clamp(700 / far, 5, 26)
				d.Position = sp
				d.Color = Color3.fromRGB(255, 210, 90)
				d.Transparency, d.Visible = 1, true
			end
			-- a short pin up from the ring, so the marker has a position in
			-- the world instead of just a place on screen
			local top = Farm.dots[2]
			local spTop, topOn = project(at + Vector3.new(0, 4, 0))
			if spTop and topOn then
				if not top then
					top = newDraw("Line", { Thickness = 2 })
					Farm.dots[2] = top
				end
				if top then
					top.From, top.To = sp, spTop
					top.Color = Color3.fromRGB(255, 210, 90)
					top.Transparency, top.Visible = 1, true
				end
			end
			-- what it is and how far, at the end of the line, because the
			-- panel readout is not where you are looking while it walks
			if not t then
				t = newDraw("Text", { Size = 14, Center = true, Outline = true,
					Color = Color3.fromRGB(255, 210, 90) })
				Farm.marks = t
			end
			if t then
				local me = myPos()
				local label = Farm.targetName ~= "" and Farm.targetName or "destination"
				if me then
					label = string.format("%s  %dm", label, math.floor((at - me).Magnitude))
				end
				t.Text = label
				t.Position = (spTop or sp) + Vector2.new(0, -16)
				t.Visible = true
			end
		else
			if d then d.Visible = false end
			if t then t.Visible = false end
			if Farm.dots[2] then Farm.dots[2].Visible = false end
		end
	end
end

-- The Speed slider IS WalkSpeed, and nothing else. Zero to sixty, written
-- straight onto the Humanoid and HELD there.
--
-- Holding is the part that was missing. A single write per tick loses to the
-- game's own SprintHandler, which writes WalkSpeed every frame - so the value
-- has to be put back the instant anything else touches it, which is what
-- Move.enforce has always done and this did not. It also used to be called
-- from the tail of the walk loop, behind nine early returns, so standing down
-- for noclip or a teleport quietly stopped the speed applying too. It has its
-- own connection now and does not care what the walking logic decided.
--
-- It stands down entirely when the Walk Speed feature is on: Move.enforce
-- holds the same property and two owners of one property is the bug.
function Farm.speedFix()
	if not Farm.on or Move.speedOn then return end
	local hum = getHum()
	if not hum then return end
	if Farm.baseWalk == nil and hum.WalkSpeed > 0 then
		Farm.baseWalk = hum.WalkSpeed
	end
	local ws = hum.WalkSpeed
	-- something else holding you at zero is a teleport in flight or a stun,
	-- and neither is ours to overrule
	if ws <= 0.05 and Farm.speed > 0.05 then return end
	if math.abs(ws - Farm.speed) > 0.01 then
		pcall(function() hum.WalkSpeed = Farm.speed end)
	end
end

function Farm.bindSpeed()
	if Farm.walkConn then Farm.walkConn:Disconnect() Farm.walkConn = nil end
	local hum = getHum()
	Farm.boundHum = hum
	if hum then
		Farm.walkConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(Farm.speedFix)
		Farm.speedFix()
	end
end

function Farm.armSpeed()
	if Farm.speedLoop then return end
	Farm.speedLoop = RunService.RenderStepped:Connect(function()
		if not Farm.on then return end
		-- a respawn is a new Humanoid, and the guard was on the old one
		if getHum() ~= Farm.boundHum then
			Farm.animOn = false
			Farm.bindSpeed()
		end
		Farm.speedFix()
		-- the same fast-walk fix the Walk Speed feature gets. The two never
		-- run at once - Farm stands down whenever Move.speedOn - so there is
		-- no argument over whose animation ids these are.
		if os.clock() - (Farm.animLast or 0) >= 0.25 then
			Farm.animLast = os.clock()
			local hum = getHum()
			local fast = (not Move.speedOn) and hum and Farm.baseWalk
				and hum.WalkSpeed > Farm.baseWalk + 2 or false
			if fast ~= Farm.animOn then
				Farm.animOn = fast
				Move.setRunAnim(fast)
			end
		end
		if Farm.animOn then Move.holdAnimSpeed() end
	end)
	Farm.bindSpeed()
	addCleanup("farmspeed", function() Farm.disarmSpeed() end)
end

function Farm.disarmSpeed()
	if Farm.speedLoop then Farm.speedLoop:Disconnect() Farm.speedLoop = nil end
	if Farm.walkConn then Farm.walkConn:Disconnect() Farm.walkConn = nil end
	Farm.boundHum = nil
	if Farm.animOn then
		Farm.animOn = false
		Move.setRunAnim(false)
	end
	Farm.restoreWalk()
end

function Farm.push(dt)
	Farm.speedBy = Move.speedOn and "the Walk Speed slider"
		or string.format("WalkSpeed %d", math.floor(Farm.speed))
end

-- Auto Farm writes WalkSpeed only when nothing else owns it, so it is the
-- one that has to hand the game's own number back.
function Farm.restoreWalk()
	local hum = getHum()
	if hum and Farm.baseWalk and not Move.speedOn then
		pcall(function() hum.WalkSpeed = Farm.baseWalk end)
	end
	Farm.baseWalk = nil
end
addCleanup("farmwalk", function() Farm.restoreWalk() end)

function Farm.set(on)
	Farm.on = on
	if not on then
		if Farm.conn then Farm.conn:Disconnect() Farm.conn = nil end
		Farm.stopWalking()
		Farm.target, Farm.targetName, Farm.targetPts = nil, "", 0
		Farm.fleeing, Farm.stuck, Farm.dodgeGoal = false, 0, nil
		Farm.sampleAt, Farm.samplePos = nil, nil
		Farm.state, Farm.why = "off", ""
		Farm.blocked, Farm.touching = false, false
		-- a retired landmark is retired for this run, not for the session
		Farm.deadDests, Farm.deadEnds = nil, nil
		Farm.committed, Farm.committedName = nil, nil
		Farm.disarmSpeed()
		Farm.hidePath()
		Farm.markRake()
		return
	end
	if Farm.conn then return end
	Farm.armSpeed()
	Farm.lastPick, Farm.stuck = 0, 0
	Farm.sampleAt, Farm.samplePos = nil, nil

	-- One Heartbeat connection that re-reads the character every tick, which
	-- is what makes it survive a respawn: nothing here holds a humanoid.
	Farm.conn = RunService.Heartbeat:Connect(function(dt)
		if not Farm.on then return end
		local char, hum, hrp = LocalPlayer.Character, getHum(), getHRP()
		if not (char and hum and hrp) then
			Farm.state, Farm.why = "waiting", "no character"
			return
		end
		if hum.Health <= 0 then
			Farm.state, Farm.why = "waiting", "you are dead"
			return
		end
		local downed = char:FindFirstChild("Downed")
		if downed and downed.Value == true then
			Farm.state, Farm.why = "waiting", "you are downed"
			return
		end

		-- One guard per thing that also drives the character, each for its
		-- own reason. Standing down is the right answer for all of them: two
		-- features steering one rig is how you end up going nowhere.
		--
		--   Fly       drives the root through a BodyVelocity and a BodyGyro,
		--             so a MoveTo is pulling against a force
		--   FreeCam   anchors the character and owns the view
		--   Anchored  Hide, glide and restorePower all anchor. An anchored
		--             assembly is not simulated, so neither the MoveTo nor
		--             the PivotTo would replicate - you would walk on this
		--             screen only while the server kept you where you were
		--   Teleport  Teleport.go sets WalkSpeed to 0 and PivotTos for
		--             twenty frames; steering mid-flight fights the trip
		--   WalkSpeed 0 from anything else - a stun that never sets Downed -
		--             is something deliberately immobilising you
		--
		-- Not guarded, deliberately: Noclip only clears CanCollide, and
		-- walking is unaffected by it. Blink is a one-shot PivotTo and the
		-- next tick simply re-steers from wherever it put you. Spinbot and
		-- Always Face Rake rewrite rotation only. This is a translation
		-- along the same heading this one chose.
		if Move.fly then
			Farm.state, Farm.why = "standing down", "Fly is driving the character"
			return
		end
		if Free.on then
			Farm.state, Farm.why = "standing down", "FreeCam owns the character"
			return
		end
		if Teleport.busy then
			Farm.state, Farm.why = "standing down", "a teleport is in flight"
			return
		end
		-- Move.setNoclip clears CanCollide on EVERY character part every
		-- Stepped, and a Humanoid with nothing collidable sinks through the
		-- floor: MoveTo steers nothing and the touch never lands.
		if Move.noclip then
			Farm.state, Farm.why = "standing down", "Noclip has the rig falling through the floor"
			return
		end
		if hrp.Anchored then
			Farm.state = "standing down"
			Farm.why = Ex.hidden and "Hide has you anchored under the map"
				or "the character is anchored"
			return
		end
		if hum.WalkSpeed <= 0.05 then
			Farm.state, Farm.why = "standing down", "something has WalkSpeed at 0"
			return
		end

		local now = os.clock()
		if now - Farm.lastPick >= Farm.PICK_GAP then
			Farm.lastPick = now
			-- MoveTo also expires on its own after about eight seconds, so
			-- re-issuing it on this clock is what keeps the walk order alive
			Farm.think(hrp.Position)
		end
		Farm.push(dt)
		Farm.drawPath()
		Farm.markRake()
		if Farm.priority == "Scrap" and os.clock() - (Farm.magnetAt or 0) >= 0.2 then
			Farm.magnetAt = os.clock()
			Farm.pulled = Farm.pullScrap(hrp.Position)
		end
	end)

	addCleanup("autofarm", function() Farm.set(false) end)
end

-- Belt and braces, and required rather than tidy: OnUnload sets Farm.on
-- false DIRECTLY before it runs the cleanup list, so the standing MoveTo
-- order needs an entry that cancels it without going through the setter.
addCleanup("autofarm_stop", function()
	Farm.on = false
	if Farm.conn then Farm.conn:Disconnect() Farm.conn = nil end
	Farm.stopWalking()
end)

-- Carries live distances, so it is on liveLabel's own clock - TIME
-- throttled, not deduped against the last string.
function Farm.readout()
	if not Farm.on then return "off" end
	local out = Farm.state
	if Farm.why ~= "" then out = out .. " - " .. Farm.why end

	local me = myPos()
	if Farm.priority == "Scrap" and Farm.target and me then
		out = out .. string.format("\ntarget %s, %d pts, %d studs",
			Farm.targetName, Farm.targetPts,
			math.floor((Farm.target.pos - me).Magnitude))
	elseif Farm.priority == "Survival" and Farm.targetName ~= "" and Farm.dest and me then
		out = out .. string.format("\nheading for %s, %d studs",
			Farm.targetName, math.floor((Farm.dest - me).Magnitude))
	end
	if Farm.blocked then
		out = out .. "\na trap sits on the way - holding until it clears"
	end

	local info = Farm.rk
	if info.part then
		out = out .. string.format("\nRake %d studs, %s%s%s",
			math.floor(info.real),
			info.active and "hunting" or "not hunting",
			info.chasing and ", ON YOU" or "",
			info.blood and ", BLOOD HOUR" or "")
	else
		out = out .. "\nno Rake in the workspace"
	end

	if Farm.priority == "Scrap" then
		out = out .. string.format("\n%d scrap up, %d vetoed", Farm.seen, Farm.vetoed)
	end
	out = out .. "\nspeed by " .. (Farm.speedBy or "nothing")
	if Farm.points then
		out = out .. string.format("\npath: waypoint %d of %d", Farm.point, #Farm.points)
	elseif (Farm.pathFail or 0) > 0 then
		out = out .. "\nno path - steering straight at it"
	end
	-- the SValues check, kept live rather than trusted
	out = out .. string.format("\nSValues %d/%d set%s", Farm.svNonNil, Farm.svTotal,
		Farm.svNonNil == 0 and " (as dumped: not the live list)" or " - worth a look")
	return out
end

-- ================================== misc ==================================
-- Client bypasses, all of them hook-free. Most work by reaching the game's
-- OWN settings table through getScriptGlobal rather than fighting the script
-- that owns it: change it at the source and there is nothing to hold every
-- frame and nothing to notice.
--
-- GSettings is that table. The game reads it for motion blur, shadows, chat,
-- music, nametags and sixth sense, and it raises SettingsChangedEvent when
-- one of them moves - so we raise it too, and the game applies the change
-- itself exactly as if you had used its own menu.

local Misc = {
	noMotionBlur = false, noShadows = false,
	muteMusic = false, muteChase = false,
	forceChat = false, nametags = false, sixthSense = false,
	hideDeathMsg = false, blockPopups = false, forcePc = false,
	freezeLook = false,
	saved = {}, status = "off", last = 0,
}

function Misc.gsettings()
	local gs = getScriptGlobal("GSettings")
	if type(gs) ~= "table" then
		gs = {}
		setScriptGlobal("GSettings", gs)
	end
	return gs
end

function Misc.remember(key, value)
	if Misc.saved[key] == nil then Misc.saved[key] = value end
	return Misc.saved[key]
end

function Misc.setGS(key, wanted, default)
	local gs = Misc.gsettings()
	Misc.remember("gs:" .. key, gs[key] ~= false)
	gs[key] = wanted
	setScriptGlobal("GSettings", gs)
	pcall(function()
		local ev = ReplicatedStorage:FindFirstChild("SettingsChangedEvent")
		if ev and ev.Fire then ev:Fire(key, wanted) end
	end)
end

-- one-shot: get past the loading screen and the menu
function Misc.skipIntro()
	setScriptGlobal("IsLoading", nil)
	setScriptGlobal("SLoaded", true)
	pcall(function() LocalPlayer:SetAttribute("Started", true) end)
	local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local removed = 0
	if gui then
		for _, g in ipairs(gui:GetChildren()) do
			if g:IsA("ScreenGui")
				and (g.Name == "IntroGUI" or (g:FindFirstChild("LoadingFrame") and g:FindFirstChild("MenuFrame"))) then
				pcall(function() g:Destroy() end)
				removed = removed + 1
			end
		end
	end
	pcall(function()
		local died = ReplicatedStorage:FindFirstChild("DiedEvent")
		if died and died.Fire then died:Fire(false, true) end
	end)
	local starter = game:GetService("StarterGui")
	pcall(function() starter:SetCore("TopbarEnabled", true) end)
	for _, kind in ipairs({ Enum.CoreGuiType.Health, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Chat }) do
		pcall(function() starter:SetCoreGuiEnabled(kind, true) end)
	end
	notify(removed > 0 and ("skipped the intro (" .. removed .. " screens)") or "nothing to skip", 4)
end

function Misc.soundGroup(name)
	local ss = game:GetService("SoundService")
	local g = ss and ss:FindFirstChild(name)
	-- these are SoundGroups in this game, not Sounds
	return (g and (g:IsA("SoundGroup") or g:IsA("Sound"))) and g or nil
end

function Misc.setMute(name, key, on)
	local g = Misc.soundGroup(name)
	if not g then return end
	local was = Misc.remember("vol:" .. name, g.Volume)
	pcall(function() g.Volume = on and 0 or (was > 0 and was or 1) end)
end

-- The UI sound bank: Chase and its neighbours are Sounds in the real UI
-- ScreenGui, quite separate from the SoundService groups.
function Misc.setUiMute(name, on, store)
	local ui = realUI()
	local snd = ui and ui:FindFirstChild(name)
	if not (snd and snd:IsA("Sound")) then return false end
	store[snd] = store[snd] == nil and snd.Volume or store[snd]
	if on then
		pcall(function()
			snd.Volume = 0
			snd:Stop()
		end)
	else
		pcall(function() snd.Volume = store[snd] or 0.5 end)
	end
	return true
end

function Misc.setNoChase(on)
	Misc.noChase = on
	Misc.chaseSaved = Misc.chaseSaved or {}
	Misc.setMute("ChaseMusic", "ChaseMusic", on)
	Misc.setUiMute("Chase", on, Misc.chaseSaved)
	if not on then
		if Misc.chaseConn then Misc.chaseConn:Disconnect() Misc.chaseConn = nil end
		return
	end
	if Misc.chaseConn then return end
	-- it is restarted with a fresh volume every chase, so keep putting it back
	Misc.chaseConn = RunService.Heartbeat:Connect(function()
		if not Misc.noChase then return end
		if os.clock() - (Misc.chaseLast or 0) < 0.5 then return end
		Misc.chaseLast = os.clock()
		Misc.setUiMute("Chase", true, Misc.chaseSaved)
		Misc.setMute("ChaseMusic", "ChaseMusic", true)
	end)
	addCleanup("nochase", function() Misc.setNoChase(false) end)
end

function Misc.sixthSenseMarker(on)
	local marker = LocalPlayer:FindFirstChild("SixthSenseGamepass")
	if on then
		if not marker then
			marker = make("BoolValue", { Name = "SixthSenseGamepass", Value = true }, LocalPlayer)
			marker:SetAttribute("RKMarker", true)
		end
		pcall(function() marker.Value = true end)
	elseif marker and marker:GetAttribute("RKMarker") == true then
		pcall(function() marker:Destroy() end)
	end
end

function Misc.enforce()
	if Misc.conn then return end
	Misc.conn = RunService.Heartbeat:Connect(function()
		if os.clock() - Misc.last < 0.5 then return end
		Misc.last = os.clock()
		local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

		if Misc.noMotionBlur then
			local c = cam()
			if c then
				for _, fx in ipairs(c:GetChildren()) do
					if (fx:IsA("BlurEffect") and (fx.Name == "MotionBlur" or fx.Name == "ESCB"))
						or (fx:IsA("ColorCorrectionEffect") and fx.Name == "ESCC") then
						pcall(function() fx.Enabled = false end)
					end
				end
			end
		end

		if Misc.noShadows and Lighting.GlobalShadows then
			pcall(function() Lighting.GlobalShadows = false end)
		end

		if Misc.hideDeathMsg and gui then
			for _, d in ipairs(gui:GetDescendants()) do
				if d.Name == "DeathMsg" and d:IsA("TextLabel") and d.Visible then
					d.Visible = false
				end
			end
		end

		if Misc.blockPopups and gui then
			for _, g in ipairs(gui:GetChildren()) do
				if g:IsA("ScreenGui") and (g.Name == "_fav" or g.Name == "_fav2") then
					pcall(function() g:Destroy() end)
				end
			end
		end

		if Misc.sixthSense then Misc.sixthSenseMarker(true) end

		if Misc.freezeLook then
			pcall(function()
				local remote = ReplicatedStorage:FindFirstChild("SetLookAngles")
				if remote and remote.FireServer then remote:FireServer(0, 0) end
			end)
		end
	end)
	addCleanup("miscloop", function()
		if Misc.conn then Misc.conn:Disconnect() Misc.conn = nil end
	end)
end

function Misc.set(field, value, gsKey)
	Misc[field] = value
	Misc.enforce()
	if gsKey then
		if value then
			Misc.setGS(gsKey, field == "forceChat" or field == "nametags" or field == "sixthSense")
		else
			local gs = Misc.gsettings()
			gs[gsKey] = Misc.saved["gs:" .. gsKey]
			setScriptGlobal("GSettings", gs)
			pcall(function()
				local ev = ReplicatedStorage:FindFirstChild("SettingsChangedEvent")
				if ev and ev.Fire then ev:Fire(gsKey, gs[gsKey]) end
			end)
		end
	end
	if field == "muteMusic" then Misc.setMute("GameMusic", "GameMusic", value) end
	if field == "muteChase" then Misc.setMute("ChaseMusic", "ChaseMusic", value) end
	if field == "sixthSense" and not value then Misc.sixthSenseMarker(false) end
	if field == "forceChat" and value then
		pcall(function()
			game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
		end)
	end
	if field == "noShadows" and not value then
		pcall(function() Lighting.GlobalShadows = Misc.saved["shadows"] ~= false end)
	elseif field == "noShadows" and value then
		Misc.remember("shadows", Lighting.GlobalShadows)
	end
end

-- The game keeps which device you are on in a script global and branches on
-- it. Telling it PC turns the mobile layout and its touch-only limits off.
function Misc.setForcePc(on)
	Misc.forcePc = on
	if on then
		Misc.remember("device", getScriptGlobal("deviceType"))
		setScriptGlobal("deviceType", "PC")
		setScriptGlobal("inputType", "PC")
	else
		local was = Misc.saved["device"]
		if was ~= nil then
			setScriptGlobal("deviceType", was)
			setScriptGlobal("inputType", was)
		end
	end
	pcall(function()
		local ev = getScriptGlobal("InputTypeChangeEvent")
		if ev and ev.Fire then ev:Fire(on and "PC" or Misc.saved["device"]) end
	end)
end

addCleanup("misc", function()
	Misc.setMute("GameMusic", "GameMusic", false)
	Misc.setMute("ChaseMusic", "ChaseMusic", false)
	Misc.sixthSenseMarker(false)
	if Misc.forcePc then Misc.setForcePc(false) end
	pcall(function() Lighting.GlobalShadows = Misc.saved["shadows"] ~= false end)
end)

-- ============================ the scare layer ============================
-- Everything the game throws at your screen and your ears when the Rake is
-- close. All of it lives on your own client - the overlays under the real UI
-- ScreenGui, and the sound bank beside them.

local Scare = {
	noScreen = false, noHeartbeat = false, noScream = false, screams = {},
	beatGuards = {},
	stickSound = "", overlays = {}, muted = {}, sticks = {},
}

Scare.OVERLAYS = {
	BloodShot = true, BloodShot2 = true, GrainImage = true, GrainImage2 = true,
	DefaultOverlay = true, DefaultOverlay2 = true,
}

function Scare.setNoScreen(on)
	Scare.noScreen = on
	if not on then
		for obj, was in pairs(Scare.overlays) do
			if obj and obj.Parent then pcall(function() obj.Visible = was end) end
		end
		Scare.overlays = {}
		if Scare.screenConn then Scare.screenConn:Disconnect() Scare.screenConn = nil end
		return
	end
	if Scare.screenConn then return end
	Scare.screenConn = RunService.RenderStepped:Connect(function()
		if not Scare.noScreen then return end
		local ui = realUI()
		if not ui then return end
		for _, d in ipairs(ui:GetDescendants()) do
			if d:IsA("ImageLabel") and Scare.OVERLAYS[d.Name] and d.Visible then
				if Scare.overlays[d] == nil then Scare.overlays[d] = true end
				d.Visible = false
			end
		end
		-- and the blur and colour wash the scare puts on the camera
		local c = cam()
		if c then
			for _, fx in ipairs(c:GetChildren()) do
				if (fx:IsA("BlurEffect") or fx:IsA("ColorCorrectionEffect")) and fx.Enabled then
					if Scare.overlays[fx] == nil then Scare.overlays[fx] = true end
					fx.Enabled = false
				end
			end
		end
	end)
	addCleanup("noscreen", function() Scare.setNoScreen(false) end)
end

function Scare.setNoScream(on)
	Scare.noScream = on
	if not on then
		for snd, vol in pairs(Scare.screams or {}) do
			if snd and snd.Parent then pcall(function() snd.Volume = vol end) end
		end
		Scare.screams = {}
		if Scare.screamConn then Scare.screamConn:Disconnect() Scare.screamConn = nil end
		return
	end
	Scare.screams = Scare.screams or {}
	if Scare.screamConn then return end
	Scare.screamConn = RunService.Heartbeat:Connect(function()
		if not Scare.noScream then return end
		if os.clock() - (Scare.screamLast or 0) < 0.4 then return end
		Scare.screamLast = os.clock()
		local r = rake()
		if not r then return end
		for _, d in ipairs(r:GetDescendants()) do
			if d:IsA("Sound") and string.find(string.lower(d.Name), "scream", 1, true) then
				if Scare.screams[d] == nil then Scare.screams[d] = d.Volume end
				if d.Volume > 0 then d.Volume = 0 end
				if d.Playing then d.Playing = false end
			end
		end
	end)
	addCleanup("noscream", function() Scare.setNoScream(false) end)
end

function Scare.beatSound()
	local ui = realUI()
	local snd = ui and ui:FindFirstChild("Heartbeat")
	return (snd and snd:IsA("Sound")) and snd or nil
end

function Scare.holdBeat(snd)
	if not snd or Scare.beatGuards[snd] then return end
	Scare.beatGuards[snd] = {
		-- silence it the instant anything sets a volume on it
		snd:GetPropertyChangedSignal("Volume"):Connect(function()
			if Scare.noHeartbeat and snd.Volume > 0 then snd.Volume = 0 end
		end),
		-- and stop it the instant it starts, so a beat cannot slip between
		-- two of our writes the way it did on a timer
		snd:GetPropertyChangedSignal("Playing"):Connect(function()
			if Scare.noHeartbeat and snd.Playing then
				snd.Playing = false
				snd.TimePosition = 0
			end
		end),
		snd.Played:Connect(function()
			if Scare.noHeartbeat then pcall(function() snd:Stop() end) end
		end),
	}
end

function Scare.setNoHeartbeat(on)
	Scare.noHeartbeat = on
	Scare.beatGuards = Scare.beatGuards or {}
	if not on then
		for snd, conns in pairs(Scare.beatGuards) do
			for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
			if snd and snd.Parent then
				local was = Scare.muted[snd]
				if was then pcall(function() snd.Volume = was end) end
			end
		end
		Scare.beatGuards, Scare.muted = {}, {}
		if Scare.beatConn then Scare.beatConn:Disconnect() Scare.beatConn = nil end
		return
	end

	local snd = Scare.beatSound()
	if snd then
		if Scare.muted[snd] == nil then Scare.muted[snd] = snd.Volume end
		pcall(function()
			snd.Volume = 0
			snd:Stop()
		end)
		Scare.holdBeat(snd)
	end

	if Scare.beatConn then return end
	-- the UI is rebuilt on respawn, so keep looking for a new one
	Scare.beatConn = RunService.Heartbeat:Connect(function()
		if not Scare.noHeartbeat then return end
		if os.clock() - (Scare.beatLast or 0) < 1 then return end
		Scare.beatLast = os.clock()
		local live = Scare.beatSound()
		if live and not Scare.beatGuards[live] then
			if Scare.muted[live] == nil then Scare.muted[live] = live.Volume end
			pcall(function() live.Volume = 0 live:Stop() end)
			Scare.holdBeat(live)
		end
	end)
	addCleanup("noheartbeat", function() Scare.setNoHeartbeat(false) end)
end

-- Your own copy of the sound the stick makes. The server is not told what
-- your client plays, so this is cosmetic and entirely yours.
function Scare.setStickSound(id)
	id = tostring(id or ""):gsub("%s", "")
	if id ~= "" and not id:find("rbxassetid") then
		id = "rbxassetid://" .. id:gsub("%D", "")
	end
	Scare.stickSound = id
