-- Anything on your client still listening to a part stops listening. This is
-- the whole of "step over it and nothing happens": the trap stays where it
-- is, it simply never notices you.
function Ex.cutTouches(part)
	local cut = {}
	if typeof(getconnections) ~= "function" then return cut end
	for _, signal in ipairs({ "Touched", "TouchEnded" }) do
		local ok, conns = pcall(function() return getconnections(part[signal]) end)
		if ok and type(conns) == "table" then
			for _, c in ipairs(conns) do
				pcall(function()
					if c.Disable then c:Disable() cut[#cut + 1] = c end
				end)
			end
		end
	end
	Ex.trapCut = Ex.trapCut or {}
	Ex.trapCut[part] = cut
	return cut
end

-- and the other half of it. Disarming a part took its CanTouch AND every
-- connection listening to it; only the first was ever handed back, and
-- clearing the record was what made the second unrecoverable.
function Ex.reTouches(part)
	local cut = Ex.trapCut and Ex.trapCut[part]
	if not cut then return end
	for _, c in ipairs(cut) do
		pcall(function() if c.Enable then c:Enable() end end)
	end
	Ex.trapCut[part] = nil
end

-- Anti Trap. A rusty trap is 75 damage and your stamina straight to zero,
-- and it is disguised as scrap so you often do not see it until you are in
-- it. Taking CanTouch off the hitbox of anything trap shaped nearby means
-- you walk over it instead. Only nearby ones are touched, so this stays
-- cheap and does not disturb the whole map.
Ex.trapRadius = 16

function Ex.setAntiTrap(on)
	Ex.antiTrap = on
	if not on then
		if Ex.trapConn then Ex.trapConn:Disconnect() Ex.trapConn = nil end
		for part, was in pairs(Ex.trapParts or {}) do
			if part and part.Parent then pcall(function() part.CanTouch = was end) end
			Ex.reTouches(part)
		end
		Ex.trapParts, Ex.trapCut = {}, {}
		Ex.trapStatus = "off"
		return
	end
	Ex.trapParts = Ex.trapParts or {}
	Ex.trapCut = Ex.trapCut or {}
	if Ex.trapConn then return end
	Ex.trapConn = RunService.Heartbeat:Connect(function()
		if not Ex.antiTrap then return end
		if os.clock() - (Ex.trapLast or 0) < 0.25 then return end
		Ex.trapLast = os.clock()
		local me = myPos()
		if not me then return end
		local near = 0
		for _, m in ipairs(trapModels()) do
			local box = m:FindFirstChild("HitBox")
			-- A trap you placed is the same RakeTrapModel running the same
			-- TrapMain as a rusty one, and every player's Head carries a
			-- ScreamTrap sound, so it can close on you too. Both kinds get
			-- disarmed. The single exception is the one model Insta Kill is
			-- working with right now, which gets whatever we took back.
			if m == Ex.killTrap then
				for _, part in ipairs(m:GetDescendants()) do
					if part:IsA("BasePart") and Ex.trapParts[part] ~= nil then
						local was = Ex.trapParts[part]
						pcall(function() part.CanTouch = was end)
						Ex.reTouches(part)
						Ex.trapParts[part] = nil
					end
				end
			elseif box and box:IsA("BasePart")
				and (box.Position - me).Magnitude <= Ex.trapRadius then
				near = near + 1
				for _, part in ipairs(m:GetDescendants()) do
					if part:IsA("BasePart") then
						-- collision is left alone on purpose: taking it away
						-- from under a resting part is what threw the trap
						if Ex.trapParts[part] == nil then
							Ex.trapParts[part] = part.CanTouch
							Ex.cutTouches(part)
						end
						if part.CanTouch then part.CanTouch = false end
					end
				end
			end
		end
		Ex.trapStatus = near > 0 and (near .. " disarmed near you") or "clear"
	end)
	addCleanup("antitrap", function() Ex.setAntiTrap(false) end)
end

Ex.floatHeight = 20
Ex.floatSize = 14

function Ex.floatPad()
	if Ex.floatPart and Ex.floatPart.Parent then return Ex.floatPart end
	Ex.floatPart = make("Part", {
		Name = "RKFloat", Anchored = true, CanCollide = true, CanQuery = false,
		Transparency = 0.65, Material = Enum.Material.Neon,
		Color = Color3.fromRGB(90, 170, 255),
		Size = Vector3.new(Ex.floatSize, 1, Ex.floatSize),
		Position = Vector3.new(0, 10000, 0),
	}, Workspace)
	return Ex.floatPart
end

-- Where the ground under you is, so the pad sits twenty studs above THAT
-- rather than twenty above wherever you happen to be standing already.
function Ex.groundY(from)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local skip = { Ex.floatPart }
	if LocalPlayer.Character then skip[#skip + 1] = LocalPlayer.Character end
	params.FilterDescendantsInstances = skip
	local hit
	pcall(function()
		hit = Workspace:Raycast(from, Vector3.new(0, -300, 0), params)
	end)
	return hit and hit.Position.Y or (from.Y - 5)
end

function Ex.setFloat(on)
	Ex.float = on
	if not on then
		if Ex.floatConn then Ex.floatConn:Disconnect() Ex.floatConn = nil end
		if Ex.floatPart then Ex.floatPart.Position = Vector3.new(0, 10000, 0) end
		return
	end
	Ex.floatPad()
	local hrp = getHRP()
	if not hrp then
		notify("no character to float", 4)
		Ex.float = false
		return
	end
	-- put it under you and step up onto it, once
	local groundY = Ex.groundY(hrp.Position)
	local top = groundY + Ex.floatHeight
	Ex.floatPart.Position = Vector3.new(hrp.Position.X, top, hrp.Position.Z)
	local char = LocalPlayer.Character
	if char then
		pcall(function()
			char:PivotTo(CFrame.new(hrp.Position.X, top + 3.5, hrp.Position.Z))
		end)
	end

	if Ex.floatConn then return end
	Ex.floatConn = RunService.Heartbeat:Connect(function()
		if not Ex.float then return end
		local live = getHRP()
		local pad = Ex.floatPart
		if not (live and pad and pad.Parent) then return end
		-- Fly, Freecam and Hide all own where the character is; a pad shoving
		-- itself under you while one of those is driving is a fight
		if Move.fly or Free.on or Ex.hidden or live.Anchored then return end
		-- only follow while you are actually standing on it. Walking off the
		-- edge should be a fall, not something the pad follows you through.
		local d = live.Position - pad.Position
		if math.abs(d.Y - 3.5) > 6 then return end
		if math.abs(d.X) > Ex.floatSize or math.abs(d.Z) > Ex.floatSize then return end
		pad.Position = Vector3.new(live.Position.X, pad.Position.Y, live.Position.Z)
	end)
	addCleanup("float", function() Ex.setFloat(false) end)
end

addCleanup("floatpart", function()
	if Ex.floatPart then pcall(function() Ex.floatPart:Destroy() end) Ex.floatPart = nil end
end)

Ex.bringRadius = 4000

function Ex.haveFlare()
	local char = LocalPlayer.Character
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	return (char and char:FindFirstChild("FlareGun") ~= nil)
		or (bp and bp:FindFirstChild("FlareGun") ~= nil)
end

-- Stand on it until it is yours, then put yourself back.
--
-- Fly, Freecam and Hide all own where the character is, and an anchored
-- assembly does not replicate at all, so none of those get moved out from
-- under themselves. Everything here is written UNANCHORED, which is the only
-- reason the server agrees with any of it.
Ex.flareHold = 3

function Ex.rideFlare(gun)
	local hrp = getHRP()
	local char = LocalPlayer.Character
	if not (hrp and char and gun and gun.Parent) then return end
	if Move.fly or Free.on or Ex.hidden or hrp.Anchored then
		notify("cannot go for the flare gun while fly, freecam or hide is on", 5)
		return
	end
	local back = hrp.CFrame
	local t0 = os.clock()
	while os.clock() - t0 < Ex.flareHold do
		if not (Ex.autoFlare and gun.Parent) then break end
		if Ex.haveFlare() then break end
		local live = getHRP()
		if not live or live.Anchored then break end
		-- stand ON it rather than reach for it from across the map
		pcall(function()
			char:PivotTo(CFrame.new(gun.Position + Vector3.new(0, 2.5, 0)))
			live.AssemblyLinearVelocity = Vector3.zero
		end)
		Ex.grabFlare()
		task.wait(0.15)
	end
	local live = getHRP()
	if live and not live.Anchored and LocalPlayer.Character then
		pcall(function() LocalPlayer.Character:PivotTo(back) end)
	end
	notify(Ex.haveFlare() and "flare gun collected"
		or "could not pick the flare gun up", 4)
end

function Ex.grabFlare()
	local gun = flarePart()
	local hrp = getHRP()
	if not (gun and hrp) then return false, "no flare gun spawned" end
	if typeof(firetouchinterest) ~= "function" then
		return false, "this executor has no firetouchinterest"
	end
	local ok = pcall(function()
		firetouchinterest(hrp, gun, 0)
		task.wait()
		firetouchinterest(hrp, gun, 1)
	end)
	return ok, ok and "touched the flare gun" or "the touch was refused"
end

function Ex.setAutoFlare(on)
	Ex.autoFlare = on
	if not on then
		if Ex.flareConn then Ex.flareConn:Disconnect() Ex.flareConn = nil end
		return
	end
	if Ex.flareConn then return end
	Ex.flareConn = RunService.Heartbeat:Connect(function()
		if not Ex.autoFlare then return end
		if Ex.flareBusy then return end
		if os.clock() - (Ex.flareLast or 0) < 1 then return end
		Ex.flareLast = os.clock()
		if Ex.haveFlare() then return end
		local gun = flarePart()
		if not gun then return end
		Ex.flareBusy = true
		task.spawn(function()
			pcall(Ex.rideFlare, gun)
			Ex.flareBusy = false
		end)
	end)
	addCleanup("autoflare", function() Ex.setAutoFlare(false) end)
end

function Ex.bringScraps()
	local spawns = pathTo(Workspace, "Filter", "ScrapSpawns")
	local char = LocalPlayer.Character
	local me = myPos()
	if not (spawns and char and me) then return end
	local moved, skipped = 0, 0
	for _, v in ipairs(spawns:GetDescendants()) do
		if string.lower(v.Name) == "scrap" then
			-- a rusty trap is a reskin of the shop trap and lives on these
			-- same spawns; pulling one of those to your feet is a bad day
			local parent = v.Parent
			local isTrap = parent and looksLikeTrap(parent)
			local far = v:IsA("BasePart") and (v.Position - me).Magnitude > Ex.bringRadius
			if isTrap or far then
				skipped = skipped + 1
			else
				local ok = pcall(function() v:PivotTo(char:GetPivot()) end)
				if ok then moved = moved + 1 end
			end
		end
	end
	notify(string.format("pulled %d scrap%s", moved,
		skipped > 0 and (", left " .. skipped .. " out of range or trapped") or ""), 5)
end

function Ex.removeWalls()
	local walls = pathTo(Workspace, "Filter", "InvisibleWalls")
	if not walls then
		notify("no InvisibleWalls folder here", 4)
		return
	end
	local gone = 0
	for _, v in ipairs(walls:GetChildren()) do
		local n = string.lower(v.Name)
		if n == "invisiblewall" or n == "invis" then
			pcall(function() v:Destroy() end)
			gone = gone + 1
		end
	end
	notify("removed " .. gone .. " walls", 4)
end

-- Back to the shape that worked, and here is why it works: the jiggle is
-- what phases you through the floor, the drop is only about 15 studs so you
-- are just under it rather than in the void, and HidePart is a 20 x 1000 x 20
-- PILLAR positioned 505 below you - which puts its top right at your feet.
-- A thousand studs of solid part underneath is why this never drops anyone.
--
-- The three hundred stud version failed for exactly one reason: it anchored
-- FIRST and descended AFTER. An anchored part is not simulated, so the
-- client stops streaming its position and every CFrame written into it from
-- then on is local only. The server kept the last thing it was ever told,
-- which was the fifteen stud drop - and Workspace.Rake runs on Scripts, not
-- LocalScripts (AM, NMM, BHM, RGM, Ultimate_AI, with TargetVal holding a
-- HumanoidRootPart), so it chased the server's copy of you the whole time.
-- The camera went down three hundred studs. The character went down fifteen,
-- which is why he could still reach you AND why it looked broken.
--
-- Ex.openHouseDoor already has the right order and it is the order used
-- here: MOVE while unanchored so it replicates, wait a frame for it to land,
-- and only then anchor, which is what stops the server correcting you back.
-- Depth and working-at-all are genuinely in tension: anything past the
-- jiggle has to be reached unanchored, and unanchored you simply fall.

-- Hide, taken verbatim from the Rayfield build the user tested and confirmed.
--
-- One line in it is the whole difference from the version I ported before, and
-- I had swapped it without noticing:
--
--     theirs   hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
--     mine     hrp.CFrame = CFrame.new(hrp.Position) + Vector3.new(0, 5, 0)
--
-- CFrame.new(position) throws the ROTATION away and rebuilds the frame facing
-- world forward. So every one of the twenty jiggle writes was also snapping
-- the character upright and re-oriented, twenty re-orientations in twenty
-- frames, which is exactly the kind of thing a server rejects and pulls back.
-- Adding a Vector3 to the existing CFrame moves it and leaves the rotation
-- alone. That is the fix.
--
-- The rest is theirs too: fifteen studs down, anchor, pillar 505 below so its
-- top sits at your feet. No fall, no glide, no depth of mine. It is their
-- build that works and this is now their build.
function Ex.hideSlab()
	if Ex.hidePart and Ex.hidePart.Parent then return Ex.hidePart end
	Ex.hidePart = make("Part", {
		Name = "RKHide", Anchored = true, CanCollide = true,
		Size = Vector3.new(20, 1000, 20), Position = Vector3.new(0, 10000, 0),
	}, Workspace)
	-- made once and left parented, like theirs; only the Adornee is toggled
	Ex.hideGlow = make("Highlight", {
		Name = "RKHideGlow", FillTransparency = 0.8, OutlineTransparency = 0.8,
		FillColor = Color3.fromRGB(255, 255, 255),
		OutlineColor = Color3.fromRGB(170, 0, 0),
	}, Ex.hidePart)
	return Ex.hidePart
end

function Ex.setHide(on)
	-- The config loader fires every saved toggle on load, the false ones
	-- included, and the OFF branch is not a no-op: it jiggles and then throws
	-- you fifteen studs into the air.
	if on == Ex.hidden then return end
	if Ex.hideBusy then
		notify("still moving - give it a second", 3)
		-- the checkbox flipped before this callback ran, so put it back to
		-- the real state or the guard above eats the next click
		local tg = Toggles.RK_Hide
		if tg and tg.Value ~= Ex.hidden then
			tg.Value = Ex.hidden
			pcall(function() tg:Display() end)
		end
		return
	end
	Ex.hidden = on
	Ex.hideBusy = true
	Ex.hideSlab()

	task.spawn(function()
		local hrp = getHRP()
		if not hrp then Ex.hideBusy = false return end

		-- No fall happened here. Say so every single write, because one
		-- frame of Freefall is all a fall tracker needs.
		local hum = getHum()
		local function settle()
			local p = getHRP()
			if p then pcall(function() p.AssemblyLinearVelocity = Vector3.zero end) end
			local h = getHum()
			if h then
				pcall(function()
					h:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
					h:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
			end)
		end

		hrp.Anchored = false
		for _ = 1, 10 do
			local live = getHRP()
			if not live then break end
			live.CFrame = live.CFrame + Vector3.new(0, 5, 0)
			settle()
			task.wait()
			live = getHRP()
			if not live then break end
			live.CFrame = live.CFrame + Vector3.new(0, -5, 0)
			settle()
		end

		local live = getHRP()
		if live then
			if on then
				live.CFrame = live.CFrame + Vector3.new(0, -15, 0)
				settle()
				task.wait()
				settle()
				local down = getHRP()
				if down then
					down.Anchored = true
					Ex.hidePart.Position = down.Position + Vector3.new(0, -505, 0)
					if Ex.hideGlow then Ex.hideGlow.Adornee = Ex.hidePart end
				end
			else
				live.CFrame = live.CFrame + Vector3.new(0, 15, 0)
				settle()
				task.wait()
				settle()
				local up = getHRP()
				if up then up.Anchored = false end
				if Ex.hideGlow then Ex.hideGlow.Adornee = nil end
				-- park the pillar a beat later, once you are demonstrably up
				task.delay(1, function()
					if Ex.hidePart and not Ex.hidden then
						Ex.hidePart.Position = Vector3.new(0, 10000, 0)
					end
				end)
			end
		end
		-- hand Freefall back, or nothing can ever fall again
		task.delay(0.5, function()
			local h = getHum()
			if h and not Ex.hidden then
				pcall(function()
					h:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
				end)
			end
		end)
		Ex.hideBusy = false
	end)
end


addCleanup("hide", function()
	local h = getHum()
	if h then
		pcall(function() h:SetStateEnabled(Enum.HumanoidStateType.Freefall, true) end)
	end
	if Ex.hideGlow then pcall(function() Ex.hideGlow:Destroy() end) Ex.hideGlow = nil end
	if Ex.hidePart then pcall(function() Ex.hidePart:Destroy() end) Ex.hidePart = nil end
	local hrp = getHRP()
	if hrp then pcall(function() hrp.Anchored = false end) end
end)

-- The traps, and the two features built on them.
--
-- Nothing here moves a trap, and that is the correction that made rusty ones
-- work. Dragging was the old premise and it is wrong twice over: a map-spawned
-- trap is server owned, so a PivotTo on it never replicates - which is exactly
-- what "it doesn't work on rusty traps" was - and even your own trap, pivoted
-- to a goal under his legs, is left unanchored in mid air and falls through
-- the map. You place the trap. These only ever spring it.
--
-- Every name below is off Rake/dumps/everything.txt:
--   11342  Workspace.Debris.Traps
--   11343  [Model] RakeTrapModel  @KEY=... @ServerSpawned=true
--   11344  [Script] TrapMain     a server Script - the trap's own logic is
--                                not reachable from here, only triggerable
--   11346  [MeshPart] Open   11347 [MeshPart] Close
--   11348  [Part] HitBox  size=(1.0,1.0,1.4)
--   11353  [TouchTransmitter] TouchInterest   on the HitBox, which is why a
--                                touch is the only thing we can report
--   11355  [ProximityPrompt] ProximityPrompt  this PICKS THE TRAP UP, which
--                                is why nothing here ever fires it
--
-- The BindableEvent at 11345 is deliberately untouched: a BindableEvent does
-- not cross the client / server line, so firing it reaches nothing.
--
-- @ServerSpawned=true marks the map's own rusty traps. Now that nothing is
-- moved, the distinction no longer matters for springing - a rusty trap
-- triggers exactly as well as one of yours - and it is left in only because
-- Anti Trap still needs to know which ones can close on YOU.

Ex.killGap     = 0.3   -- seconds between swings: about three a second
Ex.killTickGap = 0.05  -- how often Auto Trap looks. Twice as often as it was,
                       -- because a walking Rake leaves a trap behind quickly
Ex.killCatch   = 7     -- studs from the HitBox that counts as "he is in it"
Ex.killDrag    = 250   -- studs: past this a trap is not worth nudging
Ex.killRange   = 200   -- studs you may swing from. Its own number and not
                       -- Fight.range, or the Killaura Range slider would
                       -- silently switch this feature off

-- one line at a time, and only when it changes, so the feature narrates
-- itself without burying you in notifications
function Ex.killSay(text)
	if Ex.killSaid == text then return end
	Ex.killSaid = text
	notify(text, 4)
end

-- trapModels() covers Debris.Traps and the ones disguised on the scrap
-- spawns. A trap that was just put down can sit at the top of Workspace for
-- a moment before the server files it, so sweep that too.
function Ex.allTraps()
	local out, seen = {}, {}
	for _, m in ipairs(trapModels()) do
		if not seen[m] then seen[m] = true out[#out + 1] = m end
	end
	for _, m in ipairs(Workspace:GetChildren()) do
		if not seen[m] and looksLikeTrap(m) then seen[m] = true out[#out + 1] = m end
	end
	return out
end

-- Is he standing in one already? Any trap, yours or the map's, with its
-- hitbox on top of him counts.
-- The game says so itself, which beats measuring a distance and hoping.
-- A sprung trap sets @Activated on the model and @HitChar to who it caught,
-- and his own Humanoid gets @iTRPED2 = true with @TrapPos / @iTRPED holding
-- where it happened. All four are off the kill recording at 11.240.
function Ex.rakeTrapped(r)
	if not r then return nil end
	local hum = r:FindFirstChildOfClass("Humanoid")
	local flagged = false
	if hum then
		local ok, v = pcall(function() return hum:GetAttribute("iTRPED2") end)
		flagged = ok and v == true
	end
	for _, m in ipairs(Ex.allTraps()) do
		local hit = pcall(function() return m:GetAttribute("Activated") end)
			and m:GetAttribute("Activated") == true
		if hit and m:GetAttribute("HitChar") == "Rake" then return m end
	end
	-- the flag is set but no trap owns up to it, or the attributes are not
	-- there on this build: fall back to standing on one
	local hrp = r:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	for _, m in ipairs(Ex.allTraps()) do
		local box = m:FindFirstChild("HitBox")
		if box and box:IsA("BasePart")
			and (box.Position - hrp.Position).Magnitude <= Ex.killCatch then
			return m
		end
	end
	return flagged and Ex.allTraps()[1] or nil
end

-- Is the server done with him? Dead, Inactive and @HomeRun all land together
-- a second after the trap, with Rake_Escape2 - that is the round removing him.
function Ex.rakeGone(r)
	if not r then return false end
	local dead = r:FindFirstChild("Dead")
	local inactive = r:FindFirstChild("Inactive")
	if dead and dead:IsA("BoolValue") and dead.Value then return true end
	if inactive and inactive:IsA("BoolValue") and inactive.Value then return true end
	-- deliberately NOT hum.Health: this feature writes that to zero itself,
	-- so reading it back as proof of anything is reading our own hand.
	-- Dead and Inactive are BoolValues the SERVER sets.
	return false
end

-- Yours first while he is loose, because one you placed is one this client
-- has a chance of owning and therefore of actually moving.
--
-- Once he is CAUGHT, the map's rusty ones come in as extras - and the pick
-- changes with it. This is what "still doesn't work on rusty traps" was: the
-- old version returned your trap whenever you had one ANYWHERE, so as long as
-- you were carrying a spare the rusty branch was unreachable. While stacking,
-- the nearest to HIM wins out of both pools, which is the only measure that
-- means anything once the target is a Rake standing still.
function Ex.pickTrap(alsoRusty, except, at)
	local me = myPos()
	if not me then return nil, 0 end
	local mine, mineD, rusty = nil, nil, 0
	local best, bestD = nil, nil
	for _, m in ipairs(Ex.allTraps()) do
		local box = m:FindFirstChild("HitBox")
		if box and box:IsA("BasePart") and m ~= except then
			local d = (box.Position - me).Magnitude
			if m:GetAttribute("ServerSpawned") == true and d <= Ex.killDrag then
				rusty = rusty + 1
			end
			-- Nearest wins, and the attribute is not consulted: a trap you
			-- place is spawned by the server too, so it carries
			-- @ServerSpawned exactly like the map's own and there is no
			-- client-side way to tell them apart. Whether it MOVES is a
			-- question of network ownership, which the readback answers.
			local rank = (alsoRusty and at) and (box.Position - at).Magnitude or d
			if d <= Ex.killDrag and (not bestD or rank < bestD) then
				best, bestD = m, rank
			end
			if not mineD or d < mineD then mine, mineD = m, d end
		end
	end
	if alsoRusty then return best, rusty end
	return best or mine, rusty
end

-- Flat under whichever leg is there, with the HitBox resting on the ground
-- that leg is standing on. Sizes are read off the live parts rather than
-- the dump so a reskin cannot put the trap inside his shin.
Ex.trapLead = 0.45   -- seconds of his own travel to aim ahead by

function Ex.trapGoal(r, box)
	local leg = r:FindFirstChild("Left Leg") or r:FindFirstChild("Right Leg")
		or r:FindFirstChild("HumanoidRootPart")
	if not (leg and leg:IsA("BasePart")) then return nil end

	-- Lead him. Dropping it where he IS means dropping it where he WAS by the
	-- time the move lands and the server agrees, which is the whole of "it
	-- takes a while before he gets trapped". His own velocity says where he
	-- is going, and it is capped so a ragdoll fling does not throw the trap
	-- across the map.
	local ahead = Vector3.zero
	local hrp = r:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		local v = hrp.AssemblyLinearVelocity
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > 1 then
			if flat.Magnitude > 40 then flat = flat.Unit * 40 end
			ahead = flat * Ex.trapLead
		end
	end
	return Vector3.new(leg.Position.X + ahead.X,
		leg.Position.Y - leg.Size.Y * 0.5 + box.Size.Y * 0.5,
		leg.Position.Z + ahead.Z)
end

-- The model is one welded unanchored assembly, so PivotTo carries all of it
-- and the welds stay intact. Whether the write REACHES the server is not
-- ours to decide: it does only while the server has handed this client
-- network ownership of that assembly, which it does for a loose part when
-- you are the nearest player to it - and which it never does for a
-- map-spawned one. There is no client-side call that can ask, so the
-- position is read back a moment later instead of assumed.
function Ex.moveTrap(model, box, goal)
	pcall(function()
		model:PivotTo(CFrame.new(goal - box.Position) * model:GetPivot())
		box.AssemblyLinearVelocity = Vector3.zero
		box.AssemblyAngularVelocity = Vector3.zero
	end)
end

-- Report a touch on the trap's hitbox from every part of him at once.
--
-- The hitbox is what carries the TouchTransmitter (dump 11353) and his parts
-- carry none, so the transmitter part goes SECOND - Ex.grabFlare is the
-- working example, and the previous build had this pair the wrong way round.
--
-- A touch is a 0 AND a 1 and the two have to straddle a frame or the server
-- coalesces them to nothing. Doing that per part means one trigger every two
-- frames PER PART; taking the edge from the caller and firing every part on
-- it means a full cycle every two frames for all of him. That is the
-- difference between a trigger and a stream of them, and it yields nothing,
-- so it is safe to call from inside a Heartbeat.
function Ex.touchTrap(r, box, edge)
	if typeof(firetouchinterest) ~= "function" then return end
	if Ex.touchOf ~= r or not Ex.touchList then
		Ex.touchOf, Ex.touchList = r, {}
		for _, d in ipairs(r:GetDescendants()) do
			if d:IsA("BasePart") then
				Ex.touchList[#Ex.touchList + 1] = d
				if #Ex.touchList >= 24 then break end
			end
		end
	end
	for _, part in ipairs(Ex.touchList) do
		if part.Parent then pcall(firetouchinterest, part, box, edge) end
	end
end

-- One SEPARATE contact per part, rather than one wide one.
--
-- Ex.touchTrap fires every part on the caller's edge, so a 0 frame and a 1
-- frame read as a single contact beginning and ending however many parts were
-- named - and TrapMain damages per contact, which is why springing a trap
-- twenty four ways still only ever took fifty health off. Each part gets its
-- own 0 - wait - 1 here, in its own thread, so the server sees twenty four
-- arrivals instead of one.
--
-- Threads are cheap; the guard is there because at this rate they would
-- otherwise pile up faster than they retire.
function Ex.springTrap(r, box)
	if typeof(firetouchinterest) ~= "function" then return 0 end
	if Ex.springOf ~= r or not Ex.springList then
		Ex.springOf, Ex.springList = r, {}
		for _, d in ipairs(r:GetDescendants()) do
			if d:IsA("BasePart") then
				Ex.springList[#Ex.springList + 1] = d
				if #Ex.springList >= 24 then break end
			end
		end
	end
	if Ex.springing then return 0 end
	Ex.springing = true
	local fired = #Ex.springList
	task.spawn(function()
		for _, part in ipairs(Ex.springList) do
			if part.Parent and box.Parent then
				task.spawn(function()
					pcall(function()
						firetouchinterest(part, box, 0)
						task.wait()
						firetouchinterest(part, box, 1)
					end)
				end)
			end
		end
		task.wait(0.1)
		Ex.springing = false
	end)
	return fired
end

-- Auto Trap Rake. Walks a trap under him, springs it, and swings while he is
-- held. It DOES move traps - that is the feature - and once he is caught it
-- stacks more on him, the map's rusty ones included, one every second and a
-- half rather than the whole map at once.
function Ex.setKillRake(on)
	Ex.killRake = on
	if not on then
		if Ex.killConn then Ex.killConn:Disconnect() Ex.killConn = nil end
		Ex.killSaid, Ex.killWant, Ex.killTrap = nil, nil, nil
		return
	end
	Ex.killSaid, Ex.killWant, Ex.killTrap = nil, nil, nil
	if Ex.killConn then return end
	Ex.killConn = RunService.Heartbeat:Connect(function()
		if not Ex.killRake then return end
		local r = rake()
		local hrp = r and r:FindFirstChild("HumanoidRootPart")
		local hum = r and r:FindFirstChildOfClass("Humanoid")
		if not (hrp and hum) or hum.Health <= 0 then
			Ex.killTrap, Ex.killWant, Ex.killWantModel = nil, nil, nil
			Ex.killSay("no Rake in the world")
			return
		end

		-- StunStick.HitPart has to SIT on him rather than arrive with the
		-- swing. Fight.aimHitPart is the one place that write lives, and it
		-- keeps Fight.lastTarget in step so the hit marker draws right.
		Fight.aimHitPart(hrp)

		if os.clock() - (Ex.killTick or 0) < Ex.killTickGap then return end
		Ex.killTick = os.clock()

		local caught = Ex.rakeTrapped(r)
		local model, rusty = Ex.pickTrap(caught ~= nil, caught, hrp.Position)
		if caught then
			if os.clock() - (Ex.stackLast or 0) < 1.5 then
				model = nil
			elseif model then
				Ex.stackLast = os.clock()
			end
		end
		-- a want belongs to the model it was nudged for. If that trap was
		-- sprung, picked up, or another is now the nearest, the readback
		-- would measure the new box against the old goal.
		if model ~= Ex.killWantModel then
			Ex.killWant, Ex.killWantModel = nil, model
		end
		-- Anti Trap reads this and leaves that one model armed
		Ex.killTrap = model or caught

		-- he is already held: spring whatever he is standing in, and swing
		if caught then
			local heldBox = caught:FindFirstChild("HitBox")
			if heldBox and heldBox:IsA("BasePart") then
				Ex.killPhase = not Ex.killPhase
				Ex.touchTrap(r, heldBox, Ex.killPhase and 0 or 1)
			end
			local me = myPos()
			if me and (hrp.Position - me).Magnitude < Ex.killRange
				and Fight.stick()
				and os.clock() - (Ex.killLast or 0) >= Ex.killGap then
				Ex.killLast = os.clock()
				Fight.swing(hrp)
			end
		end

		local box = model and model:FindFirstChild("HitBox")
		if not (box and box:IsA("BasePart")) then
			if caught then
				Ex.killSay("he is in a trap - springing it")
			else
				Ex.killSay(rusty > 0
					and ("no trap within " .. Ex.killDrag .. " studs - walk nearer one")
					or "no trap anywhere - buy a RakeTrap and put one down")
			end
			return
		end

		local me = myPos()
		if me and (box.Position - me).Magnitude > Ex.killDrag then
			Ex.killSay("the trap is too far away - walk over to it")
			return
		end

		if Ex.killWant or (box.Position - hrp.Position).Magnitude > Ex.killCatch then
			-- one nudge, then look. If the trap is still where we put it a
			-- quarter second later the write replicated; if it snapped back,
			-- the server owns it - which is what happens with a rusty one -
			-- and the only way in is to lure him onto it.
			if Ex.killWant then
				-- while he is walking, keep re-aiming rather than waiting out
				-- the readback: the readback exists to tell you whether the
				-- trap moved, and that answer is only worth having once he
				-- has stopped
				local moving = false
				local rh = r:FindFirstChild("HumanoidRootPart")
				if rh and rh:IsA("BasePart") then
					local v = rh.AssemblyLinearVelocity
					moving = Vector3.new(v.X, 0, v.Z).Magnitude > 4
				end
				if moving then Ex.killWant = nil end
			end
			if Ex.killWant then
				if os.clock() - Ex.killWantAt >= 0.25 then
					local drift = (box.Position - Ex.killWant).Magnitude
					Ex.killWant = nil
					Ex.killSay(drift <= 6
						and "trap moved onto the Rake"
						or "that one is server owned - it will not move, lure him onto it")
				end
			else
				local goal = Ex.trapGoal(r, box)
				if goal then
					Ex.moveTrap(model, box, goal)
					Ex.killWant, Ex.killWantAt = goal, os.clock()
				end
			end

			if os.clock() - (Ex.killTouchLast or 0) >= 0.25 then
				Ex.killTouchLast = os.clock()
				Ex.killPhase = not Ex.killPhase
				Ex.touchTrap(r, box, Ex.killPhase and 0 or 1)
			end
			return
		end

		Ex.killWant = nil
		Ex.killSay("the trap is on him - springing it")
	end)
	addCleanup("killloop", function()
		if Ex.killConn then Ex.killConn:Disconnect() Ex.killConn = nil end
	end)
end


local Kill = {
	on = false, gap = 0.12, range = 200,
	hp0 = nil, tracking = nil,
	parts = nil, partsOf = nil,
	last = 0, said = "", saidAt = nil, touchLast = nil,
}



-- THE KILL.
--
-- Not damage, and not the void either - both were tried and both were the
-- wrong shape. What actually happens, described off a working script and
-- confirmed here: the Rake steps on YOUR trap, freezes for about a second,
-- his health reads 0, and he falls through the map a second LATER. The fall
-- is the corpse dropping. He was already dead. The trap killed him.
--
-- So the trap is the weapon, and the freeze is the window. TrapMain is a
-- server Script (dump 11344) and the HitBox is what carries the
-- TouchTransmitter (11353), so every touch reported on that hitbox is another
-- trigger the server processes - and the frozen second is a second in which
-- he is standing still on it, being triggered again and again.
--
-- Driving him downwards is gone. It half worked and that was the tell: he
-- started falling and the server pulled him straight back, because the merged
-- assembly is not ours to move. Reported for what it was rather than left in.
-- Time-throttled as well as deduped: a caller whose text carries a number
-- that changes every frame would otherwise fire a notification every frame,
-- which is a mistake this file has now made twice.
-- The local death, in the order the recording actually shows it.
--
-- RootJoint first, because that is the one that goes a millisecond before the
-- others and it is the joint holding the whole rig to its root. Then every
-- remaining Motor6D and Weld. Once they are gone a health correction cannot
-- put the body back together, which is why this sticks where a bare
-- Health = 0 does not.
Kill.JOINTS = { "Motor6D", "Weld", "ManualWeld", "Snap" }

function Kill.dropLocally(r, hum)
	if Kill.dropped == r then return end
	Kill.dropped = r
	local root = r:FindFirstChild("HumanoidRootPart")
	local rootJoint = root and root:FindFirstChild("RootJoint")
	if rootJoint then pcall(function() rootJoint:Destroy() end) end
	local n = 0
	for _, d in ipairs(r:GetDescendants()) do
		for _, class in ipairs(Kill.JOINTS) do
			if d:IsA(class) then
				pcall(function() d:Destroy() end)
				n = n + 1
				break
			end
		end
	end
	pcall(function() hum.Health = 0 end)
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
	notify("dropped him on your screen - " .. n .. " joints cut", 5)
end

-- ReplicatedStorage.Timer runs to -1:59 when he is actually removed - the
-- user spotted that before this did, and it is the clearest confirmation the
-- round logic gives that he is gone rather than merely down on your screen.
function Kill.watchTimer()
	if Kill.timerConn then return end
	local t = ReplicatedStorage:FindFirstChild("Timer")
	if not (t and t:IsA("ValueBase")) then return end
	Kill.timerConn = t.Changed:Connect(function(v)
		if not Kill.on then return end
		if type(v) == "number" and v < 0 and (Kill.lastTimer or 0) >= 0 then
			notify(string.format("timer went to %d - he is out of the round", v), 6)
		end
		Kill.lastTimer = type(v) == "number" and v or 0
	end)
end

function Kill.say(text, quiet)
	if Kill.said == text then return end
	if quiet and os.clock() - (Kill.saidAt or 0) < 1.5 then return end
	Kill.said, Kill.saidAt = text, os.clock()
	notify(text, 4)
end


function Kill.readout()
	if not Kill.on then return "off" end
	local r = rake()
	if not r then return "no Rake in the workspace" end
	local hum = r:FindFirstChildOfClass("Humanoid")
	if not hum then return "Rake has no Humanoid" end

	local out = string.format("Rake %d hp", math.floor(hum.Health))
	local flag = "?"
	pcall(function()
		local v = hum:GetAttribute("iTRPED2")
		flag = (v == true) and "TRUE" or tostring(v)
	end)
	out = out .. " | Monster @iTRPED2 = " .. flag

	local n, act = 0, 0
	for _, m in ipairs(Ex.allTraps()) do
		n = n + 1
		if m:GetAttribute("Activated") == true then act = act + 1 end
	end
	out = out .. string.format("\n%d traps, %d Activated", n, act)
	out = out .. "\ntrapped: " .. (Ex.rakeTrapped(r) and "YES" or "no")
	out = out .. " | joints cut: " .. (Kill.dropped == r and "YES" or "no")
	return out
end

function Kill.set(on)
	Kill.on = on
	if not on then
		if Kill.conn then Kill.conn:Disconnect() Kill.conn = nil end
		if Kill.timerConn then Kill.timerConn:Disconnect() Kill.timerConn = nil end
		Kill.said, Kill.hp0, Kill.tracking = "", nil, nil
		return
	end
	if Kill.conn then return end
	Kill.said, Kill.saidAt, Kill.hp0, Kill.tracking = "", nil, nil, nil
	-- a re-enable on the same trapped Rake should be able to cut again
	Kill.dropped = nil
	Kill.watchTimer()
	Kill.conn = RunService.Heartbeat:Connect(function()
		if not Kill.on then return end
		local r = rake()
		local hum = r and r:FindFirstChildOfClass("Humanoid")
		local hrp = r and r:FindFirstChild("HumanoidRootPart")
		-- NOT gated on hum.Health: this loop writes that to zero itself, so a
		-- `Health <= 0` bail read our own write back and switched the feature
		-- off one tick after it started.
		if not (hum and hrp) then
			Kill.say("no Rake in the world")
			return
		end
		if Ex.rakeGone(r) then
			Kill.say("he is down - the server has set Dead / Inactive")
			return
		end

		-- Held at zero, and it is unconditional because the script that works
		-- does the same: it starts four milliseconds after Rake.TargetVal is
		-- set, six seconds before any trap, and never stops.
		--
		-- This is the READOUT, not the kill. The server corrects it within a
		-- frame every single time and its own number never moves - the
		-- recording has it flickering 340 <-> 0 before AND after he goes down.
		-- What actually drops him is Kill.dropLocally below. TakeDamage used
		-- to sit here too; on an already-zeroed humanoid it adds nothing and
		-- it is what drove the game's own readout to -400.
		pcall(function() hum.Health = 0 end)

		local caught = Ex.rakeTrapped(r)
		if not caught then
			Kill.dropped = nil
			Kill.say("armed - drop a trap where he walks and let him step in")
			return
		end

		-- He is held, which is the window the recording shows the local death
		-- landing in. Cut the joints - once per Rake, because a rig can only
		-- fall apart once and retrying every frame would just spam the notify.
		Kill.dropLocally(r, hum)

		Kill.say("HE IS IN IT - dropped", true)
	end)
	addCleanup("instakill", function() Kill.set(false) end)
end


-- ---------------------------- the power station ----------------------------
-- Restoring the power means holding a prompt for 30 seconds, and while you
-- do that you can be shocked. From the dump:
--
--   ...PowerStation.StationFolder.Shocker.ShockPart   a 22 x 19 stud pad
--   ...PowerStation.StationFolder.ZapPart             the arc itself
--   ...StationFolder.StationSounds.Zap                the sound it makes
--   the Toolbox item is described as restoring power "without risk of being
--   shocked", which says the risk is a roll rather than a certainty
--
-- Three layers, because which one does the work depends on whether the shock
-- is decided on your client or on the server, and the dump cannot tell us:
--
--   1. CanTouch off on the shock pad. If your client is what notices you
--      standing on it, it stops noticing.
--   2. Zero anything numeric named like a shock chance or shock damage,
--      the same getgc route that solved stamina.
--   3. Tell you when you are standing on it, which works regardless.
--
-- Layer 3 is the honest one: if the server owns the shock, nothing here will
-- stop it, and the readout will show you standing in the zone taking hits.

Ex.shockKeys = { "SHOCK_CHANCE", "SHOCK_DAMAGE", "SHOCK_TAKE", "ZAP_CHANCE",
	"ZAP_DAMAGE", "ShockChance", "ShockDamage", "shockChance" }

function Ex.shockParts()
	local out = {}
	local folder = pathTo(Workspace, "Map", "PowerStation", "StationFolder")
	if not folder then return out end
	local shocker = folder:FindFirstChild("Shocker")
	if shocker then
		for _, p in ipairs(shocker:GetDescendants()) do
			if p:IsA("BasePart") then out[#out + 1] = p end
		end
	end
	local zap = folder:FindFirstChild("ZapPart")
	if zap and zap:IsA("BasePart") then out[#out + 1] = zap end
	return out
end

function Ex.patchShockTable()
	if typeof(getgc) ~= "function" then return 0 end
	local ok, all = pcall(getgc, true)
	if not ok then return 0 end
	local hits = 0
	for _, v in pairs(all) do
		if type(v) == "table" then
			for _, key in ipairs(Ex.shockKeys) do
				local got, has = pcall(function() return type(rawget(v, key)) == "number" end)
				if got and has then
					pcall(function() v[key] = 0 end)
					hits = hits + 1
				end
			end
		end
	end
	return hits
end

-- Rather than trying to disarm the pad, just do not be in it: hold a few
-- studs above the surface while you are over it. That works no matter which
-- side decides the shock, because there is nothing to decide.
Ex.shockLift = 4

function Ex.setBypassShock(on)
	Ex.bypassShock = on
	if not on then
		if Ex.shockConn then Ex.shockConn:Disconnect() Ex.shockConn = nil end
		Ex.shockStatus = "off"
		return
	end
	if Ex.shockConn then return end
	Ex.shockConn = RunService.Stepped:Connect(function()
		if not Ex.bypassShock then return end
		local hrp = getHRP()
		if not hrp then return end
		local over = false
		for _, part in ipairs(Ex.shockParts()) do
			local half = part.Size * 0.5
			local rel = part.CFrame:PointToObjectSpace(hrp.Position)
			-- inside the footprint, and near enough vertically to be in it
			if math.abs(rel.X) <= half.X + 1 and math.abs(rel.Z) <= half.Z + 1
				and rel.Y < half.Y + 8 and rel.Y > -half.Y - 12 then
				over = true
				local top = part.Position.Y + half.Y + Ex.shockLift
				if hrp.Position.Y < top then
					hrp.CFrame = CFrame.new(hrp.Position.X, top, hrp.Position.Z)
						* (hrp.CFrame - hrp.CFrame.Position)
					local v = hrp.AssemblyLinearVelocity
					if v.Y < 0 then
						hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
					end
				end
			end
		end
		Ex.shockStatus = over and "floating over the water" or "clear"
	end)
	addCleanup("shock", function() Ex.setBypassShock(false) end)
end

Ex.toolboxHold = 3

function Ex.stationPrompt()
	local part = pathTo(Workspace, "Map", "PowerStation", "StationFolder", "StationGUIPart")
	return part and part:FindFirstChildWhichIsA("ProximityPrompt", true) or nil
end

function Ex.setSpoofToolbox(on)
	Ex.spoofToolbox = on
	if not on then
		if Ex.toolConn then Ex.toolConn:Disconnect() Ex.toolConn = nil end
		local prompt = Ex.stationPrompt()
		if prompt and Ex.toolboxSaved then
			pcall(function()
				prompt.HoldDuration = Ex.toolboxSaved.hold
				prompt:SetAttribute("ActivateTime", Ex.toolboxSaved.activate)
			end)
		end
		Ex.toolboxSaved = nil
		local fake = Ex.fakeToolbox
		if fake and fake.Parent then pcall(function() fake:Destroy() end) end
		Ex.fakeToolbox = nil
		return
	end

	-- a Tool named Toolbox, shaped like the game's own tools, in case the
	-- client checks your inventory for one
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	if bp and not bp:FindFirstChild("Toolbox") then
		local fake = make("Tool", { Name = "Toolbox", RequiresHandle = false }, bp)
		fake:SetAttribute("CanRestore", true)
		fake:SetAttribute("SaveItem", true)
		fake:SetAttribute("Tool", true)
		fake:SetAttribute("RKFake", true)
		Ex.fakeToolbox = fake
	end

	if Ex.toolConn then return end
	Ex.toolConn = RunService.Heartbeat:Connect(function()
		if not Ex.spoofToolbox then return end
		if os.clock() - (Ex.toolLast or 0) < 0.5 then return end
		Ex.toolLast = os.clock()
		local prompt = Ex.stationPrompt()
		if not prompt then return end
		if not Ex.toolboxSaved then
			Ex.toolboxSaved = {
				hold = prompt.HoldDuration,
				activate = prompt:GetAttribute("ActivateTime"),
			}
		end
		pcall(function()
			-- no hold at all: 30 seconds is what it costs without a toolbox
			prompt:SetAttribute("ActivateTime", 0)
			prompt.HoldDuration = 0
			prompt:SetAttribute("Unavailable", false)
			prompt:SetAttribute("Unavailable2", false)
			prompt:SetAttribute("Busy", false)
			prompt.Enabled = true
			prompt.RequiresLineOfSight = false
			if prompt.MaxActivationDistance < 30 then prompt.MaxActivationDistance = 30 end
		end)
	end)
	addCleanup("toolbox", function() Ex.setSpoofToolbox(false) end)
end

Ex.TOWER = {
	Lights = { "Map", "ObservationTower", "Lights" },
	Hatch  = { "Map", "ObservationTower", "Door" },
	Radar  = { "Map", "ObservationTower", "Radar" },
	SafeHouseDoor = { "Map", "SafeHouse", "Door" },
	SafeHouseLight = { "Map", "SafeHouse", "Light" },
}

function Ex.firePrompt(prompt)
	pcall(function()
		prompt:SetAttribute("Unavailable", false)
		prompt:SetAttribute("Unavailable2", false)
		prompt:SetAttribute("Busy", false)
		prompt:SetAttribute("Busy2", false)
		prompt.Enabled = true
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		if prompt.MaxActivationDistance < 200 then prompt.MaxActivationDistance = 200 end
	end)
	if typeof(fireproximityprompt) ~= "function" then return false end
	-- executors disagree about the signature, so try both
	if pcall(fireproximityprompt, prompt) then return true end
	if pcall(fireproximityprompt, prompt, 1) then return true end
	return false
end

function Ex.trigger(what)
	local path = Ex.TOWER[what]
	if not path then return end
	local root = pathTo(Workspace, table.unpack(path))
	if not root then
		notify(what .. ": not loaded from here", 4)
		return
	end

	local prompts, fired = 0, 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			prompts = prompts + 1
			if Ex.firePrompt(d) then fired = fired + 1 end
		end
	end

	-- some of these are driven by a BindableEvent beside the prompt; firing
	-- it only reaches client listeners, but where the display is client side
	-- that is exactly what is wanted
	local bindables = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BindableEvent") and (d.Name == "Event" or d.Name == "Toggle" or d.Name == "ToggleE") then
			if pcall(function() d:Fire() end) then bindables = bindables + 1 end
		end
	end

	if prompts == 0 and bindables == 0 then
