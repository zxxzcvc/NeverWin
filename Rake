-- Every one of these is a place the boot used to be able to die outright,
-- taking the whole menu with it. None of them are worth that.
local function stage(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[RK] boot stage '" .. name .. "' failed: " .. tostring(err))
		UIReport[#UIReport + 1] = { name = name, ok = false, err = tostring(err) }
	end
	return ok
end

